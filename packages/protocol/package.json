    "generate:plugin-action-reference": "node ../../apps/docs/scripts/generateReference.mjs --only=host-actions.mdx",
    "check:plugin-action-reference": "node ../../apps/docs/scripts/generateReference.mjs --only=host-actions.mdx --check",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts",
    "postinstall:real": "pnpm --silent run build",
    "postinstall": "node -e \"const fs=require('fs');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'protocol',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}const has=(p)=>{try{return fs.existsSync(p)}catch{return false}};if(!has('tsconfig.json')||!has('../agents/tsconfig.json'))process.exit(0);import('../../scripts/workspaces/execPnpmCommand.mjs').then(({execPnpm})=>{execPnpm(['--silent','run','postinstall:real'],{stdio:'inherit'});}).catch(error=>{console.error(error.message);process.exit(error.status??1);});\"",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node scripts/generate-exports.mjs --check && node scripts/generate-embedded-feature-policies.mjs --check && node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "generate:exports": "node scripts/generate-exports.mjs --write",
    "check:exports": "node scripts/generate-exports.mjs --check"
