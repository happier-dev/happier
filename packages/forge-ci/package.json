{
  "name": "@happier-dev/forge-ci",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "@happier-dev/triage-protocol": "0.0.0",
    "@happier-dev/triage-sources": "0.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "react": "19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "19.2.0"
  },
  "main": "./dist/runtime.js",
  "types": "./dist/runtime.d.ts",
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config vitest.config.ts",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "exports": {
    "./runtime": {
      "happier-source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./ui": {
      "happier-source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  }
}
