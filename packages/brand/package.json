{
  "name": "@happier-dev/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./planet": {
      "types": "./planet.d.mts",
      "default": "./planet.mjs"
    },
    "./product-story": {
      "happier-source": "./src/product-story.ts",
      "types": "./dist/product-story.d.ts",
      "default": "./dist/product-story.js"
    }
  },
  "files": [
    "dist",
    "planet.mjs",
    "planet.d.mts",
    "package.json"
  ],
  "scripts": {
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "node --test planet.test.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "prepack": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
