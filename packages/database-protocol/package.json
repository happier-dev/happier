{
  "name": "@happier-dev/database-protocol",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "happier-source": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./v1": { "happier-source": "./src/v1/index.ts", "types": "./dist/v1/index.d.ts", "default": "./dist/v1/index.js" },
    "./databaseTargets": { "happier-source": "./src/databaseTargets.ts", "types": "./dist/databaseTargets.d.ts", "default": "./dist/databaseTargets.js" },
    "./databaseValues": { "happier-source": "./src/databaseValues.ts", "types": "./dist/databaseValues.d.ts", "default": "./dist/databaseValues.js" },
    "./databaseOperations": { "happier-source": "./src/databaseOperations.ts", "types": "./dist/databaseOperations.d.ts", "default": "./dist/databaseOperations.js" }
  },
  "files": ["dist", "README.md", "package.json"],
  "happier": { "publicSdkRelease": { "posture": "developer_preview", "supportPolicy": "README.md#evolving-the-abi", "externalPublicationRequiresApproval": true } },
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": { "@happier-dev/protocol": "0.0.0", "zod": "4.6.7" },
  "devDependencies": { "typescript": "^5.9.2", "vitest": "^3.2.4" }
}
