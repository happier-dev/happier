{
  "name": "@happier-dev/sdk",
  "version": "0.0.0",
  "description": "Typed client SDK for the Happier Action API.",
  "private": true,
  "license": "MIT",
  "repository": "happier-dev/happier",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#http": {
      "happier-source": {
        "node": "./src/http/undiciHttp.ts",
        "default": "./src/http/fetchHttp.ts"
      },
      "node": "./dist/http/undiciHttp.js",
      "default": "./dist/http/fetchHttp.js"
    }
  },
  "files": [
    "dist",
    "examples/basic/package.json",
    "examples/basic/README.md",
    "examples/basic/index.ts",
    "examples/basic/tsconfig.json",
    "examples/comprehensive/README.md",
    "examples/comprehensive/index.ts",
    "examples/external-plugin/README.md",
    "examples/external-plugin/index.ts",
    "examples/child-token/README.md",
    "examples/child-token/index.ts",
    "package.json",
    "README.md",
    "API.md",
    "api-surface.json",
    "api-declarations.md"
  ],
  "happier": {
    "publicSdkRelease": {
      "posture": "developer_preview",
      "supportPolicy": "README.md#release-posture",
      "externalPublicationRequiresApproval": true
    }
  },
  "scripts": {
    "generate:actions": "node --import tsx ./scripts/generateActions.ts --write",
    "check:actions": "node --import tsx ./scripts/generateActions.ts --check",
    "prepare:declarations": "pnpm --silent run generate:actions",
    "prepare:api-governance": "pnpm --silent run prepare:declarations && node ./scripts/bundleWorkspaceDeps.mjs --artifact && pnpm --silent run build:compiled",
    "api-governance": "pnpm --silent run prepare:api-governance && pnpm --silent run api-governance:emit",
    "api-governance:emit": "node ../../scripts/api-governance/cli.mjs --profile sdk --write",
    "check:api-governance": "pnpm --silent run prepare:api-governance && node ../../scripts/api-governance/cli.mjs --profile sdk --check",
    "check:api-governance:prepared": "node ../../scripts/api-governance/cli.mjs --profile sdk --check",
    "generated:finite": "pnpm --silent run check:actions",
    "build:finite": "pnpm --silent run build:compiled",
    "api:finite": "pnpm --silent run check:api-governance:prepared",
    "prebuild": "pnpm --silent run prepare:declarations",
    "build:compiled": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build": "pnpm --silent run build:compiled",
    "prepack": "pnpm --silent run check:actions && pnpm --silent run prepare:api-governance && node ../../scripts/api-governance/cli.mjs --profile sdk --write && pnpm --silent run check:api-governance:prepared",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config ./vitest.config.ts && node --import tsx --test ./scripts/*.test.mjs",
    "test:finite": "pnpm --silent run test:local",
    "test:external-consumer": "node --import tsx ./scripts/validateNodeNextConsumer.mjs",
    "test:browser-consumer": "node --import tsx ./scripts/validateBrowserConsumer.mjs",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json && pnpm --silent run test:external-consumer",
    "typecheck:finite": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json && pnpm --silent run test:external-consumer"
  },
  "bundledDependencies": [
    "@happier-dev/agents",
    "@happier-dev/protocol",
    "@happier-dev/connection-supervisor",
    "@happier-dev/session-core",
    "@happier-dev/sync-client"
  ],
  "dependencies": {
    "@happier-dev/agents": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "@happier-dev/connection-supervisor": "0.0.0",
    "@happier-dev/session-core": "0.0.0",
    "@happier-dev/sync-client": "0.0.0",
    "socket.io-client": "^4.8.1",
    "undici": "^6.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "socket.io": "^4.8.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "esbuild": "^0.27.2"
  }
}
