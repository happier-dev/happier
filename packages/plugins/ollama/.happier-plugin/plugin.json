  "description": "Use models served locally by Ollama.",
  "displayName": "Ollama",
  "engines": {
    "happier": "^0.0.0"
  },
  "entrypoints": {
    "daemon": "./.happier-plugin/daemon.js"
  },
  "hostAccess": {
    "optional": [],
    "required": [
      {
        "capability": "process",
        "id": "ollama-process",
        "reason": "Run the declared Ollama executable.",
        "scope": {
          "executables": [
            {
              "id": "ollama-cli",
              "kind": "systemTool"
            }
          ]
        }
      }
    ]
  },
  "id": "happier.provider.ollama",
  "runtime": {
    "apiVersion": 1
  },
  "schemaVersion": 2,
  "secrets": [],
  "version": "0.0.0"
}
