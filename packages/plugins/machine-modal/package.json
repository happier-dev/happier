{
  "name": "@happier-dev/plugins-machine-modal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:finite": "yarn -s build",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "yarn -s build && node ../../../node_modules/vitest/vitest.mjs run",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": { "happier-source": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./manifest": { "happier-source": "./src/manifest.ts", "types": "./dist/manifest.d.ts", "default": "./dist/manifest.js" }
  },
  "imports": {
    "#modal-sdk-worker": { "happier-source": "./src/machine/sdkWorker.ts", "default": "./dist/machine/sdkWorker.js" }
  },
  "files": ["dist", ".happier-plugin", "package.json"],
  "dependencies": { "@happier-dev/plugin-sdk": "0.0.0", "modal": "0.11.0" },
  "devDependencies": { "@happier-dev/protocol": "0.0.0", "vitest": "^3.2.4", "@types/node": "^22.0.0" }
}
