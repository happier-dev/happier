{
  "name": "@happier-dev/plugins-database-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./happier-plugin-ui/database-panel-native": "./src/ui/surface/DatabasesPanel.tsx",
    "./happier-plugin-ui/database-workbench-native": "./src/ui/surface/WorkbenchPage.tsx"
  },
  "files": [
    "src",
    "dist",
    ".happier-plugin",
    ".happier-plugin-build",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:finite": "pnpm --silent run build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config vitest.config.ts",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "pnpm --silent run typecheck:source && pnpm --silent run typecheck:tests",
    "typecheck:source": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "typecheck:tests": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@happier-dev/database-protocol": "0.0.0",
    "@happier-dev/databases": "0.0.0",
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "pg": "8.23.1",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/react": "19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
