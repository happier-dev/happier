{
  "name": "@happier-dev/plugins-muse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./happier-plugin-ui/connected-account-authentication": {
      "happier-source": "./src/connectedAccounts/account.ts",
      "types": "./dist/connectedAccounts/account.d.ts",
      "default": "./dist/connectedAccounts/account.js"
    },
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./agent/runtime": {
      "happier-source": "./src/agent/runtime.ts",
      "types": "./dist/agent/runtime.d.ts",
      "default": "./dist/agent/runtime.js"
    },
    "./connected-account-service": {
      "happier-source": "./src/connectedAccounts/declarations.ts",
      "types": "./dist/connectedAccounts/declarations.d.ts",
      "default": "./dist/connectedAccounts/declarations.js"
    }
  },
  "files": [
    "dist",
    ".happier-plugin",
    "package.json",
    "assets"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:finite": "pnpm --silent run build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "vitest": "../../../apps/stack/bin/hstack-exec --script=vitest:local",
    "vitest:local": "vitest"
  },
  "dependencies": {
    "@happier-dev/protocol": "0.0.0",
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "@happier-dev/agents": "0.0.0",
    "@happier-dev/cli-common": "0.0.0",
    "@happier-dev/tests": "0.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
