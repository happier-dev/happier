{
  "name": "@happier-dev/plugins-channels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./targeted-contributions": {
      "happier-source": "./src/targetedContributions.ts",
      "types": "./dist/targetedContributions.d.ts",
      "default": "./dist/targetedContributions.js"
    },
    "./happier-plugin-ui/channels-app-native": "./src/ui/renderSurface.tsx",
    "./happier-plugin-ui/channels-glance-native": "./src/ui/glance/channelsGlance.tsx",
    "./happier-plugin-ui/channel-state-migrations": "./src/collectionMigrationArtifact.ts",
    "./happier-plugin-ui/react-native/channels-app-native/entry.cjs.bundle": "./dist/happier-plugin-ui/react-native/channels-app-native/entry.cjs.bundle",
    "./happier-plugin-ui/react-native/channels-glance-native/entry.cjs.bundle": "./dist/happier-plugin-ui/react-native/channels-glance-native/entry.cjs.bundle",
    "./happier-plugin-ui/react-native/channel-state-migrations/entry.cjs.bundle": "./dist/happier-plugin-ui/react-native/channel-state-migrations/entry.cjs.bundle"
  },
  "files": [
    "dist",
    ".happier-plugin",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json --happier-staged-output-script build:ui",
    "build:finite": "yarn -s build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "build:ui": "happier-plugin-build-ui",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config vitest.config.ts --testTimeout 15000",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json && node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json",
    "typecheck:source": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "typecheck:tests": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@happier-dev/channels-protocol": "0.0.0",
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0"
  },
  "devDependencies": {
    "@happier-dev/plugins-channel-discord": "0.0.0",
    "@happier-dev/plugins-channel-telegram": "0.0.0",
    "@happier-dev/plugins-scm-github": "0.0.0",
    "@types/react": "19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
