{
  "name": "@happier-dev/plugins-pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./protocol/runtimeDescriptorV1": {
      "happier-source": "./src/protocol/runtimeDescriptorV1.ts",
      "types": "./dist/protocol/runtimeDescriptorV1.d.ts",
      "default": "./dist/protocol/runtimeDescriptorV1.js"
    },
    "./protocol/thinking": {
      "happier-source": "./src/protocol/thinking.ts",
      "types": "./dist/protocol/thinking.d.ts",
      "default": "./dist/protocol/thinking.js"
    },
    "./agent/preflight/models": {
      "happier-source": "./src/agent/preflight/models.ts",
      "types": "./dist/agent/preflight/models.d.ts",
      "default": "./dist/agent/preflight/models.js"
    },
    "./agent/sessionFiles": {
      "happier-source": "./src/agent/sessionFiles.ts",
      "types": "./dist/agent/sessionFiles.d.ts",
      "default": "./dist/agent/sessionFiles.js"
    },
    "./agent/runtime/compaction": {
      "happier-source": "./src/agent/runtime/compaction/index.ts",
      "types": "./dist/agent/runtime/compaction/index.d.ts",
      "default": "./dist/agent/runtime/compaction/index.js"
    },
    "./agent/runtime/rpc/events": {
      "happier-source": "./src/agent/runtime/rpc/events.ts",
      "types": "./dist/agent/runtime/rpc/events.d.ts",
      "default": "./dist/agent/runtime/rpc/events.js"
    },
    "./agent/runtime/rpc/args": {
      "happier-source": "./src/agent/runtime/rpc/args.ts",
      "types": "./dist/agent/runtime/rpc/args.d.ts",
      "default": "./dist/agent/runtime/rpc/args.js"
    },
    "./agent/runtime/rpc/permissions": {
      "happier-source": "./src/agent/runtime/rpc/permissions.ts",
      "types": "./dist/agent/runtime/rpc/permissions.d.ts",
      "default": "./dist/agent/runtime/rpc/permissions.js"
    }
  },
  "files": [
    "dist",
    ".happier-plugin",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:finite": "yarn -s build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "test:request-auth-composed": "vitest run src/agent/auth/services/requestAuth/source.composed.test.ts",
    "test:request-auth-real-owners": "vitest run --config vitest.realOwners.config.ts",
    "test:request-auth-spawned-real-owners": "vitest run --config vitest.spawnedRealOwners.config.ts",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "@happier-dev/agents": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "@happier-dev/tests": "0.0.0",
    "pi-ai-0810": "npm:@earendil-works/pi-ai@0.81.0",
    "pi-ai-0811": "npm:@earendil-works/pi-ai@0.81.1",
    "pi-ai-0820": "npm:@earendil-works/pi-ai@0.82.0",
    "pi-ai-0821": "npm:@earendil-works/pi-ai@0.82.1",
    "pi-coding-agent-0810": "npm:@earendil-works/pi-coding-agent@0.81.0",
    "pi-coding-agent-0811": "npm:@earendil-works/pi-coding-agent@0.81.1",
    "pi-coding-agent-0820": "npm:@earendil-works/pi-coding-agent@0.82.0",
    "pi-coding-agent-0821": "npm:@earendil-works/pi-coding-agent@0.82.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
