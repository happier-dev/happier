    "voiceModelPacks": [],
    "voiceProviders": [],
    "webhooks": []
  },
  "displayName": "Pi",
  "engines": {
    "happier": "^0.0.0"
  },
  "entrypoints": {
    "daemon": "./dist/index.js"
  },
  "hostAccess": {
    "optional": [],
    "required": [
      {
        "capability": "filesystem",
        "id": "pi-workspace",
        "reason": "Use the admitted Agent workspace as the Pi process working directory.",
        "scope": {
          "access": [
            "read"
          ],
          "locations": [
            {
              "root": "workspace"
            }
          ]
        }
      },
      {
        "capability": "process",
        "id": "pi-process",
        "reason": "Launch the Pi coding-agent CLI through the host execution service.",
        "scope": {
          "envKeys": [
            "HAPPIER_PI_THINKING_LEVEL",
            "HAPPIER_CONNECTED_ACCOUNT_REQUEST_AUTH_CAPABILITY_PATH",
            "HAPPIER_PI_REQUEST_AUTH_PRODUCER_VERSION",
            "NODE_ENV",
            "DEBUG",
            "CI",
            "OPENAI_API_KEY",
            "ANTHROPIC_API_KEY",
            "GEMINI_API_KEY",
            "OPENROUTER_API_KEY",
            "KIMI_API_KEY",
            "HOME",
            "XDG_CONFIG_HOME",
            "USERPROFILE",
            "PI_CODING_AGENT_DIR"
          ],
          "executables": [
            {
              "id": "pi-cli",
              "kind": "systemTool"
            }
          ]
        }
      }
    ]
  },
  "id": "happier.agent.pi",
  "runtime": {
    "apiVersion": 1
  },
  "schemaVersion": 2,
  "secrets": [],
  "version": "0.0.0"
}
