{
  "name": "@happier-dev/plugins-machine-services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./happier-plugin-ui/healthSetup": "./src/ui/healthSetup.ts",
    "./happier-plugin-ui/health-setup": "./src/ui/healthSetup.ts"
  },
  "files": [
    "dist",
    ".happier-plugin",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json --happier-staged-output-script build:ui",
    "build:ui": "happier-plugin-build-ui",
    "build:finite": "pnpm --silent run build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "@types/react": "19.2.0",
    "react": "19.2.0"
  }
}
