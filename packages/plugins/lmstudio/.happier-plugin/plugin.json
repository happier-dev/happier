  "description": "Use models served locally by LM Studio 0.4.1 or newer.",
  "displayName": "LM Studio",
  "engines": {
    "happier": "^0.0.0"
  },
  "hostAccess": {
    "optional": [],
    "required": []
  },
  "id": "happier.provider.lmstudio",
  "runtime": {
    "apiVersion": 1
  },
  "schemaVersion": 2,
  "secrets": [],
