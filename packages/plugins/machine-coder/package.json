{
  "name": "@happier-dev/plugins-machine-coder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./happier-plugin-ui/connected-account-authentication": {
      "happier-source": "./src/account.ts",
      "default": "./dist/account.js"
    },
    "./happier-plugin-ui/cli-install": "./src/ui/cliInstall.ts"
  },
  "files": [
    "src",
    "dist",
    ".happier-plugin",
    ".happier-plugin-build",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../../apps/stack/bin/hstack-exec -- pnpm exec vitest run",
    "typecheck": "../../../apps/stack/bin/hstack-exec -- node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "vitest": "^3.2.4"
  }
}
