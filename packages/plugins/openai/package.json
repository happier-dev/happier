{
  "name": "@happier-dev/plugins-openai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "assets",
    "dist",
    ".happier-plugin", ".happier-plugin-build",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:finite": "pnpm --silent run build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "exports": {
    "./connected-account-service": {
      "happier-source": "./src/auth/service.ts",
      "types": "./dist/auth/service.d.ts",
      "default": "./dist/auth/service.js"
    },
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./protocol/voice": {
      "happier-source": "./src/protocol/voice/index.ts",
      "types": "./dist/protocol/voice/index.d.ts",
      "default": "./dist/protocol/voice/index.js"
    },
    "./ui/voice": {
      "happier-source": "./src/ui/voice/index.ts",
      "types": "./dist/ui/voice/index.d.ts",
      "default": "./dist/ui/voice/index.js"
    },
    "./happier-plugin-ui/voice-runtime-web": {
      "happier-source": "./src/ui/voice/index.ts",
      "default": "./dist/ui/voice/index.js"
    }
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happier-dev/protocol": "0.0.0",
    "expo": "^55.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
