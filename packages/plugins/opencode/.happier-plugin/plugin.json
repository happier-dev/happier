{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "executionRuns": {
            "checkpoint": true,
            "open": [
              "create"
            ],
            "stop": true
          },
          "sessions": {
            "cancel": true,
            "catalog": {
              "active": [
                "skills"
              ]
            },
            "compaction": {
              "events": true,
              "manual": true
            },
            "configuration": true,
            "delivery": [
              "newTurn",
              "steer",
              "followUp"
            ],
            "open": [
              "create",
              "resume",
              "fork"
            ]
          },
          "surfaces": [
            "externalSessions"
          ],
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "agentCliSystemTool": {
            "toolId": "opencode-cli"
          },
          "vendorResume": {
            "support": "supported"
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [
                  "auth",
                  "login"
                ],
                "kind": "primary"
              }
            ],
            "nonInteractiveStatusProbe": true,
            "support": "login_terminal"
          },
          "displayName": "OpenCode CLI",
          "executable": {
            "binaryName": "opencode",
            "knownUserBinDirSuffixes": [
              ".opencode/bin",
              "AppData/Roaming/npm"
            ],
            "sourcePreference": "system-first"
          },
          "install": {
            "docsUrl": "https://opencode.ai",
            "guideUrl": "https://opencode.ai/docs",
            "managed": {
              "binaryName": "opencode",
              "kind": "managed_package",
              "packageBinarySetup": {
                "kind": "opencode_platform_binary"
              },
              "packageName": "opencode-ai"
            },
            "manual": {
              "kind": "command"
            },
            "recommendationOrder": 40
          }
        },
        "connectedAccounts": [
          {
            "credentialKinds": [
              "oauth",
              "token"
            ],
            "materializationKinds": [
              "environment",
              "httpHeaders"
            ],
            "purpose": "anthropic-model-request",
            "service": {
              "localId": "claude-subscription",
              "pluginId": "happier.agent.claude"
            }
          },
          {
            "credentialKinds": [
              "oauth"
            ],
            "materializationKinds": [
              "httpHeaders"
            ],
            "purpose": "openai-codex-model-request",
            "service": {
              "localId": "openai-codex",
              "pluginId": "happier.agent.codex"
            }
          },
          {
            "credentialKinds": [
              "token"
            ],
            "materializationKinds": [
              "environment"
            ],
            "purpose": "openai-api-key",
            "service": {
              "localId": "openai",
              "pluginId": "happier.voice.openai"
            }
          },
          {
            "credentialKinds": [
              "token"
            ],
            "materializationKinds": [
              "environment"
            ],
            "purpose": "anthropic-api-key",
            "service": {
              "localId": "anthropic",
              "pluginId": "happier.agent.claude"
            }
          }
        ],
        "id": "opencode",
        "primary": "sessions",
        "providerRequirements": {
          "acceptsProtocols": [
            "openai-responses",
            "openai-chat"
          ],
          "applyPolicy": "restart_session",
          "authIsolation": {
            "ownedEnvKeys": [
              "HAPPIER_OPENCODE_PROVIDER_API_KEY",
              "OPENCODE_AUTH_CONTENT",
              "OPENCODE_CONFIG_CONTENT",
              "OPENAI_API_KEY",
              "ANTHROPIC_API_KEY",
              "CLAUDE_CODE_OAUTH_TOKEN"
            ],
            "suppressConnectedServiceIds": [
              "openai-codex",
              "openai",
              "claude-subscription",
              "anthropic"
            ]
          },
          "credentialSupport": {
            "apiKeyTransports": [
              {
                "destination": {
                  "formats": [
                    "raw",
                    "bearer"
                  ],
                  "kind": "httpHeader",
                  "names": "anyValidated"
                },
                "protocol": "openai-responses"
              },
              {
                "destination": {
                  "formats": [
                    "raw",
                    "bearer"
                  ],
                  "kind": "httpHeader",
                  "names": "anyValidated"
                },
                "protocol": "openai-chat"
              }
            ],
            "noAuthProtocols": [
              "openai-chat"
            ],
            "supportsNoAuth": true
          },
          "materialization": "configFile",
          "required": {
            "streaming": true,
            "toolRoundTrips": true
          },
          "supportsFreeformModelIds": true
        },
        "runtime": {
          "kind": "custom"
        },
        "surfaces": {
          "externalSession": {
            "externalLinkedTakeover": {
              "writerSafety": "unsupported"
            },
            "sources": [
              {
                "instances": [
                  {
                    "constants": {
                      "managedEndpoint": true
                    },
                    "kind": "default"
                  },
                  {
                    "byServerIdSettingId": "opencodeServerBaseUrlByServerIdV1",
                    "constants": {},
                    "field": "baseUrl",
                    "kind": "agentSettingOverride",
                    "normalization": "httpOrigin",
                    "settingId": "opencodeServerBaseUrl"
                  }
                ],
                "key": {
                  "segments": [
                    {
                      "kind": "literal",
                      "value": "opencodeServer"
                    },
                    {
                      "field": "baseUrl",
                      "kind": "field"
                    },
                    {
                      "field": "directory",
                      "kind": "field"
                    }
                  ]
                },
                "schema": {
                  "fields": [
                    {
                      "kind": "literal",
                      "name": "kind",
                      "value": "opencodeServer"
                    },
                    {
                      "kind": "unknown",
                      "name": "baseUrl",
                      "optional": true
                    },
                    {
                      "kind": "unknown",
                      "name": "directory",
                      "optional": true
                    },
                    {
                      "kind": "unknown",
                      "name": "managedEndpoint",
                      "optional": true
                    }
                  ]
                },
                "sourceKind": "opencodeServer"
              }
            ]
          }
        },
        "title": "OpenCode"
      }
