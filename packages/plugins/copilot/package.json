{
  "name": "@happier-dev/plugins-copilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/contributions/runtime": {
      "types": "./dist/agent/contributions/runtime.d.ts",
      "default": "./dist/agent/contributions/runtime.js"
    },
    "./agent/promptAssets": {
      "types": "./dist/agent/promptAssets/index.d.ts",
      "default": "./dist/agent/promptAssets/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "react-native": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/runTypeScriptCli.mjs -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
