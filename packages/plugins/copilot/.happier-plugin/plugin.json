{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "delivery": [
              "newTurn",
              "steer",
              "followUp"
            ],
            "open": [
              "create",
              "resume"
            ]
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [
                  "login"
                ],
                "kind": "primary"
              }
            ],
            "probe": {
              "backgroundChecks": "safe",
              "envVars": [
                "COPILOT_GITHUB_TOKEN",
                "GH_TOKEN",
                "GITHUB_TOKEN"
              ],
              "parser": "copilotGhAuth",
              "statusArgs": null
            },
            "support": "login_terminal"
          },
          "displayName": "GitHub Copilot CLI",
          "executable": {
            "binaryName": "copilot",
            "knownUserBinDirSuffixes": null,
            "sourcePreference": "system-first"
          },
          "install": {
            "docsUrl": "https://docs.github.com/en/copilot/how-tos/set-up/install-copilot-cli",
            "guideUrl": null,
            "managed": {
              "binaryName": "copilot",
              "kind": "managed_package",
              "packageName": "@github/copilot"
            },
            "manual": {
              "kind": "command"
            }
          }
        },
        "id": "copilot",
        "primary": "sessions",
        "runtime": {
          "kind": "custom"
        },
        "title": "GitHub Copilot"
      }
    ],
