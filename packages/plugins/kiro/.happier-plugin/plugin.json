{
  "contributes": {
    "accessProviders": [],
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "delivery": [
              "newTurn",
              "followUp"
            ],
            "executionRunContext": {
              "versions": [
                1
              ]
            },
            "open": [
              "create",
              "resume"
            ]
          },
          "skills": {
            "delivery": "none",
            "liveReload": "unsupported",
            "nativeDisable": "unsupported",
            "nativeRoots": {
              "project": [
                [
                  ".kiro",
                  "skills"
                ]
              ],
              "user": [
                [
                  ".kiro",
                  "skills"
                ]
              ]
            }
          },
          "surfaces": [
            "externalSessions"
          ],
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "vendorResume": {
            "support": "experimental"
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [
                  "login"
                ],
                "kind": "primary"
              }
            ],
            "nonInteractiveStatusProbe": true,
            "support": "login_terminal"
          },
          "displayName": "Kiro CLI",
          "executable": {
            "binaryName": "kiro-cli",
            "knownUserBinDirSuffixes": null,
            "sourcePreference": "system-first"
          },
          "install": {
            "docsUrl": "https://kiro.dev/docs/cli/acp/",
            "managed": null,
            "manual": {
              "kind": "command"
            }
          }
        },
        "id": "kiro",
        "primary": "sessions",
        "runtime": {
          "definition": {
            "mcp": {
              "policy": "pass_through"
            },
            "modelConfigOptionId": "model",
            "stderrRules": {
              "suppress": [
                {
                  "includes": [
                    "error handling notification",
                    "_kiro.dev/",
                    "method not found"
                  ]
                }
              ]
            }
          },
          "kind": "acp",
          "transport": {
            "args": [
              "acp"
            ],
            "executable": {
              "id": "kiro-cli",
              "kind": "systemTool"
            },
            "kind": "stdio"
          }
        },
        "surfaces": {
          "externalSession": {
            "externalLinkedTakeover": {
              "writerSafety": "unsupported"
            },
            "sources": [
              {
                "contentSearch": true,
                "instances": [
                  {
                    "constants": {},
                    "kind": "default"
                  }
                ],
                "key": {
                  "segments": [
                    {
                      "kind": "literal",
                      "value": "kiroChatStore"
                    },
                    {
                      "field": "kiroHome",
                      "kind": "field"
                    }
                  ]
                },
                "schema": {
                  "fields": [
                    {
                      "kind": "literal",
                      "name": "kind",
                      "value": "kiroChatStore"
                    },
                    {
                      "kind": "string",
                      "max": 10000,
                      "min": 1,
                      "name": "kiroHome",
                      "nullish": true
                    }
                  ]
                },
                "sourceKind": "kiroChatStore"
              }
            ]
          }
        },
        "title": "Kiro"
      }
    ],
