{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "delivery": [
              "newTurn",
              "steer",
              "followUp"
            ],
            "open": [
              "create",
              "resume"
            ]
          },
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "vendorResume": {
            "support": "experimental"
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [
                  "login"
                ],
                "kind": "primary"
              }
            ],
            "nonInteractiveStatusProbe": true,
            "support": "login_terminal"
          },
          "displayName": "Kiro CLI",
          "executable": {
            "binaryName": "kiro-cli",
            "knownUserBinDirSuffixes": null,
            "sourcePreference": "system-first"
          },
          "install": {
            "docsUrl": "https://kiro.dev/docs/cli/acp/",
            "managed": null,
            "manual": {
              "kind": "command"
            }
          }
        },
        "id": "kiro",
        "primary": "sessions",
        "runtime": {
          "definition": {
            "mcp": {
              "policy": "pass_through"
            },
            "modelConfigOptionId": "model",
            "stderrRules": {
              "suppress": [
                {
                  "includes": [
                    "error handling notification",
                    "_kiro.dev/",
                    "method not found"
                  ]
                }
              ]
            }
          },
          "kind": "acp",
          "transport": {
            "args": [
              "acp"
            ],
            "executable": {
              "id": "kiro-cli",
              "kind": "systemTool"
            },
            "kind": "stdio"
          }
        },
        "title": "Kiro"
      }
    ],
    "backgroundServices": [],
    "browserActions": [],
    "browserTargets": [],
    "commands": [],
    "composerAttachments": [],
    "composerControls": [],
    "composerReferences": [],
    "composerRegions": [],
    "connectedAccountDescriptors": [],
    "daemonDatabases": [],
    "events": [],
    "executionRunProfiles": [],
    "hooks": [],
    "managedDependencies": [],
    "mcp": {
      "discoverySources": [],
      "servers": []
    },
    "notificationChannels": [],
    "notifications": [],
    "openableContentViewers": [],
    "pluginContributionPoints": [],
    "promptAssets": [],
    "providers": [],
    "requestInterceptors": [],
    "resources": [],
    "scmBackends": [],
    "scmHostingProviders": [],
    "sessionHeaderActions": [],
    "sessionInfoSections": [],
    "settings": [
      {
        "actions": [],
        "fields": [],
        "id": "agent-settings",
        "presentation": {
          "icon": {
            "color": {
              "kind": "theme",
              "token": "orange"
            },
            "ionName": "flash-outline"
          },
          "sections": [],
          "subagentSections": []
        },
        "scope": "account",
        "target": {
          "agent": "kiro",
          "kind": "agent"
        },
        "title": {
          "fallback": "Kiro",
          "key": "settingsAgents.plugins.kiro.title"
        },
        "version": 1
      }
    ],
    "systemTools": [
      {
        "executableNames": [
          "kiro-cli"
        ],
        "id": "kiro-cli",
        "title": "Kiro CLI"
      }
    ],
    "targetedPluginContributions": [],
    "tools": [],
    "transcriptActivities": [],
    "ui": {
      "renderers": [],
      "settingsGroups": [],
      "settingsPages": [],
      "translations": [],
      "views": []
    },
    "voiceModelPacks": [],
    "voiceProviders": [],
    "webhooks": []
  },
  "displayName": "Kiro",
  "engines": {
    "happier": "^0.0.0"
  },
  "entrypoints": {
    "daemon": "./.happier-plugin/daemon.js"
  },
  "hostAccess": {
    "optional": [],
    "required": [
      {
        "capability": "process",
        "id": "kiro-process",
        "reason": "Run the declared Kiro CLI executable.",
        "scope": {
          "executables": [
            {
              "id": "kiro-cli",
              "kind": "systemTool"
            }
          ]
        }
      }
    ]
  },
  "id": "happier.agent.kiro",
  "runtime": {
    "apiVersion": 1
  },
  "schemaVersion": 2,
  "secrets": [],
  "version": "0.0.0"
}
