{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "configuration": true,
            "delivery": [
              "newTurn",
              "followUp"
            ],
            "executionRunContext": {
              "versions": [
                1
              ]
            },
            "open": [
              "create",
              "resume"
            ]
          },
          "surfaces": [
            "terminal"
          ],
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "vendorResume": {
            "support": "supported"
          }
        },
        "cli": {
          "auth": {
            "environmentVariables": [
              "FACTORY_API_KEY"
            ],
            "loginLaunches": [
              {
                "args": [],
                "initialInput": "/login",
                "kind": "primary"
              }
            ],
            "missingCredentialState": "unknown",
            "support": "login_terminal"
          },
          "displayName": "Factory Droid CLI",
          "executable": {
            "binaryName": "droid",
            "knownUserBinDirSuffixes": [
              ".local/bin"
            ],
            "sourcePreference": "system-first",
            "systemCommandResolutionStrategy": "path-first"
          },
          "install": {
            "docsUrl": "https://docs.factory.ai/droid-cli/cli-reference",
            "guideUrl": "https://docs.factory.ai/droid-cli/overview",
            "managed": null,
            "manual": {
              "kind": "vendor_recipe",
              "recipes": {
                "darwin": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://app.factory.ai/cli | sh"
                    ],
                    "cmd": "bash"
                  }
                ],
                "linux": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://app.factory.ai/cli | sh"
                    ],
                    "cmd": "bash"
                  }
                ],
                "win32": [
                  {
                    "args": [
                      "-NoProfile",
                      "-ExecutionPolicy",
                      "Bypass",
                      "-Command",
                      "Invoke-RestMethod https://app.factory.ai/cli/windows | Invoke-Expression"
                    ],
                    "cmd": "powershell"
                  }
                ]
              }
            }
          }
        },
        "description": {
          "fallback": "Factory Droid (experimental)",
          "key": "profiles.aiBackend.droidSubtitleExperimental"
        },
        "id": "droid",
        "primary": "sessions",
        "runtime": {
          "definition": {
            "mcp": {
              "policy": "pass_through"
            },
            "modelConfigOptionId": "model"
          },
          "kind": "acp",
          "transport": {
            "args": [
              "exec",
              "--output-format",
              "acp"
            ],
            "executable": {
              "id": "droid-cli",
              "kind": "systemTool"
            },
            "kind": "stdio"
          }
        },
        "title": {
          "fallback": "Factory Droid",
          "key": "agentInput.agent.droid"
        }
      }
    ],
