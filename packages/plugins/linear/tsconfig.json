{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["node"], "rootDir": "src", "outDir": "dist",
    "incremental": true, "tsBuildInfoFile": "dist/.tsbuildinfo", "declaration": true,
    "declarationMap": true, "sourceMap": true, "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.test-support.ts"]
}
