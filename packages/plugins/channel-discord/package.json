{
  "name": "@happier-dev/plugins-channel-discord",
  "version": "0.0.0",
  "private": true,
  "happier": {
    "pluginScaffold": {
      "shipping": "reservation_only",
      "plannedStage": "C7 after C4, SDK-NETWORK-01, and SDK-BACKGROUND"
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config vitest.config.ts --testTimeout 15000",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/channels-protocol": "0.0.0",
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "tar": "7.5.22",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
