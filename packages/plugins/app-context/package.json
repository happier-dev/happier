{
  "name": "@happier-dev/plugins-app-context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["assets", "dist", ".happier-plugin", "package.json"],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json --happier-staged-output-script build:ui",
    "build:ui": "happier-plugin-build-ui",
    "build:finite": "pnpm --silent run build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": { "happier-source": "./src/index.ts", "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./manifest": { "happier-source": "./src/manifest.ts", "types": "./dist/manifest.d.ts", "default": "./dist/manifest.js" },
    "./happier-plugin-ui/transcript-annotation-native": "./src/ui/transcriptAnnotation.ts"
  },
  "dependencies": { "@happier-dev/plugin-sdk": "0.0.0", "@happier-dev/plugin-ui": "0.0.0" },
  "devDependencies": { "@happier-dev/protocol": "0.0.0", "@types/react": "19.2.0", "react": "19.2.0", "typescript": "^5.9.2", "vitest": "^3.2.4" }
}
