        "id": "ohmypi",
        "primary": "sessions",
        "runtime": {
          "kind": "custom"
        },
        "surfaces": {
          "externalSession": {
            "externalLinkedTakeover": {
              "writerSafety": "unsupported"
            },
            "sources": [
              {
                "instances": [
                  {
                    "constants": {},
                    "kind": "default"
                  },
                  {
                    "constants": {},
                    "field": "agentDir",
                    "kind": "agentSettingOverride",
                    "normalization": "configuredPath",
                    "settingId": "ohMyPiAgentDir"
                  }
                ],
                "key": {
                  "segments": [
                    {
                      "kind": "literal",
                      "value": "ohMyPiAgentDir"
                    },
                    {
                      "field": "agentDir",
                      "kind": "field"
                    }
                  ]
                },
                "schema": {
                  "fields": [
                    {
                      "kind": "literal",
                      "name": "kind",
                      "value": "ohMyPiAgentDir"
                    },
                    {
                      "kind": "string",
                      "max": 10000,
                      "min": 1,
                      "name": "agentDir",
                      "nullish": true
                    },
                    {
                      "kind": "string",
                      "max": 10000,
                      "min": 1,
                      "name": "sessionFilePath",
                      "nullish": true
                    }
                  ]
                },
                "sourceKind": "ohMyPiAgentDir"
              }
            ]
          }
        },
        "title": "Oh My Pi"
      }
