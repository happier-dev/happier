{
  "name": "@happier-dev/plugins-ohmypi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent/surfaces/sessions/external/provider": {
      "types": "./dist/agent/surfaces/sessions/external/provider.d.ts",
      "default": "./dist/agent/surfaces/sessions/external/provider.js"
    },
    "./agent/terminalRuntime/breadcrumb": {
      "types": "./dist/agent/terminalRuntime/breadcrumb.d.ts",
      "default": "./dist/agent/terminalRuntime/breadcrumb.js"
    },
    "./agent/transcripts/snapshot": {
      "types": "./dist/agent/transcripts/snapshot.d.ts",
      "default": "./dist/agent/transcripts/snapshot.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../../scripts/workspaces/runTypeScriptCli.mjs -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/agents": "0.0.0",
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/protocol": "0.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
