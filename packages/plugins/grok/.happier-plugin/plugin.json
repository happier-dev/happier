{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "configuration": true,
            "conversationRollback": true,
            "delivery": [
              "newTurn",
              "steer",
              "followUp"
            ],
            "open": [
              "create",
              "resume",
              "fork"
            ],
            "workStateSources": [
              {
                "id": "goals",
                "itemKinds": [
                  "goal"
                ]
              }
            ]
          },
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "vendorResume": {
            "support": "supported"
          }
        },
        "cli": {
          "auth": {
            "environmentVariables": [
              "XAI_API_KEY"
            ],
            "loginLaunches": [
              {
                "args": [
                  "login"
                ],
                "kind": "primary"
              },
              {
                "args": [
                  "login",
                  "--device-auth"
                ],
                "kind": "device_code"
              }
            ],
            "missingCredentialState": "unknown",
            "support": "login_terminal"
          },
          "executable": {
            "binaryName": "grok",
            "knownUserBinDirSuffixes": [
              ".grok/bin",
              ".local/bin"
            ],
            "sourcePreference": "system-first",
            "systemCommandResolutionStrategy": "path-first"
          },
          "install": {
            "docsUrl": "https://x.ai",
            "guideUrl": "https://x.ai/cli",
            "managed": null,
            "manual": {
              "kind": "vendor_recipe",
              "recipes": {
                "darwin": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://x.ai/cli/install.sh | bash"
                    ],
                    "cmd": "bash"
                  }
                ],
                "linux": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://x.ai/cli/install.sh | bash"
                    ],
                    "cmd": "bash"
                  }
                ],
                "win32": [
                  {
                    "args": [
                      "-NoProfile",
                      "-ExecutionPolicy",
                      "Bypass",
                      "-Command",
                      "irm https://x.ai/cli/install.ps1 | iex"
                    ],
                    "cmd": "powershell"
                  }
                ]
              }
            }
          }
        },
        "description": {
          "fallback": "Grok Build CLI (experimental)",
          "key": "profiles.aiBackend.grokSubtitleExperimental"
        },
        "id": "grok",
        "primary": "sessions",
        "runtime": {
          "kind": "custom"
        },
        "title": {
          "fallback": "Grok",
          "key": "agentInput.agent.grok"
        }
      }
    ],
