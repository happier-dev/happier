            "sourcePreference": "system-first",
            "systemCommandResolutionStrategy": "path-first"
          },
          "install": {
            "docsUrl": "https://x.ai",
            "guideUrl": "https://x.ai/cli",
            "managed": null,
            "manual": {
              "kind": "vendor_recipe",
              "recipes": {
                "darwin": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://x.ai/cli/install.sh | bash"
                    ],
                    "cmd": "bash"
                  }
                ],
                "linux": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://x.ai/cli/install.sh | bash"
                    ],
                    "cmd": "bash"
                  }
                ],
                "win32": [
                  {
                    "args": [
                      "-NoProfile",
                      "-ExecutionPolicy",
                      "Bypass",
                      "-Command",
                      "irm https://x.ai/cli/install.ps1 | iex"
                    ],
                    "cmd": "powershell.exe"
                  }
                ]
              }
            }
          }
        },
        "description": {
