{
  "name": "@happier-dev/plugins-scm-git",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./operations/stashOperations": {
      "types": "./dist/operations/stashOperations.d.ts",
      "default": "./dist/operations/stashOperations.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/runTypeScriptCli.mjs -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
