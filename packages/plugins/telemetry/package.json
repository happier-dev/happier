{
  "name": "@happier-dev/plugins-telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./capture-views": {
      "happier-source": "./src/ui/capture/index.ts",
      "types": "./dist/ui/capture/index.d.ts",
      "default": "./dist/ui/capture/index.js"
    },
    "./happier-plugin-ui/telemetry-exception-detail-native": "./src/ui/exceptionDetail.tsx",
    "./happier-plugin-ui/telemetry-app-vitals-widget-native": "./src/ui/widgets/appVitalsWidget.tsx",
    "./happier-plugin-ui/telemetry-metric-widget-native": "./src/ui/widgets/metricWidget.tsx",
    "./happier-plugin-ui/telemetry-slowest-routes-widget-native": "./src/ui/widgets/slowestRoutesWidget.tsx"
  },
  "files": [
    "src",
    "dist",
    ".happier-plugin",
    ".happier-plugin-build",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/databases": "0.0.0",
    "@happier-dev/database-protocol": "0.0.0",
    "@happier-dev/triage-protocol": "0.0.0",
    "@happier-dev/triage-sources": "0.0.0",
    "protobufjs": "7.6.6",
    "@happier-dev/plugin-ui": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/react": "19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
