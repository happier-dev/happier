              }
            },
            "mcp": {
              "policy": "pass_through"
            },
            "usageLimitDiagnostic": {
              "connectedAccountService": {
                "localId": "antigravity-account",
                "pluginId": "happier.agent.antigravity"
              },
              "pattern": "^Usage Limit Reached\\n\\nYou have reached your current quota for this period\\.(?: Your limit will reset (?:in \\d+ (?:days?|hours?|minutes?|seconds?)(?:, \\d+ (?:days?|hours?|minutes?|seconds?))?|on [A-Z][a-z]{2} \\d{1,2}, \\d{4} \\d{2}:\\d{2} UTC)\\.)?$"
            }
          },
          "kind": "acp",
          "transport": {
