      {
        "capability": "network",
        "id": "antigravity-oauth",
        "reason": "Authorize and refresh the selected Google Antigravity account.",
        "scope": {
          "methods": [
            "GET",
            "POST"
          ],
          "targets": [
            {
              "kind": "fixedOrigin",
              "origin": "https://oauth2.googleapis.com"
            },
            {
              "kind": "fixedOrigin",
              "origin": "https://www.googleapis.com"
            }
          ]
        }
      },
      {
        "capability": "filesystem",
        "id": "antigravity-external-session-transcripts",
        "reason": "Read source-qualified Antigravity CLI transcripts for External Session observation.",
        "scope": {
          "access": [
            "read"
          ],
          "locations": [
            {
              "root": "workspace"
            }
          ]
        }
      },
