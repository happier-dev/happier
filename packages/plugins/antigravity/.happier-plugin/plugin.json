        "capability": "process",
        "id": "antigravity-acp-process",
        "reason": "Launch the pinned official Antigravity ACP server through host-mediated execution.",
        "scope": {
          "envKeys": [
            "GEMINI_HOME",
            "AGY_ACP_FORCE_FILE_STORAGE"
          ],
          "executables": [
            {
