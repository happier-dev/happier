{
  "name": "@happier-dev/plugins-triage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./targeted-contributions": {
      "happier-source": "./src/targetedContributions.ts",
      "types": "./dist/targetedContributions.d.ts",
      "default": "./dist/targetedContributions.js"
    },
    "./happier-plugin-ui/triage-account-runtime": "./src/accountRuntime.ts",
    "./happier-plugin-ui/triage-list-page-native": "./src/ui/surface.tsx",
    "./happier-plugin-ui/triage-internal-task-detail-native": "./src/internalTasks/detail.tsx",
    "./happier-plugin-ui/triage-internal-task-settings-native": "./src/internalTasks/settings.tsx",
    "./happier-plugin-ui/triage-tasks-page-native": "./src/ui/tasksSurface.tsx",
    "./happier-plugin-ui/triage-entity-drag-drop-native": "./src/ui/list/entryDragDrop.ts",
    "./happier-plugin-ui/triage-latest-widget-native": "./src/ui/widget/latestWidget.tsx",
    "./happier-plugin-ui/triage-tasks-widget-native": "./src/ui/widget/tasksWidget.tsx",
    "./happier-plugin-ui/triage-entry-picker-native": "./src/composer/entryPicker.tsx",
    "./happier-plugin-ui/triage-comparison-picker-native": "./src/ui/comparisonPicker.tsx",
    "./happier-plugin-ui/triage-entries-compact-native": "./src/composer/controlCompact.tsx",
    "./happier-plugin-ui/triage-session-entries-native": "./src/sessions/cockpit/sessionLinkedEntriesSurface.tsx",
    "./happier-plugin-ui/triage-search-action-native": "./src/actions/searchEntries.ts",
    "./happier-plugin-ui/triage-mounted-ui-action-native": "./src/actions/mountedUi.ts",
    "./happier-plugin-ui/triage-configured-action-native": "./src/actions/configuredActionRun.ts",
    "./happier-plugin-ui/triage-collection-migrations": "./src/collectionMigrationArtifact.ts"
  },
  "files": [
    "assets",
    "dist",
    ".happier-plugin",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json --happier-staged-output-script build:ui",
    "build:finite": "pnpm --silent run build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "pnpm --silent run test:unit:prepare && vitest run --config vitest.config.ts",
    "test:unit:prepare": "node --test ./scripts/ensureTypecheckDeclarationPrerequisites.test.mjs",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ./scripts/ensureTypecheckDeclarationPrerequisites.mjs && node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "build:ui": "happier-plugin-build-ui"
  },
  "dependencies": {
    "@happier-dev/channels-protocol": "0.0.0",
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "@happier-dev/triage-protocol": "0.0.0",
    "@happier-dev/triage-sources": "0.0.0"
  },
  "devDependencies": {
    "@happier-dev/protocol": "0.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
