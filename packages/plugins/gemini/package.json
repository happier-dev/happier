{
  "name": "@happier-dev/plugins-gemini",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".happier-plugin",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:finite": "yarn -s build",
    "project:finite": "node --experimental-strip-types ../../../apps/cli/scripts/build-owned/checkBundledPluginWorkspace.mjs",
    "test": "../../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "happier-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./agent/auth/resolution": {
      "happier-source": "./src/agent/auth/resolution.ts",
      "types": "./dist/agent/auth/resolution.d.ts",
      "default": "./dist/agent/auth/resolution.js"
    },
    "./agent/diff/toolResult": {
      "happier-source": "./src/agent/diff/toolResult.ts",
      "types": "./dist/agent/diff/toolResult.d.ts",
      "default": "./dist/agent/diff/toolResult.js"
    },
    "./agent/acp/toolNames": {
      "happier-source": "./src/agent/acp/toolNames.ts",
      "types": "./dist/agent/acp/toolNames.d.ts",
      "default": "./dist/agent/acp/toolNames.js"
    },
    "./agent/acp/definition": {
      "happier-source": "./src/agent/acp/definition.ts",
      "types": "./dist/agent/acp/definition.d.ts",
      "default": "./dist/agent/acp/definition.js"
    },
    "./agent/promptAssets": {
      "happier-source": "./src/agent/promptAssets/index.ts",
      "types": "./dist/agent/promptAssets/index.d.ts",
      "default": "./dist/agent/promptAssets/index.js"
    }
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "@happier-dev/protocol": "0.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
