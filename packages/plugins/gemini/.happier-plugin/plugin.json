            {
              "fields": [
                {
                  "id": "token",
                  "schema": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "secret": true,
                  "title": "Gemini API key"
                }
              ],
              "id": "api-key",
              "kind": "manual",
              "outcomeReconciliation": "none"
            },
            {
              "fields": [
                {
                  "id": "credentialsJson",
                  "schema": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "secret": true,
