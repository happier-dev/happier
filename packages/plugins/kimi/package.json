{
  "name": "@happier-dev/plugins-kimi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./agent/acp/definition": {
      "types": "./dist/agent/acp/definition.d.ts",
      "default": "./dist/agent/acp/definition.js"
    },
    "./agent/acp/pythonSelectorEnv": {
      "types": "./dist/agent/acp/pythonSelectorEnv.d.ts",
      "default": "./dist/agent/acp/pythonSelectorEnv.js"
    },
    "./agent/contributions/runtime": {
      "types": "./dist/agent/contributions/runtime.d.ts",
      "default": "./dist/agent/contributions/runtime.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "node ../../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
