{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "configuration": true,
            "delivery": [
              "newTurn",
              "followUp"
            ],
            "executionRunContext": {
              "versions": [
                1
              ]
            },
            "open": [
              "create",
              "resume",
              "fork"
            ]
          },
          "surfaces": [
            "terminal",
            "externalSessions"
          ],
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "vendorResume": {
            "support": "supported"
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [
                  "login"
                ],
                "kind": "primary"
              }
            ],
            "support": "login_terminal"
          },
          "displayName": "Kimi Code CLI",
          "executable": {
            "binaryName": "kimi",
            "knownUserBinDirSuffixes": [
              ".local/bin"
            ],
            "sourcePreference": "system-first",
            "systemCommandResolutionStrategy": "path-first"
          },
          "install": {
            "docsUrl": "https://moonshotai.github.io/kimi-code/",
            "guideUrl": "https://moonshotai.github.io/kimi-code/docs/en/reference/kimi-command.html",
            "managed": null,
            "manual": {
              "kind": "vendor_recipe",
              "recipes": {
                "darwin": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash"
                    ],
                    "cmd": "bash"
                  }
                ],
                "linux": [
                  {
                    "args": [
                      "-lc",
                      "curl -fsSL https://code.kimi.com/kimi-code/install.sh | bash"
                    ],
                    "cmd": "bash"
                  }
                ],
                "win32": [
                  {
                    "args": [
                      "-NoProfile",
                      "-ExecutionPolicy",
                      "Bypass",
                      "-Command",
                      "Invoke-RestMethod https://code.kimi.com/kimi-code/install.ps1 | Invoke-Expression"
                    ],
                    "cmd": "powershell"
                  }
                ]
              }
            }
          }
        },
        "description": {
          "fallback": "Kimi coding agent (experimental)",
          "key": "profiles.aiBackend.kimiSubtitleExperimental"
        },
        "id": "kimi",
        "primary": "sessions",
        "runtime": {
          "definition": {
            "mcp": {
              "policy": "pass_through"
            },
            "modelConfigOptionId": "model",
            "stderrRules": {
              "authenticationErrorDetail": "Authentication error. Run `kimi login` to re-authenticate, then retry."
            }
          },
          "kind": "acp",
          "transport": {
            "args": [
              "acp"
            ],
            "executable": {
              "id": "kimi-cli",
              "kind": "systemTool"
            },
            "kind": "stdio",
            "timeouts": {
              "idleMs": 500,
              "initializeMs": 90000,
              "toolCallMs": 120000
            }
          }
        },
        "surfaces": {
          "externalSession": {
            "sources": [
              {
                "instances": [
                  {
                    "constants": {},
                    "kind": "default"
                  }
                ],
                "key": {
                  "segments": [
                    {
                      "kind": "literal",
                      "value": "kimiAcpSessionList"
                    }
                  ]
                },
                "resumeOnly": true,
                "schema": {
                  "fields": [
                    {
                      "kind": "literal",
                      "name": "kind",
                      "value": "kimiAcpSessionList"
                    }
                  ]
                },
                "sourceKind": "kimiAcpSessionList"
              }
            ]
          }
        },
        "title": {
          "fallback": "Kimi",
          "key": "agentInput.agent.kimi"
        }
      }
