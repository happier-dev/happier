  "engines": {
    "happier": "^0.0.0"
  },
  "entrypoints": {
    "daemon": "./.happier-plugin/daemon.js"
  },
  "hostAccess": {
    "optional": [],
    "required": [
      {
        "capability": "environment",
        "id": "cursor-api-key",
        "reason": "Read CURSOR_API_KEY when environment-based Cursor authentication is selected.",
        "scope": {
          "keys": [
            "CURSOR_API_KEY"
          ]
        }
      },
      {
        "capability": "process",
        "id": "cursor-process",
        "reason": "Launch the user-installed Cursor Agent CLI.",
        "scope": {
          "envKeys": [
            "CURSOR_API_KEY"
          ],
          "executables": [
            {
              "id": "cursor-agent",
              "kind": "systemTool"
            },
            {
              "id": "cursor-agent-no-fallback",
              "kind": "systemTool"
            }
          ]
        }
      }
    ]
  },
  "id": "happier.agent.cursor",
  "runtime": {
    "agentFactories": [
      {
        "loadMode": "immutable-js",
        "localAgentId": "cursor",
        "locator": {
          "export": "createCursorAgentRuntime",
          "module": "./agent/runtime/engine",
          "runtimeApiVersion": 1
        },
        "normalizedModulePath": ".happier-plugin/agent/runtime/engine.js"
      }
    ],
    "apiVersion": 1
  },
  "schemaVersion": 2,
  "secrets": [],
  "version": "0.0.0"
