{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "configuration": true,
            "delivery": [
              "newTurn",
              "followUp"
            ],
            "executionRunContext": {
              "versions": [
                1
              ]
            },
            "open": [
              "create",
              "resume"
            ]
          },
          "surfaces": [
            "terminal"
          ],
          "tools": {
            "delivery": "native_mcp"
          }
        },
        "catalog": {
          "vendorResume": {
            "support": "supported"
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [
                  "auth",
                  "login"
                ],
                "kind": "primary"
              }
            ],
            "nonInteractiveStatusProbe": true,
            "support": "login_terminal"
          },
          "displayName": "Devin CLI",
          "executable": {
            "binaryName": "devin",
            "knownUserBinDirSuffixes": [
              ".local/bin"
            ],
            "sourcePreference": "system-first",
            "systemCommandResolutionStrategy": "path-first"
          },
          "install": {
            "docsUrl": "https://docs.devin.ai/work-with-devin/devin-cli",
            "guideUrl": "https://docs.devin.ai/work-with-devin/devin-cli",
            "managed": null,
            "manual": {
              "kind": "command"
            }
          }
        },
        "description": {
          "fallback": "Devin CLI (experimental)",
          "key": "profiles.aiBackend.devinSubtitleExperimental"
        },
        "id": "devin",
        "primary": "sessions",
        "runtime": {
          "definition": {
            "mcp": {
              "nativeSessionConfig": {
                "configRootEnvKey": {
                  "posix": "XDG_CONFIG_HOME",
                  "win32": "APPDATA"
                },
                "directory": "devin",
                "fileName": "mcp_config.json",
                "homeRelativeConfigRoot": {
                  "posix": [
                    ".config"
                  ],
                  "win32": [
                    "AppData",
                    "Roaming"
                  ]
                },
                "linkedConfigRootEntries": [
                  "cognition"
                ],
                "projectShadowPaths": [
                  ".devin/mcp_config.json",
                  ".devin/mcp_config.local.json"
                ],
                "serverEntryConstants": {
                  "transport": "stdio"
                },
                "serversKey": "mcpServers"
              },
              "policy": "drop"
            },
            "modelConfigOptionId": "model",
            "models": {
              "suffixOption": {
                "id": "reasoning_effort",
                "modelNameFillerWords": [
                  "Thinking"
                ],
                "name": "Reasoning effort",
                "trailingOption": {
                  "defaultValue": {
                    "name": "Standard",
                    "value": "standard"
                  },
                  "id": "service_tier",
                  "name": "Speed",
                  "values": [
                    {
                      "modelNameWords": [
                        "Fast"
                      ],
                      "name": "Fast",
                      "segment": "fast",
                      "value": "fast"
                    },
                    {
                      "modelNameWords": [
                        "Fast"
                      ],
                      "name": "Fast",
                      "segment": "priority",
                      "value": "priority"
                    }
                  ]
                },
                "values": [
                  {
                    "modelNameWords": [
                      "No",
                      "None"
                    ],
                    "name": "None",
                    "value": "none"
                  },
                  {
                    "name": "Low",
                    "value": "low"
                  },
                  {
                    "name": "Medium",
                    "value": "medium"
                  },
                  {
                    "name": "High",
                    "value": "high"
                  },
                  {
                    "modelNameWords": [
                      "XHigh",
                      "X-High"
                    ],
                    "name": "XHigh",
                    "value": "xhigh"
                  },
                  {
                    "name": "Max",
                    "value": "max"
                  }
                ]
              }
            },
            "permissionModeMapping": {
              "default": null,
              "plan": "plan",
              "read-only": "ask",
              "safe-yolo": "smart",
              "yolo": "bypass"
            }
          },
          "kind": "acp",
          "transport": {
            "args": [
              "acp"
            ],
            "executable": {
              "id": "devin-cli",
              "kind": "systemTool"
            },
            "kind": "stdio"
          }
        },
        "title": {
          "fallback": "Devin",
          "key": "agentInput.agent.devin"
        }
      }
    ],
    "backgroundServices": [],
    "browserActions": [],
    "browserTargets": [],
