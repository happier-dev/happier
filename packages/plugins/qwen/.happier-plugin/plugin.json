{
  "contributes": {
    "accountCollections": [],
    "actions": [],
    "agents": [
      {
        "capabilities": {
          "sessions": {
            "cancel": true,
            "delivery": [
              "newTurn",
              "steer",
              "followUp"
            ],
            "open": [
              "create",
              "resume"
            ]
          }
        },
        "cli": {
          "auth": {
            "loginLaunches": [
              {
                "args": [],
                "initialInput": "/auth\r",
                "kind": "primary"
              }
            ],
            "probe": {
              "backgroundChecks": "safe",
              "parser": "unknown",
              "statusArgs": null
            },
            "support": "login_terminal"
          },
          "displayName": "Qwen CLI",
          "executable": {
            "binaryName": "qwen",
            "knownUserBinDirSuffixes": null,
            "sourcePreference": "system-first"
          },
          "install": {
            "docsUrl": null,
            "guideUrl": "https://qwenlm.github.io/qwen-code-docs/",
            "managed": {
              "binaryName": "qwen",
              "kind": "managed_package",
              "packageName": "@qwen-code/qwen-code"
            },
            "manual": {
              "kind": "command"
            }
          }
        },
        "id": "qwen",
        "primary": "sessions",
        "runtime": {
          "kind": "custom"
        },
        "title": "Qwen Code"
      }
    ],
    "backgroundServices": [],
    "browserActions": [],
    "browserTargets": [],
    "commands": [],
    "composerAttachments": [],
    "composerControls": [],
    "composerReferences": [],
    "composerRegions": [],
    "connectedAccountDescriptors": [],
    "daemonDatabases": [],
    "events": [],
    "executionRunProfiles": [],
    "hooks": [],
    "managedDependencies": [],
    "mcp": {
      "discoverySources": [],
      "servers": []
    },
    "notificationChannels": [],
    "notifications": [],
    "openableContentViewers": [],
    "pluginContributionPoints": [],
    "promptAssets": [],
    "providers": [],
    "requestInterceptors": [],
    "resources": [],
    "scmBackends": [],
    "scmHostingProviders": [],
    "sessionHeaderActions": [],
    "settings": [],
    "systemTools": [
      {
        "executableNames": [
          "qwen"
        ],
        "id": "qwen-cli",
        "title": "Qwen Code CLI"
      }
    ],
    "targetedPluginContributions": [],
