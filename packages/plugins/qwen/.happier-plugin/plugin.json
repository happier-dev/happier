    "happier": "^0.0.0"
  },
  "entrypoints": {
    "daemon": "./dist/index.js"
  },
  "hostAccess": {
    "optional": [],
    "required": [
      {
        "capability": "process",
        "id": "qwen-process",
        "reason": "Run the declared Qwen CLI executable.",
        "scope": {
          "executables": [
            {
              "id": "qwen-cli",
              "kind": "systemTool"
            }
          ]
        }
      }
    ]
  },
  "id": "happier.agent.qwen",
