            "required": true,
            "valueKind": "string",
            "secret": false,
            "default": "happier",
            "sites": [
              {
                "service": "mysql",
                "path": [
                  "environment",
                  "MYSQL_USER"
                ]
              }
            ]
          },
          {
            "key": "MYSQL_APP_DATABASE",
            "label": "Database name",
            "required": true,
            "valueKind": "string",
            "secret": false,
            "default": "app",
            "sites": [
              {
                "service": "mysql",
                "path": [
                  "environment",
                  "MYSQL_DATABASE"
                ]
              }
            ]
          },
          {
            "key": "MYSQL_APP_PASSWORD",
            "label": "Database password",
            "required": true,
            "valueKind": "string",
            "secret": true,
            "sites": [
              {
                "service": "mysql",
                "path": [
                  "environment",
                  "MYSQL_PASSWORD"
                ]
              }
            ]
          },
          {
            "key": "MYSQL_ROOT_PASSWORD",
            "label": "Root password",
            "required": true,
            "valueKind": "string",
            "secret": true,
            "sites": [
              {
                "service": "mysql",
                "path": [
                  "environment",
                  "MYSQL_ROOT_PASSWORD"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [
          {
            "key": "MYSQL_APP_PASSWORD",
            "purpose": "database-password",
            "label": "Database password",
            "profile": {
              "kind": "base64url-32-bytes"
            }
          },
          {
            "key": "MYSQL_ROOT_PASSWORD",
            "purpose": "database-root-password",
            "label": "Root password",
            "profile": {
              "kind": "base64url-32-bytes"
            }
          }
        ],
        "domains": [],
        "volumes": [
          {
            "id": "mysql-data",
            "service": "mysql",
            "target": "/var/lib/mysql",
            "persistent": true,
            "backup": false
          }
        ],
        "health": [
          {
            "service": "mysql",
            "participates": true
          }
        ],
        "data": {
          "engine": "mysql",
          "version": "8.4",
          "service": "mysql",
          "port": 3306,
          "variables": {
            "username": "MYSQL_APP_USER",
            "password": "MYSQL_APP_PASSWORD",
            "database": "MYSQL_APP_DATABASE"
          }
        },
        "exports": {
          "MYSQL_URL": {
            "service": "mysql",
            "port": 3306,
            "scheme": "mysql",
            "defaultExposure": "internal",
            "env": {
              "MYSQL_URL": "mysql://${MYSQL_APP_USER}:${MYSQL_APP_PASSWORD}@mysql:3306/${MYSQL_APP_DATABASE}"
            }
          }
        },
        "loginFields": {
          "username": "MYSQL_APP_USER",
          "password": "MYSQL_APP_PASSWORD"
        }
      }
    },
    {
      "itemId": "redis",
      "app": {
        "schemaVersion": 1,
        "title": "Redis",
        "description": "A Redis cache with internal connectivity and a saved password.",
        "category": "database",
        "documentationUrl": "https://redis.io/docs/latest/",
        "compose": {
          "document": "services:\n  redis:\n    image: redis:7\n    environment:\n      REDIS_PASSWORD: ${REDIS_PASSWORD}\n    command: [sh, -c, 'exec redis-server --requirepass \"$$REDIS_PASSWORD\" --appendonly yes']\n    volumes:\n      - redis-data:/data\n    healthcheck:\n      test: [CMD-SHELL, 'redis-cli -a \"$$REDIS_PASSWORD\" ping | grep -q PONG']\n      interval: 10s\n      timeout: 5s\n      retries: 5\nvolumes:\n  redis-data: {}\n",
          "profiles": [],
          "services": [
            "redis"
          ],
          "primaryService": "redis"
        },
        "variables": [
          {
            "key": "REDIS_PASSWORD",
            "label": "Redis password",
            "required": true,
            "valueKind": "string",
            "secret": true,
            "sites": [
              {
                "service": "redis",
                "path": [
                  "environment",
                  "REDIS_PASSWORD"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [
          {
            "key": "REDIS_PASSWORD",
            "purpose": "cache-password",
            "label": "Redis password",
            "profile": {
              "kind": "base64url-32-bytes"
            }
          }
        ],
        "domains": [],
        "volumes": [
          {
            "id": "redis-data",
            "service": "redis",
            "target": "/data",
            "persistent": true,
            "backup": false
          }
        ],
        "health": [
          {
            "service": "redis",
            "participates": true
          }
        ],
        "data": {
          "engine": "redis",
          "version": "7",
          "service": "redis",
          "port": 6379,
          "variables": {
            "password": "REDIS_PASSWORD"
          }
        },
        "exports": {
          "REDIS_URL": {
            "service": "redis",
            "port": 6379,
            "scheme": "redis",
            "defaultExposure": "internal",
            "env": {
              "REDIS_URL": "redis://:${REDIS_PASSWORD}@redis:6379"
            }
          }
        },
        "loginFields": {
          "password": "REDIS_PASSWORD"
        }
      }
    },
    {
      "itemId": "pgweb",
      "app": {
        "schemaVersion": 1,
        "title": "pgweb",
        "description": "Browse PostgreSQL through a private console. Connect a database and add a private route before opening it. Console queries use the connected database account\u2019s permissions.",
        "category": "database",
        "documentationUrl": "https://github.com/sosedoff/pgweb/tree/v0.16.2",
        "compose": {
          "document": "services:\n  pgweb:\n    image: sosedoff/pgweb:0.16.2\n    environment:\n      PGWEB_DATABASE_URL: ${CONSOLE_DATABASE_URL}\n    restart: unless-stopped\n    healthcheck:\n      test: [CMD, curl, --fail, --silent, http://127.0.0.1:8081/]\n",
          "profiles": [],
          "services": [
            "pgweb"
          ],
          "primaryService": "pgweb"
        },
        "variables": [
          {
            "key": "CONSOLE_DATABASE_URL",
            "label": "PostgreSQL connection",
            "help": "Choose the Saved Secret containing the connection URL for this console. The connected database account determines what the console can change.",
            "required": true,
            "valueKind": "string",
            "secret": true,
            "sites": [
              {
                "service": "pgweb",
                "path": [
                  "environment",
                  "PGWEB_DATABASE_URL"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [],
        "domains": [],
        "volumes": [],
        "health": [
          {
            "service": "pgweb",
            "participates": true
          }
        ],
        "exports": {
          "PGWEB_CONSOLE": {
            "service": "pgweb",
            "port": 8081,
            "scheme": "http",
            "defaultExposure": "privateNetwork"
          }
        }
      }
    },
    {
      "itemId": "adminer",
      "app": {
        "schemaVersion": 1,
        "title": "Adminer",
        "description": "Manage PostgreSQL or MySQL through a private console. Add a private route, then sign in with the database account you want to use.",
        "category": "database",
        "documentationUrl": "https://hub.docker.com/_/adminer/",
        "compose": {
          "document": "services:\n  adminer:\n    image: adminer:5.5.1-standalone\n    environment:\n      ADMINER_DEFAULT_SERVER: ${CONSOLE_DATABASE_HOST}\n    restart: unless-stopped\n    healthcheck:\n      test: [CMD, php, -r, \"exit(@file_get_contents('http://127.0.0.1:8080/') === false ? 1 : 0);\"]\n",
          "profiles": [],
          "services": [
            "adminer"
          ],
          "primaryService": "adminer"
        },
        "variables": [
          {
            "key": "CONSOLE_DATABASE_HOST",
            "label": "Database host",
            "help": "Use the database service name in this Environment, or select its host export. Sign in to Adminer with your chosen database account.",
            "required": true,
            "valueKind": "string",
            "secret": false,
            "sites": [
              {
                "service": "adminer",
                "path": [
                  "environment",
                  "ADMINER_DEFAULT_SERVER"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [],
        "domains": [],
        "volumes": [],
        "health": [
          {
            "service": "adminer",
            "participates": true
          }
        ],
        "exports": {
          "ADMINER_CONSOLE": {
            "service": "adminer",
            "port": 8080,
            "scheme": "http",
            "defaultExposure": "privateNetwork"
          }
        }
      }
    },
    {
