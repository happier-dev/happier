    {
      "itemId": "mongodb",
      "app": {
        "schemaVersion": 1,
        "title": "MongoDB",
        "description": "A MongoDB database with a generated administrator login and internal connectivity. Backups and restore are not supported in Happier yet.",
        "category": "database",
        "documentationUrl": "https://www.mongodb.com/docs/v8.0/",
        "compose": {
          "document": "{\"services\":{\"mongodb\":{\"image\":\"mongo:8.0\",\"environment\":{\"MONGO_INITDB_ROOT_USERNAME\":\"${MONGO_USER}\",\"MONGO_INITDB_ROOT_PASSWORD\":\"${MONGO_PASSWORD}\",\"MONGO_INITDB_DATABASE\":\"${MONGO_DATABASE}\"},\"volumes\":[\"mongodb-data:/data/db\",\"mongodb-config:/data/configdb\"],\"healthcheck\":{\"test\":[\"CMD\",\"mongosh\",\"--quiet\",\"--eval\",\"quit(db.adminCommand({ ping: 1 }).ok ? 0 : 1)\"],\"interval\":\"10s\",\"timeout\":\"5s\",\"retries\":5}}},\"volumes\":{\"mongodb-data\":{},\"mongodb-config\":{}}}",
