            "sites": [
              {
                "service": "mongodb",
                "path": [
                  "environment",
                  "MONGO_INITDB_DATABASE"
                ]
              }
            ]
          },
          {
            "key": "MONGO_PASSWORD",
            "label": "Administrator password",
            "required": true,
            "valueKind": "string",
            "secret": true,
            "sites": [
              {
                "service": "mongodb",
                "path": [
                  "environment",
                  "MONGO_INITDB_ROOT_PASSWORD"
                ]
              }
            ]
          }
        ],
        "generatedSecrets": [
          {
            "key": "MONGO_PASSWORD",
            "purpose": "database-password",
            "label": "Administrator password",
            "profile": {
              "kind": "base64url-32-bytes"
            }
          }
        ],
        "domains": [],
        "volumes": [
          {
            "id": "mongodb-data",
            "service": "mongodb",
            "target": "/data/db",
            "persistent": true,
            "backup": false
          },
          {
            "id": "mongodb-config",
            "service": "mongodb",
            "target": "/data/configdb",
            "persistent": true,
            "backup": false
          }
        ],
        "health": [
          {
            "service": "mongodb",
            "participates": true
          }
        ],
        "data": {
          "engine": "mongo",
          "version": "8.0",
          "service": "mongodb",
          "port": 27017,
          "variables": {
            "username": "MONGO_USER",
            "password": "MONGO_PASSWORD",
            "database": "MONGO_DATABASE"
          }
        },
        "exports": {
          "DATABASE_URL": {
            "service": "mongodb",
            "port": 27017,
            "scheme": "mongodb",
            "defaultExposure": "internal",
            "env": {
              "DATABASE_URL": "mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongodb:27017/${MONGO_DATABASE}?authSource=admin"
            }
          }
        },
        "loginFields": {
          "username": "MONGO_USER",
          "password": "MONGO_PASSWORD"
        }
      }
    }
  ]
}
