            "valueKind": "string",
            "secret": false,
            "default": "happier",
            "sites": [
              {
                "service": "mongodb",
                "path": [
                  "environment",
                  "MONGO_INITDB_ROOT_USERNAME"
                ]
              }
            ]
          },
          {
            "key": "MONGO_DATABASE",
            "label": "Database name",
            "required": true,
            "valueKind": "string",
            "secret": false,
