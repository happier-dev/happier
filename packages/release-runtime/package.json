{
  "name": "@happier-dev/release-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./minisign": {
      "happier-source": "./src/minisign.ts",
      "types": "./dist/minisign.d.ts",
      "default": "./dist/minisign.js"
    },
    "./checksums": {
      "happier-source": "./src/checksums.ts",
      "types": "./dist/checksums.d.ts",
      "default": "./dist/checksums.js"
    },
    "./releaseArtifactVerification": {
      "happier-source": "./src/releaseArtifactVerification.ts",
      "types": "./dist/releaseArtifactVerification.d.ts",
      "default": "./dist/releaseArtifactVerification.js"
    },
    "./assets": {
      "happier-source": "./src/assets.ts",
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./archiveExtraction": {
      "happier-source": "./src/archiveExtraction.ts",
      "types": "./dist/archiveExtraction.d.ts",
      "default": "./dist/archiveExtraction.js"
    },
    "./archiveSymlinkContainment": {
      "happier-source": "./src/archiveSymlinkContainment.ts",
      "types": "./dist/archiveSymlinkContainment.d.ts",
      "default": "./dist/archiveSymlinkContainment.js"
    },
    "./verifiedDownload": {
      "happier-source": "./src/verifiedDownload.ts",
      "types": "./dist/verifiedDownload.d.ts",
      "default": "./dist/verifiedDownload.js"
    },
    "./github": {
      "happier-source": "./src/github.ts",
      "types": "./dist/github.d.ts",
      "default": "./dist/github.js"
    },
    "./releaseRings": {
      "happier-source": "./src/releaseRings.ts",
      "types": "./dist/releaseRings.d.ts",
      "import": "./dist/releaseRings.js",
      "require": "./releaseRings.cjs",
      "default": "./dist/releaseRings.js"
    },
    "./releaseProducts": {
      "happier-source": "./src/releaseProducts.ts",
      "types": "./dist/releaseProducts.d.ts",
      "default": "./dist/releaseProducts.js"
    },
    "./releaseManifest": {
      "happier-source": "./src/releaseManifest.ts",
      "types": "./dist/releaseManifest.d.ts",
      "default": "./dist/releaseManifest.js"
    }
  },
  "files": [
    "dist",
    "releaseRings.cjs",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build:esm": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build": "yarn -s build:esm",
    "build:finite": "yarn -s build:esm",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "yarn -s build && HAPPIER_FEATURE_POLICY_ENV= node --test \"tests/*.test.mjs\"",
    "postinstall:real": "yarn -s build",
    "postinstall": "node -e \"const fs=require('fs');const cp=require('child_process');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'release-runtime',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('tsconfig.json'))process.exit(0);const run=(cmd,args)=>cp.spawnSync(cmd,args,{stdio:'inherit'});const npmExec=process.env.npm_execpath;let r;if(npmExec){r=run(process.execPath,[npmExec,'run','-s','postinstall:real']);}else{r=run(process.platform==='win32'?'yarn.cmd':'yarn',['-s','postinstall:real']);if(r.error&&process.platform==='win32'){r=run('yarn',['-s','postinstall:real']);}}if(r.error){console.error(r.error.message);process.exit(1);}process.exit(r.status??1);\""
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "base64-js": "^1.5.1",
    "tar": "7.5.22",
    "xz-decompress": "^0.2.3",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/yauzl": "^2.9.1",
    "typescript": "^5.9.2"
  }
}
