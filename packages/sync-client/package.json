{
  "name": "@happier-dev/sync-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@happier-dev/connection-supervisor": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "socket.io": "^4.8.1",
    "vitest": "^3.2.4"
  }
}
