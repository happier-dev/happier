{
  "name": "@happier-dev/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "default": "./dist/permissions/index.js"
    },
    "./process/shellCommand": {
      "types": "./dist/process/shellCommand.d.ts",
      "default": "./dist/process/shellCommand.js"
    },
    "./providers/claude-model-options": {
      "types": "./dist/providers/claudeModelOptions.d.ts",
      "default": "./dist/providers/claudeModelOptions.js"
    },
    "./session/controls/checkpoints": {
      "types": "./dist/session/controls/checkpoints.d.ts",
      "default": "./dist/session/controls/checkpoints.js"
    },
    "./session/state/metadataWriters": {
      "types": "./dist/session/state/metadataWriters.d.ts",
      "default": "./dist/session/state/metadataWriters.js"
    },
    "./runtime/session/preAdmissionBuffer": {
      "types": "./dist/runtime/session/preAdmissionBuffer.d.ts",
      "default": "./dist/runtime/session/preAdmissionBuffer.js"
    },
    "./permissions/privilege": {
      "types": "./dist/permissions/privilege.d.ts",
      "default": "./dist/permissions/privilege.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "postinstall:real": "yarn -s build",
    "postinstall": "node -e \"const fs=require('fs');const cp=require('child_process');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'agents',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('tsconfig.json'))process.exit(0);const run=(cmd,args)=>cp.spawnSync(cmd,args,{stdio:'inherit'});const npmExec=process.env.npm_execpath;let r;if(npmExec){r=run(process.execPath,[npmExec,'run','-s','postinstall:real']);}else{r=run(process.platform==='win32'?'yarn.cmd':'yarn',['-s','postinstall:real']);if(r.error&&process.platform==='win32'){r=run('yarn',['-s','postinstall:real']);}}if(r.error){console.error(r.error.message);process.exit(1);}process.exit(r.status??1);\"",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/protocol": "0.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
