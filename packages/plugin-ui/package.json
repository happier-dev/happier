{
  "name": "@happier-dev/plugin-ui",
  "version": "0.0.0",
  "description": "React and React Native components and hooks for Happier plugin authors.",
  "private": true,
  "license": "MIT",
  "repository": "happier-dev/happier",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./ansi": {
      "happier-source": "./src/ansi.ts",
      "types": "./dist/ansi.d.ts",
      "default": "./dist/ansi.js"
    },
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "happier-source": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./hostApi": {
      "happier-source": "./src/hostApi/index.ts",
      "types": "./dist/hostApi/index.d.ts",
      "default": "./dist/hostApi/index.js"
    },
    "./data": {
      "happier-source": "./src/data/index.ts",
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./presentation": {
      "happier-source": "./src/presentation/index.ts",
      "types": "./dist/presentation/index.d.ts",
      "default": "./dist/presentation/index.js"
    },
    "./presentation/formatBytes": {
      "happier-source": "./src/presentation/data/formatBytes.ts",
      "types": "./dist/presentation/data/formatBytes.d.ts",
      "default": "./dist/presentation/data/formatBytes.js"
    },
    "./presentation/typeScale": {
      "happier-source": "./src/presentation/text/typeScale.ts",
      "types": "./dist/presentation/text/typeScale.d.ts",
      "default": "./dist/presentation/text/typeScale.js"
    },
    "./presentation/pageMetrics": {
      "happier-source": "./src/presentation/layout/pageMetrics.ts",
      "types": "./dist/presentation/layout/pageMetrics.d.ts",
      "default": "./dist/presentation/layout/pageMetrics.js"
    },
    "./declarative": {
      "happier-source": "./src/declarative/index.ts",
      "types": "./dist/declarative/index.d.ts",
      "default": "./dist/declarative/index.js"
    },
    "./environment": {
      "happier-source": "./src/environment/index.ts",
      "types": "./dist/environment/index.d.ts",
      "default": "./dist/environment/index.js"
    },
    "./advanced": {
      "happier-source": "./src/advanced/index.ts",
      "types": "./dist/advanced/index.d.ts",
      "default": "./dist/advanced/index.js"
    },
    "./testing": {
      "happier-source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "API.md",
    "api-surface.json",
    "api-declarations.md"
  ],
  "happier": {
    "publicSdkRelease": {
      "posture": "developer_preview",
      "supportPolicy": "README.md#plugin-ui-release-posture",
      "externalPublicationRequiresApproval": true
    }
  },
  "scripts": {
    "prepare:declarations": "pnpm --dir ../plugin-sdk --silent run prepare:declarations",
    "prepare:api-governance": "pnpm --silent run prepare:declarations && pnpm --dir ../plugin-sdk --silent run check:public-toolchain:prepared && pnpm --silent run build:compiled",
    "api-governance": "pnpm --silent run prepare:api-governance && pnpm --silent run api-governance:emit",
    "api-governance:emit": "node --max-old-space-size=6144 ../../scripts/api-governance/cli.mjs --profile plugin-ui --write",
    "check:api-governance": "pnpm --silent run prepare:api-governance && node --max-old-space-size=6144 ../../scripts/api-governance/cli.mjs --profile plugin-ui --check",
    "check:api-governance:prepared": "node --max-old-space-size=6144 ../../scripts/api-governance/cli.mjs --profile plugin-ui --check",
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "prepack": "pnpm --dir ../plugin-sdk --silent run check:action-type-map && pnpm --dir ../plugin-sdk --silent run check:public-toolchain && pnpm --silent run prepare:api-governance && node --max-old-space-size=6144 ../../scripts/api-governance/cli.mjs --profile plugin-ui --write && pnpm --silent run check:api-governance:prepared",
    "build:finite": "pnpm --silent run build:compiled",
    "api:finite": "pnpm --dir ../plugin-sdk --silent run check:public-toolchain:prepared && pnpm --silent run check:api-governance:prepared",
    "build:compiled": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build": "pnpm --silent run build:compiled",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config ./vitest.config.ts && pnpm --silent run test:external-authoring",
    "test:finite": "pnpm --silent run test:local",
    "test:external-authoring": "node --test ./scripts/validateExternalAuthoringFixture.test.mjs",
    "test:external-authoring:current-source": "pnpm --dir ../plugin-sdk --silent run build:finite && pnpm --silent run build:finite && node ./scripts/validateExternalAuthoringFixture.mjs --mode current-source",
    "test:external-authoring:tarballs": "node ./scripts/validateExternalAuthoringFixture.mjs",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "typecheck:source:finite": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit --tsBuildInfoFile node_modules/.cache/tsc/plugin-ui.typecheck.tsbuildinfo -p tsconfig.json",
    "api-declarations": "pnpm --silent run api-governance",
    "check:api-declarations": "pnpm --silent run check:api-governance"
  },
  "bundledDependencies": [
    "@happier-dev/protocol"
  ],
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/protocol": "0.0.0"
  },
  "peerDependencies": {
    "react": "19.2.0",
    "react-dom": ">=19.2.0",
    "react-native": ">=0.79.0",
    "react-native-svg": "15.15.3"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-test-renderer": "^19.1.0",
    "react": "19.2.0",
    "react-native": "0.83.5",
    "react-native-svg": "15.15.3",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
