{
  "name": "@happier-dev/plugin-ui",
  "version": "0.0.0",
  "description": "React and React Native components and hooks for Happier plugin authors.",
  "private": true,
  "license": "MIT",
  "repository": "happier-dev/happier",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./hostApi": {
      "types": "./dist/hostApi/index.d.ts",
      "default": "./dist/hostApi/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "default": "./dist/presentation/index.js"
    },
    "./environment": {
      "types": "./dist/environment/index.d.ts",
      "default": "./dist/environment/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced/index.d.ts",
      "default": "./dist/advanced/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "API.md",
    "api-surface.json",
    "api-declarations.md"
  ],
  "happier": {
    "publicSdkRelease": {
      "posture": "prepublish_hold",
      "supportPolicy": "README.md#plugin-ui-release-posture",
      "externalPublicationRequiresApproval": true
    }
  },
  "scripts": {
    "prepare:declarations": "yarn --cwd ../plugin-sdk -s prepare:declarations",
    "prepare:api-governance": "yarn -s prepare:declarations && yarn -s build",
    "api-governance": "yarn -s prepare:api-governance && node ../../scripts/api-governance/cli.mjs --profile plugin-ui --write",
    "check:api-governance": "yarn -s prepare:api-governance && node ../../scripts/api-governance/cli.mjs --profile plugin-ui --check",
    "check:api-governance:prepared": "node ../../scripts/api-governance/cli.mjs --profile plugin-ui --check",
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "prebuild": "yarn --cwd ../plugin-sdk -s check:public-toolchain",
    "pretypecheck": "yarn --cwd ../plugin-sdk -s check:public-toolchain",
    "prepack": "yarn -s prepare:api-governance && yarn -s check:api-governance:prepared",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config ./vitest.config.ts && yarn -s test:external-authoring",
    "test:external-authoring": "node --test ./scripts/validateExternalAuthoringFixture.test.mjs",
    "test:external-authoring:tarballs": "node ./scripts/validateExternalAuthoringFixture.mjs",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../plugin-sdk/scripts/generatePublicToolchainCompatibility.mjs --check && node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "api-declarations": "yarn -s api-governance",
    "check:api-declarations": "yarn -s check:api-governance"
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "peerDependencies": {
    "react": "19.2.0",
    "react-dom": ">=19.2.0",
    "react-native": ">=0.79.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.1.7",
    "@types/react-test-renderer": "^19.1.0",
    "react": "19.2.0",
    "react-native": "0.83.5",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
