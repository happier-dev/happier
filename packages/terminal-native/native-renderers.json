  "androidTermux": {
    "renderer": "android-termux",
    "integration": "expo-module-termux-emulator-renderer-remote-session",
    "upstream": {
      "name": "termux-app terminal libraries",
      "url": "https://github.com/termux/termux-app",
      "observedCommit": "401bbe54b8f4e68302b1ff70678015a24628fb1d",
      "sourceArchive": {
        "url": "https://github.com/termux/termux-app/archive/401bbe54b8f4e68302b1ff70678015a24628fb1d.tar.gz",
        "sha256": "fa9000bc04faebb57de2c3e7b4264b1531f7898b47f08675730007bbfbaab6f6",
        "commit": "401bbe54b8f4e68302b1ff70678015a24628fb1d"
      },
      "pinRequired": true,
      "modules": [
        {
          "name": "terminal-view",
          "path": "terminal-view",
          "license": "Apache-2.0"
        },
        {
          "name": "terminal-emulator",
          "path": "terminal-emulator",
          "license": "Apache-2.0"
        }
      ]
    },
    "forbiddenModules": [
      {
        "name": "app",
        "reason": "The full Termux app is GPL-3.0-only and is out of scope for the native renderer package."
      },
      {
        "name": "termux-shared",
        "reason": "TERM-6 only approves terminal-view and terminal-emulator until dependency closure review says otherwise."
      }
    ],
    "remoteSessionAdapter": {
      "required": true,
      "reason": "Termux TerminalSession/TerminalView are process-backed; Happier adapts TerminalEmulator and TerminalRenderer to the remote daemon byte stream without spawning a local Android shell."
    },
    "interactionModel": {
      "kind": "happier-owned-remote-session-adapter",
      "uses": [
        "TerminalEmulator",
        "TerminalRenderer"
      ],
      "doesNotEmbed": "process-backed Termux TerminalView widget",
    "implementedInAdapter": [
      "ime-commit-text",
      "hardware-key-escape-mapping",
      "mouse-tracking-and-scrollback",
      "safe-http-link-tap-routing"
    ],
      "remainingGaps": [
        "selection-handles",
        "custom-accessibility",
        "crash-fallback-device-proof",
        "interaction-device-qa"
      ],
      "requiresDeviceQa": [
        "ime-keyboard-and-mouse-smoke",
        "selection-copy-smoke",
        "fallback-crash-smoke"
      ]
    },
    "sourceStrategy": {
      "kind": "ignored-source-extract",
      "vendorRoot": "android/termux/vendor",
      "metadataFile": "android/termux/vendor/TERMUX-SOURCE.json",
      "fetchScript": "scripts/fetchTermuxAndroid.mjs",
      "gradleConsumesWhenPresent": true
    },
    "license": {
      "kind": "Apache-2.0",
      "scope": "terminal-view-and-terminal-emulator-exception-only",
      "fullTermuxAppLicense": "GPL-3.0-only",
      "bundleFullTermuxApp": false,
      "noticeRequired": true
    },
    "gates": [
      "pinned-upstream-revision",
      "dependency-closure-review",
      "legal-product-approval",
      "license-notice-review",
      "aar-gradle-build-proof",
      "binary-size-budget",
      "abi-smoke-test",
      "crash-to-webview-fallback",
