{
  "name": "@happier-dev/example-react-native-installed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Installed React Native Happier plugin example.",
  "happier": {
    "manifest": ".happier-plugin/plugin.json"
  },
  "keywords": [
    "happier-plugin"
  ],
  "files": [
    "dist",
    ".happier-plugin"
  ],
  "scripts": {
    "build": "happier plugins dev build .",
    "build:ui": "happier-plugin-build-ui --project-root .",
    "typecheck": "happier plugins dev typecheck .",
    "test": "happier plugins test .",
    "pack:plugin": "happier plugins pack ."
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.5",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@callstack/repack": "5.2.5",
    "@react-native-community/cli": "20.1.2",
    "@rspack/core": "2.1.3",
    "@swc/helpers": "0.5.23",
    "@types/node": "25.0.10",
    "@types/react": "19.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.1",
    "typescript": "5.9.3"
  }
}
