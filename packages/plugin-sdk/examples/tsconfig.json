{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@happier-dev/plugin-sdk": ["./../src/index.ts"],
      "@happier-dev/plugin-sdk/*": ["./../src/*"]
    }
  },
  "include": ["**/*.ts"]
}
