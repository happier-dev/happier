{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react"
  },
  "include": ["*.ts", "ui/**/*.ts", "ui/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
