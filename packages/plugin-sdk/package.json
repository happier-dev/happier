  "scripts": {
    "prepare:api-governance": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=prepare:api-governance:prepared",
    "prepare:api-governance:prepared": "yarn -s prepare:declarations:prepared && node ./scripts/apiSurfaceCli.mjs --materialize-source --write && yarn -s build:compiled",
    "api-governance": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=api-governance:prepared",
    "api-governance:prepared": "yarn -s prepare:api-governance:prepared && yarn -s api-governance:emit",
    "api-governance:emit": "node ../../scripts/api-governance/cli.mjs --profile plugin-sdk --write",
    "check:prepare:api-governance": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=check:prepare:api-governance:prepared",
    "check:prepare:api-governance:prepared": "yarn -s prepare:declarations:prepared && node ./scripts/apiSurfaceCli.mjs --materialize-source --check && yarn -s build:compiled",
    "check:api-governance": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=check:api-governance:locked",
    "check:api-governance:locked": "yarn -s check:prepare:api-governance:prepared && node ../../scripts/api-governance/cli.mjs --profile plugin-sdk --check",
    "check:api-governance:prepared": "node ../../scripts/api-governance/cli.mjs --profile plugin-sdk --check --source-prepared",
    "api-surface": "yarn -s api-governance",
    "check:api-surface": "yarn -s check:api-governance",
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "generate:action-type-map": "node ./scripts/generateActionTypeMap.mjs --write",
    "check:action-type-map": "node ./scripts/generateActionTypeMap.mjs --check",
    "prepare:declarations": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=prepare:declarations:prepared",
    "prepare:declarations:prepared": "yarn -s check:action-type-map",
    "generate:public-toolchain": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=generate:public-toolchain:prepared",
    "generate:public-toolchain:prepared": "node ./scripts/generatePublicToolchainCompatibility.mjs --write",
    "check:public-toolchain": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=check:public-toolchain:prepared",
    "check:public-toolchain:prepared": "node ./scripts/generatePublicToolchainCompatibility.mjs --check",
    "check:public-toolchain:generated": "node ./scripts/generatePublicToolchainCompatibility.mjs --check-generated",
    "prepack": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=prepack:prepared",
    "prepack:prepared": "yarn -s prepare:declarations:prepared && node ./scripts/bundleWorkspaceDeps.mjs --artifact && node ./scripts/apiSurfaceCli.mjs --materialize-source --write && yarn -s build:compiled && node ../../scripts/api-governance/cli.mjs --profile plugin-sdk --write && yarn -s check:api-governance:prepared && yarn -s check:public-toolchain:generated",
    "generated:finite": "yarn -s check:action-type-map",
    "prepare:finite": "node ./scripts/bundleWorkspaceDeps.mjs --declarations",
    "build:finite": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=build:finite:prepared",
    "build:finite:prepared": "yarn -s build:compiled",
    "api:finite": "node ./scripts/bundleWorkspaceDeps.mjs --declarations --run-script=api:finite:prepared",
    "api:finite:prepared": "node ../../scripts/api-governance/cli.mjs --profile plugin-sdk --check",
    "build:compiled": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
