  "files": [
    "dist",
    "examples",
    "scripts",
    "package.json",
    "README.md"
  ],
  "happier": {
    "publicSdkRelease": {
      "posture": "prepublish_hold",
      "supportPolicy": "README.md#public-sdk-release-posture",
      "canonicalAuthoringDocs": "../../apps/docs/content/docs/plugins/quickstart.mdx",
      "exampleFixtures": "../../apps/cli/src/plugins/testkit/fixtures/authoring-examples",
      "publicExamples": "examples/public-authoring",
      "externalPublicationRequiresApproval": true
    }
  },
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "prepare:declarations": "node ./scripts/bundleWorkspaceDeps.mjs --declarations",
    "prebuild": "yarn -s prepare:declarations",
    "prepack": "yarn -s build && node ./scripts/bundleWorkspaceDeps.mjs --artifact",
    "pretest": "yarn -s prepare:declarations",
    "pretypecheck": "yarn -s prepare:declarations",
    "pretypecheck:source": "yarn -s prepare:declarations",
    "pretypecheck:tests": "yarn -s prepare:declarations",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "postinstall:real": "yarn -s build",
    "postinstall": "node -e \"const fs=require('fs');const cp=require('child_process');if(/(^|[\\\\/])node_modules([\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'plugin-sdk',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('tsconfig.json'))process.exit(0);const run=(cmd,args)=>cp.spawnSync(cmd,args,{stdio:'inherit'});const npmExec=process.env.npm_execpath;let r;if(npmExec){r=run(process.execPath,[npmExec,'run','-s','postinstall:real']);}else{r=run(process.platform==='win32'?'yarn.cmd':'yarn',['-s','postinstall:real']);if(r.error&&process.platform==='win32'){r=run('yarn',['-s','postinstall:real']);}}if(r.error){console.error(r.error.message);process.exit(1);}process.exit(r.status??1);\"",
    "test": "vitest run --exclude scripts/**/*.test.mjs && node --test scripts/bundleWorkspaceDeps.test.mjs",
    "typecheck": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json && node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json",
    "typecheck:source": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "typecheck:tests": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@callstack/repack": "5.2.5",
    "@react-native-community/cli": "20.1.2",
    "@react-native-community/cli-platform-android": "20.1.2",
    "@react-native-community/cli-platform-ios": "20.1.2",
    "@rspack/core": "2.1.3",
    "@types/react": "19.2.0",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-web": "0.21.2",
    "typescript": "^5.9.2",
    "vite": "7.3.1",
    "vitest": "^3.2.4"
  },
  "bundledDependencies": [
    "@happier-dev/agents",
    "@happier-dev/protocol"
  ],
