{
  "name": "@happier-dev/iroh-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "happier-source": "./src/nodeNative.ts",
      "types": "./dist/nodeNative.d.ts",
      "import": "./dist/nodeNative.js",
      "default": "./dist/nodeNative.js"
    },
    "./test-controller": {
      "happier-source": "./src/testController.ts",
      "types": "./dist/testController.d.ts",
      "import": "./dist/testController.js",
      "default": "./dist/testController.js"
    }
  },
  "files": [
    "dist",
    "native",
    "ios/HappierIrohNativeModule.swift",
    "ios/HappierIrohNative.podspec",
    "android/build.gradle",
    "android/src",
    "rust-toolchain.toml",
    "rust/Cargo.toml",
    "rust/Cargo.lock",
    "rust/happier-iroh-core",
    "rust/happier-iroh-native",
    "rust/happier-iroh-node",
    "scripts",
    "expo-module.config.json",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:native": "node scripts/build-node-addon.mjs",
    "build:native:test-relay": "node scripts/build-node-addon.mjs --test-relay-fixture",
    "generate:release-evidence": "node scripts/generate-native-release-evidence.mjs --package-root . --output-dir release-evidence",
    "test:home-iroh:real": "../../apps/stack/bin/hstack-exec --script=test:home-iroh:real:local",
    "test:home-iroh:real:local": "node scripts/run-home-iroh-real-integration.mjs",
    "test:home-iroh:docker": "../../apps/stack/bin/hstack-exec --script=test:home-iroh:docker:local",
    "test:home-iroh:docker:local": "node scripts/run-home-iroh-docker.mjs",
    "verify:native": "node scripts/verify-node-addon-load.mjs",
    "verify:native:lifecycle": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts src/nodeNativeLifecycle.test.ts",
    "verify:native:windows": "cargo test --locked --manifest-path rust/Cargo.toml -p happier-iroh-core windows_key_ && cargo test --locked --manifest-path rust/Cargo.toml -p happier-iroh-core stopping_acceptor_joins_an_active",
    "verify:browser-iroh-wasm": "../../apps/stack/bin/hstack-exec --script=verify:browser-iroh-wasm:local",
    "verify:browser-iroh-wasm:local": "node scripts/verify-browser-iroh-wasm.mjs",
    "test:browser-iroh:live": "../../apps/stack/bin/hstack-exec --script=test:browser-iroh:live:local",
    "test:browser-iroh:live:local": "node scripts/run-browser-iroh-live.mjs",
    "verify:iroh-lock-parity": "node scripts/verify-iroh-lock-parity.mjs",
    "test:rust": "../../apps/stack/bin/hstack-exec --script=test:rust:local",
    "test:rust:local": "cargo test --locked --manifest-path rust/Cargo.toml --workspace --all-targets && cargo test --locked --manifest-path rust/Cargo.toml -p happier-iroh-core --all-targets --features test-relay-fixture && node scripts/verify-browser-iroh-wasm.mjs",
    "verify:native:bun": "bun scripts/verify-node-addon-load.mjs",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts src && node --test scripts/ensure-rust-toolchain.test.mjs scripts/generate-native-release-evidence.test.mjs scripts/native-release-evidence-platform-packaging.contract.test.mjs scripts/run-home-iroh-docker.test.mjs scripts/run-home-iroh-real-integration.test.mjs scripts/verify-browser-iroh-wasm.test.mjs",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@happier-dev/protocol": "0.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "expo-modules-core": "55.0.20"
  },
  "peerDependencies": {
    "expo": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
