{
  "name": "@happier-dev/databases",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgresql": {
      "happier-source": "./src/postgresql/index.ts",
      "types": "./dist/postgresql/index.d.ts",
      "default": "./dist/postgresql/index.js"
    },
    "./mysql": {
      "happier-source": "./src/mysql/index.ts",
      "types": "./dist/mysql/index.d.ts",
      "default": "./dist/mysql/index.js"
    },
    "./sqlite": {
      "happier-source": "./src/sqlite/index.ts",
      "types": "./dist/sqlite/index.d.ts",
      "default": "./dist/sqlite/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@happier-dev/database-protocol": "0.0.0",
    "@happier-dev/protocol": "0.0.0"
  }
}
