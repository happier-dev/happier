{
  "name": "@happier-dev/action-contract-producer-fixture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "happier": {
    "manifest": ".happier-plugin/plugin.json"
  },
  "keywords": [
    "happier-plugin"
  ],
  "description": "Independently packed producer for the public ActionContract composition fixture.",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "happier plugins dev build .",
    "typecheck": "happier plugins dev typecheck .",
    "pack:plugin": "happier plugins pack ."
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
