{
  "name": "@happier-dev/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "sh -c 'yarn -s test:core \"$@\" && if [ \"$#\" -eq 0 ]; then yarn -s test:scripts:self; fi' --",
    "test:core": "node scripts/run-vitest-with-heartbeat.mjs --config vitest.core.config.ts",
    "test:core:fast": "node scripts/run-vitest-with-heartbeat.mjs --config vitest.core.fast.config.ts",
    "test:core:slow": "node scripts/run-vitest-with-heartbeat.mjs --config vitest.core.slow.config.ts $(find suites/core-e2e -name '*.slow.e2e.test.ts' -print | sort)",
    "test:core:handoff": "node scripts/run-vitest-with-heartbeat.mjs --config vitest.core.slow.config.ts $(find suites/core-e2e -name 'session.handoff*.slow.e2e.test.ts' -print | sort)",
    "test:scripts:self": "node --test scripts/runTsxEntrypoint.test.mjs scripts/lima-vm.test.mjs scripts/wsrepl-lima-matrix.test.mjs",
    "test:stress": "node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts",
    "test:stress:full-compose": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts",
    "test:stress:full-compose:reuse": "HAPPIER_STRESS_TARGET_MODE=full-compose HAPPIER_STRESS_COMPOSE_REUSE_RUNNING=1 HAPPIER_STRESS_COMPOSE_IMAGE_BUILD_STRATEGY=never node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts",
    "test:stress:external": "HAPPIER_STRESS_TARGET_MODE=external node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts",
    "test:stress:sticky-affinity": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/stickyAffinity.validation.test.ts",
    "test:stress:cross-replica-failover": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/reconnect.crossReplicaFailover.test.ts",
    "test:stress:redis-interruption": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/redis.interruption.test.ts",
    "test:stress:long-idle-proxy": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/proxy.longIdleTimeout.test.ts",
    "test:stress:duplicate-listener-policy": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/rpc.duplicateListenerPolicy.test.ts",
    "test:stress:presence-worker-crash": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/presence.workerCrashReclaim.test.ts",
    "test:stress:mixed-realistic": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/mixed.realistic.test.ts",
    "test:stress:mixed-connect-ceiling": "HAPPIER_STRESS_TARGET_MODE=full-compose node scripts/run-vitest-with-heartbeat.mjs --config vitest.stress.config.ts suites/stress/mixed.connectCeiling.test.ts",
    "stress:compose:up": "node scripts/runTsxEntrypoint.mjs src/testkit/stress/cli/stressComposeCli.ts up",
    "stress:compose:down": "node scripts/runTsxEntrypoint.mjs src/testkit/stress/cli/stressComposeCli.ts down",
    "stress:compose:status": "node scripts/runTsxEntrypoint.mjs src/testkit/stress/cli/stressComposeCli.ts status",
    "test:providers": "node scripts/run-vitest-with-heartbeat.mjs --config vitest.providers.config.ts",
    "test:ui:e2e": "node scripts/run-playwright-with-heartbeat.mjs --config playwright.ui.config.mjs",
    "test:desktop:native": "yarn --cwd ../.. -s test:e2e:desktop:native",
    "test:ui:e2e:wsrepl:lima": "node scripts/run-wsrepl-lima-matrix.mjs",
    "test:ui:e2e:wsrepl:lima:self": "node --test scripts/lima-vm.test.mjs scripts/wsrepl-lima-matrix.test.mjs",
    "test:mobile:e2e:android": "node scripts/run-maestro-with-heartbeat.mjs --platform android --flows suites/mobile-e2e/flows/smoke.yaml --appId dev.happier.app.internaldev",
    "test:mobile:e2e:ios": "node scripts/run-maestro-with-heartbeat.mjs --platform ios --flows suites/mobile-e2e/flows/smoke.yaml --appId dev.happier.app.dev.internal",
    "test:mobile:e2e:android:connected-machine": "HAPPIER_E2E_MOBILE_CONNECTED_MACHINE_MODE=cli-terminal-daemon node scripts/run-maestro-with-heartbeat.mjs --platform android --flows suites/mobile-e2e/flows/connectedMachine.smoke.yaml --appId dev.happier.app.internaldev",
    "test:mobile:e2e:ios:connected-machine": "HAPPIER_E2E_MOBILE_CONNECTED_MACHINE_MODE=cli-terminal-daemon node scripts/run-maestro-with-heartbeat.mjs --platform ios --flows suites/mobile-e2e/flows/connectedMachine.smoke.yaml --appId dev.happier.app.dev.internal",
    "test:mobile:e2e:android:connected-machine:transcript": "HAPPIER_E2E_MOBILE_CONNECTED_MACHINE_MODE=cli-terminal-daemon node scripts/run-maestro-with-heartbeat.mjs --platform android --flows suites/mobile-e2e/flows/transcriptScroll.smoke.yaml --appId dev.happier.app.internaldev",
    "test:mobile:e2e:ios:connected-machine:transcript": "HAPPIER_E2E_MOBILE_CONNECTED_MACHINE_MODE=cli-terminal-daemon node scripts/run-maestro-with-heartbeat.mjs --platform ios --flows suites/mobile-e2e/flows/transcriptScroll.smoke.yaml --appId dev.happier.app.dev.internal",
    "test:mobile:e2e:android:validated": "yarn -s test:mobile:e2e:android && yarn -s test:mobile:e2e:android:connected-machine",
    "test:mobile:e2e:ios:validated": "yarn -s test:mobile:e2e:ios && yarn -s test:mobile:e2e:ios:connected-machine",
    "test:mobile:e2e:all": "node scripts/run-maestro-with-heartbeat.mjs --flows suites/mobile-e2e/flows",
    "typecheck": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json",
    "providers:run": "node scripts/run-providers.mjs",
    "providers:run:parallel": "node scripts/run-providers-parallel.mjs",
    "providers:opencode:smoke": "yarn -s providers:run opencode smoke",
    "providers:opencode:extended": "yarn -s providers:run opencode extended",
    "providers:opencode_server:smoke": "yarn -s providers:run opencode_server smoke",
    "providers:opencode_server:extended": "yarn -s providers:run opencode_server extended",
    "providers:claude:smoke": "yarn -s providers:run claude smoke",
    "providers:claude:extended": "yarn -s providers:run claude extended",
    "providers:codex:smoke": "yarn -s providers:run codex smoke",
    "providers:codex:extended": "yarn -s providers:run codex extended",
    "providers:kilo:smoke": "yarn -s providers:run kilo smoke",
    "providers:kilo:extended": "yarn -s providers:run kilo extended",
    "providers:gemini:smoke": "yarn -s providers:run gemini smoke",
    "providers:gemini:extended": "yarn -s providers:run gemini extended",
    "providers:qwen:smoke": "yarn -s providers:run qwen smoke",
    "providers:qwen:extended": "yarn -s providers:run qwen extended",
    "providers:kimi:smoke": "yarn -s providers:run kimi smoke",
    "providers:kimi:extended": "yarn -s providers:run kimi extended",
    "providers:auggie:smoke": "yarn -s providers:run auggie smoke",
    "providers:auggie:extended": "yarn -s providers:run auggie extended",
    "providers:pi:smoke": "yarn -s providers:run pi smoke",
    "providers:pi:extended": "yarn -s providers:run pi extended",
    "providers:all:smoke": "yarn -s providers:run all smoke",
    "providers:all:extended": "yarn -s providers:run all extended",
    "providers:all:smoke:parallel": "yarn -s providers:run:parallel all smoke",
    "providers:all:extended:parallel": "yarn -s providers:run:parallel all extended",
    "providers:token-ledger:summary": "node scripts/provider-token-ledger-summary.mjs",
    "providers:opencode:smoke:update-baselines": "yarn -s providers:run opencode smoke --update-baselines",
    "providers:claude:smoke:update-baselines": "yarn -s providers:run claude smoke --update-baselines",
    "providers:codex:smoke:update-baselines": "yarn -s providers:run codex smoke --update-baselines",
    "providers:kilo:smoke:update-baselines": "yarn -s providers:run kilo smoke --update-baselines",
    "providers:gemini:smoke:update-baselines": "yarn -s providers:run gemini smoke --update-baselines",
    "providers:qwen:smoke:update-baselines": "yarn -s providers:run qwen smoke --update-baselines",
    "providers:kimi:smoke:update-baselines": "yarn -s providers:run kimi smoke --update-baselines",
    "providers:auggie:smoke:update-baselines": "yarn -s providers:run auggie smoke --update-baselines",
    "providers:pi:smoke:update-baselines": "yarn -s providers:run pi smoke --update-baselines"
  },
  "dependencies": {
    "@happier-dev/cli-common": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "privacy-kit": "^0.0.25"
  },
  "exports": {
    "./testkit/tailscale/fakeTailscaleCli": {
      "types": "./src/testkit/tailscale/fakeTailscaleCli.d.ts",
      "default": "./src/testkit/tailscale/fakeTailscaleCli.js"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": ">=20",
    "textarea-caret": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
