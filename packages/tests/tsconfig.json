{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["../../apps/cli/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.d.mts",
    "src/**/*.d.cts",
    "suites/**/*.ts",
    "fixtures/request-settlement-runtime.ts",
    "scripts/**/*.d.ts",
    "scripts/**/*.d.mts",
    "scripts/**/*.d.cts",
    "scripts/network-transfer-report.ts",
    "vitest.*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
