{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tests.typecheck.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "paths": {
      "@/*": ["./../../apps/cli/src/*"],
      "@happier-tests/ui-action-client": ["./../../apps/ui/sources/dev/testkit/actionClientIntegrationTestkit.d.mts"],
      "@happier-tests/ui-terminal-enrollment": ["./../../apps/ui/sources/dev/testkit/terminalEnrollmentIntegrationTestkit.d.mts"],
      "@happier-tests/ui-machine-carrier": ["./../../apps/ui/sources/dev/testkit/machineCarrierHttpIntegrationTestkit.d.mts"],
      "@happier-tests/ui-scm-refine-admission": ["./../../apps/ui/sources/dev/testkit/scmRefineAdmissionIntegrationTestkit.d.mts"],
      "@happier-tests/ui-triage-attachment-lifecycle": ["./../../apps/ui/sources/dev/testkit/triageAttachmentLifecycleTestkit.d.mts"],
      "@happier-tests/server-machine-carrier-grant": ["./../../apps/server/sources/app/api/testkit/machineCarrierGrantIntegrationTestkit.d.mts"],
      // This program reaches CLI source through `@/*`; resolve its public SDK imports
      // through the same current source owner as direct test imports.
      "@happier-dev/plugin-sdk": ["./../plugin-sdk/src/index.public.ts"],
      "@happier-dev/plugin-sdk/*": [
        "./../plugin-sdk/src/*/index.public.ts",
        "./../plugin-sdk/src/*.ts"
      ]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.d.mts",
    "src/**/*.d.cts",
    "suites/**/*.ts",
    "fixtures/request-settlement-runtime.ts",
    "scripts/**/*.d.ts",
    "scripts/**/*.d.mts",
    "scripts/**/*.d.cts",
    "vitest.*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // These composed tests import both UI and CLI source, whose importer-relative `@/*`
    // aliases cannot share one TypeScript program. Their owner projects typecheck the
    // production sources; the composed contract remains covered by its Vitest lane.
    "src/testkit/vitest/settingsRenderer.test.ts",
    "suites/core-e2e/simulatorRelay.productPath.l6LiveQa.slow.e2e.test.ts",
    "suites/core-e2e/plugins.voicePackedInstalledArtifact.e2e.test.ts",
    "suites/core-e2e/voice.agentTranscriptPersistence.e2e.test.ts",
    "suites/core-e2e/accountDirectory.homeEnrollment.composedCaller.slow.e2e.test.ts",
    "suites/core-e2e/accountDirectory.homeEnrollment.destinationBinding.slow.e2e.test.ts",
    "suites/core-e2e/accountService.sameServiceHomeBridge.slow.e2e.test.ts",
    "suites/core-e2e/teamSetup.A.slow.e2e.test.ts",
    "suites/core-e2e/teamSetup.B.slow.e2e.test.ts",
    "suites/core-e2e/teamSetup.D.slow.e2e.test.ts",
    "suites/core-e2e/teamSetup.D.existingClones.slow.e2e.test.ts",
    "suites/core-e2e/teamSetup.D.homeDemand.slow.e2e.test.ts",
    "suites/core-e2e/teamSetup.E.slow.e2e.test.ts",
    "suites/core-e2e/machines.accountArtifact.journey.slow.e2e.test.ts",
    "suites/core-e2e/sessionHost.closedAdmission.journey.slow.e2e.test.ts",
    "suites/core-layer/muse.nativeImport.journey.composed.test.ts",
    "suites/core-layer/databaseWorkbench.brief.F8.composed.test.ts",
    "suites/core-layer/guardApproval.resourceProposal.layer.test.ts",
    "suites/core-layer/teamCredentialModelPicker.test.ts"
  ]
}
