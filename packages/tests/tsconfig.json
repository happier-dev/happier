{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tests.typecheck.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "jsx": "react",
    "paths": {
      "@/*": ["./../../apps/cli/src/*"],
      // This program reaches CLI source through `@/*`; resolve its public SDK imports
      // through the same current source owner as direct test imports.
      "@happier-dev/plugin-sdk": ["./../plugin-sdk/src/index.public.ts"],
      "@happier-dev/plugin-sdk/*": [
        "./../plugin-sdk/src/*/index.public.ts",
        "./../plugin-sdk/src/*.ts"
      ]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.d.mts",
    "src/**/*.d.cts",
    "suites/**/*.ts",
    "scripts/**/*.d.ts",
    "scripts/**/*.d.mts",
    "scripts/**/*.d.cts",
    "vitest.*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // These composed tests import both UI and CLI source, whose importer-relative `@/*`
    // aliases cannot share one TypeScript program. Their owner projects typecheck the
    // production sources; the composed contract remains covered by its Vitest lane.
    "suites/core-e2e/simulatorRelay.productPath.l6LiveQa.slow.e2e.test.ts",
    "suites/core-e2e/plugins.voicePackedInstalledArtifact.e2e.test.ts",
    "suites/core-e2e/voice.agentTranscriptPersistence.e2e.test.ts"
  ]
}
