{
  "name": "@happier-dev/support",
  "version": "0.1.5",
  "description": "Happier support collector and bug-report submitter.",
  "repository": "https://github.com/happier-dev/happier.git",
  "author": "Leeroy Brun <leeroy.brun@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "hsupport": "./bin/hsupport.mjs"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "package.json"
  ],
  "bundledDependencies": [
    "@happier-dev/agents",
    "@happier-dev/cli-common",
    "@happier-dev/protocol",
    "@happier-dev/release-runtime"
  ],
  "dependencies": {
    "@happier-dev/agents": "0.0.0",
    "@happier-dev/cli-common": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "@happier-dev/release-runtime": "0.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "prepack": "yarn -s build && node ./scripts/bundleWorkspaceDeps.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "clean": "node ./scripts/rmDist.mjs",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  }
}
