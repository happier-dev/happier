{
  "name": "@happier-dev/embed",
  "version": "0.0.0",
  "description": "Embed Happier session views in third-party web applications.",
  "private": true,
  "license": "MIT",
  "repository": "happier-dev/happier",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "happier-source": "./src/react/index.tsx",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "API.md",
    "api-surface.json",
    "api-declarations.md"
  ],
  "happier": {
    "publicSdkRelease": {
      "posture": "developer_preview",
      "supportPolicy": "README.md#release-posture",
      "externalPublicationRequiresApproval": true
    }
  },
  "scripts": {
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config ./vitest.config.ts && node --test scripts/*.test.mjs",
    "vitest": "../../apps/stack/bin/hstack-exec --script=vitest:local",
    "vitest:local": "vitest --config ./vitest.config.ts",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json",
    "build": "../../apps/stack/bin/hstack-exec --script=build:local",
    "build:local": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "generate:theme-token-ids": "node scripts/generateThemeTokenIds.mjs --write",
    "check:theme-token-ids": "node scripts/generateThemeTokenIds.mjs --check",
    "prepare:declarations": "node scripts/generateThemeTokenIds.mjs --check",
    "prepare:api-governance": "../../apps/stack/bin/hstack-exec --script=prepare:api-governance:local",
    "prepare:api-governance:local": "node scripts/generateThemeTokenIds.mjs --check && node scripts/bundleWorkspaceDeps.mjs && node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "check:api-governance": "../../apps/stack/bin/hstack-exec --script=check:api-governance:local",
    "check:api-governance:local": "node scripts/generateThemeTokenIds.mjs --check && node scripts/bundleWorkspaceDeps.mjs && node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json && node ../../scripts/api-governance/cli.mjs --profile embed --check",
    "check:api-governance:prepared": "node ../../scripts/api-governance/cli.mjs --profile embed --check",
    "api-governance": "node ../../scripts/api-governance/cli.mjs --profile embed --write",
    "generated:finite": "yarn -s check:theme-token-ids",
    "build:finite": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "api:finite": "yarn -s check:api-governance:prepared",
    "test:finite": "yarn -s test:local",
    "typecheck:finite": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@happier-dev/protocol": "0.0.0"
  },
  "bundledDependencies": [
    "@happier-dev/protocol"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.1.7",
    "jsdom": "^26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vitest": "^3.2.4",
    "typescript": "^5.9.2"
  }
}
