+		}
+		// Concurrent entrypoints can close a longer cycle outside either callstack.
+		// Only pending evaluations can close that cycle.
+		if (mod.exports && mod.promise && !mod.evaluated && importee) {
+			const pending = [this.moduleCache.normalizePath(fsPath)];
+			const seen = new Set();
