+#import "ENRMUIKit.h"
+
+@interface ENRMReferenceAttachment : NSTextAttachment
+@property (nonatomic, copy, readonly) NSString *label;
+- (instancetype)initWithLabel:(NSString *)label presentation:(NSDictionary *)presentation
+                       style:(NSDictionary *)style font:(UIFont *)font;
+@end
+
+/** Readable text and offsets for copy, selection and accessibility (not the attachment character). */
+FOUNDATION_EXPORT NSString *ENRMReferenceText(NSAttributedString *text, NSRange range);
diff --git a/ios/attachments/ENRMReferenceAttachment.m b/ios/attachments/ENRMReferenceAttachment.m
new file mode 100644
index 0000000000000000000000000000000000000000..92ff868c0600287f06b4101c9c70991ff0ff151f
--- /dev/null
+++ b/ios/attachments/ENRMReferenceAttachment.m
@@ -0,0 +1,125 @@
+#import "ENRMReferenceAttachment.h"
+#import "ENRMImageDownloader.h"
+#include <TargetConditionals.h>
+
+NSString *ENRMReferenceText(NSAttributedString *text, NSRange range)
+{
+  NSMutableString *result = [NSMutableString new];
+  [text enumerateAttribute:NSAttachmentAttributeName inRange:range options:0 usingBlock:^(id value, NSRange run, BOOL *stop) {
+    [result appendString:[value isKindOfClass:ENRMReferenceAttachment.class]
+        ? ((ENRMReferenceAttachment *)value).label : [text.string substringWithRange:run]];
+  }];
+  return result;
+}
+
+@implementation ENRMReferenceAttachment {
+  NSDictionary *_presentation;
+  NSDictionary *_anatomy;
+  UIFont *_font;
+  CGFloat _scale;
+  CGFloat _width;
+  CGFloat _height;
+  RCTUIImage *_thumbnail;
+  __weak NSTextContainer *_container;
+}
+
+- (instancetype)initWithLabel:(NSString *)label presentation:(NSDictionary *)presentation
+                       style:(NSDictionary *)style font:(UIFont *)font
+{
+  if ((self = [super init])) {
+    _label = [label copy];
+    _presentation = presentation;
+    _anatomy = style[@"anatomy"];
+    CGFloat fontSize = [style[@"fontSize"] doubleValue];
+    _scale = fontSize > 0 ? font.pointSize / fontSize : 1;
+#if !TARGET_OS_OSX
+    _font = [UIFont fontWithName:style[@"fontFamily"] size:font.pointSize] ?: [UIFont systemFontOfSize:font.pointSize weight:UIFontWeightMedium];
+#else
+    _font = font;
+#endif
+    _height = MAX([_anatomy[@"height"] doubleValue] * _scale, font.lineHeight);
+    CGFloat labelWidth = MIN([_anatomy[@"maxLabelWidth"] doubleValue] * _scale,
+                            ceil([label sizeWithAttributes:@{NSFontAttributeName:_font}].width));
+    _width = labelWidth + ([ _anatomy[@"paddingLeft"] doubleValue] + [_anatomy[@"paddingRight"] doubleValue]
+                            + [_anatomy[@"glyphSize"] doubleValue] + [_anatomy[@"gap"] doubleValue]) * _scale;
+    self.bounds = CGRectMake(0, (font.capHeight - _height) / 2, _width, _height);
+#if !TARGET_OS_OSX
+    [self drawChipWithWidth:_width];
+    NSString *uri = presentation[@"thumbnail"];
+    if (uri.length) {
+      __weak typeof(self) weakSelf = self;
+      [[ENRMImageDownloader shared] downloadURL:uri completion:^(RCTUIImage *image) {
+        ENRMReferenceAttachment *owner = weakSelf;
+        if (!owner || !image) return;
+        owner->_thumbnail = image;
+        [owner drawChipWithWidth:owner.bounds.size.width];
+        NSLayoutManager *layout = owner->_container.layoutManager;
+        [layout.textStorage enumerateAttribute:NSAttachmentAttributeName inRange:NSMakeRange(0, layout.textStorage.length)
+                                       options:0 usingBlock:^(id value, NSRange range, BOOL *stop) {
+          if (value == owner) { [layout invalidateDisplayForCharacterRange:range]; *stop = YES; }
+        }];
+      }];
+    }
+#endif
+  }
+  return self;
+}
+
+- (CGRect)attachmentBoundsForTextContainer:(NSTextContainer *)container proposedLineFragment:(CGRect)line
+                            glyphPosition:(CGPoint)position characterIndex:(NSUInteger)index
+{
+  _container = container;
+  CGFloat width = MIN(_width, line.size.width);
+  return CGRectMake(0, (_font.capHeight - _height) / 2, width, _height);
+}
+
+- (RCTUIImage *)imageForBounds:(CGRect)bounds textContainer:(NSTextContainer *)container characterIndex:(NSUInteger)index
+{
+  _container = container;
+#if !TARGET_OS_OSX
+  if (bounds.size.width != self.bounds.size.width) [self drawChipWithWidth:bounds.size.width];
+#endif
+  self.bounds = bounds;
+  return self.image;
+}
+
+#if !TARGET_OS_OSX
+static UIColor *chipInk(NSNumber *value)
+{
+  uint32_t argb = value.unsignedIntValue;
+  return [UIColor colorWithRed:((argb >> 16) & 255) / 255.0 green:((argb >> 8) & 255) / 255.0
+                         blue:(argb & 255) / 255.0 alpha:((argb >> 24) & 255) / 255.0];
+}
+
+/** The only drawing function for a transcript chip; anatomy and ink arrive from the shared JS owner. */
+- (void)drawChipWithWidth:(CGFloat)width
+{
+  if (width <= 0 || _height <= 0) return;
+  self.image = [[[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(width, _height)] imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
+    CGRect box = CGRectMake(0, 0, width, self->_height);
+    [chipInk(self->_presentation[@"background"]) setFill];
+    [[UIBezierPath bezierPathWithRoundedRect:box cornerRadius:[self->_anatomy[@"radius"] doubleValue] * self->_scale] fill];
+    CGFloat left = [self->_anatomy[@"paddingLeft"] doubleValue] * self->_scale;
+    CGFloat size = [self->_anatomy[@"glyphSize"] doubleValue] * self->_scale;
+    CGRect glyph = CGRectMake(left, (self->_height - size) / 2, size, size);
+    if (self->_thumbnail) {
+      CGContextSaveGState(ctx.CGContext);
+      [[UIBezierPath bezierPathWithRoundedRect:glyph cornerRadius:[self->_anatomy[@"thumbnailRadius"] doubleValue] * self->_scale] addClip];
+      CGFloat cover = MAX(size / self->_thumbnail.size.width, size / self->_thumbnail.size.height);
+      CGSize imageSize = CGSizeMake(self->_thumbnail.size.width * cover, self->_thumbnail.size.height * cover);
+      [self->_thumbnail drawInRect:CGRectMake(CGRectGetMidX(glyph) - imageSize.width / 2, CGRectGetMidY(glyph) - imageSize.height / 2, imageSize.width, imageSize.height)];
+      CGContextRestoreGState(ctx.CGContext);
+    } else {
+      UIImage *symbol = [UIImage systemImageNamed:self->_presentation[@"glyph"]];
+      [[symbol imageWithTintColor:chipInk(self->_presentation[@"glyphInk"]) renderingMode:UIImageRenderingModeAlwaysOriginal] drawInRect:glyph];
+    }
+    CGFloat labelX = CGRectGetMaxX(glyph) + [self->_anatomy[@"gap"] doubleValue] * self->_scale;
+    NSMutableParagraphStyle *paragraph = [NSMutableParagraphStyle new];
+    paragraph.lineBreakMode = NSLineBreakByTruncatingTail;
+    [self.label drawInRect:CGRectMake(labelX, (self->_height - self->_font.lineHeight) / 2,
+                                    MAX(0, width - labelX - [self->_anatomy[@"paddingRight"] doubleValue] * self->_scale), self->_font.lineHeight)
+           withAttributes:@{NSFontAttributeName:self->_font, NSForegroundColorAttributeName:chipInk(self->_presentation[@"foreground"]), NSParagraphStyleAttributeName:paragraph}];
+  }];
+}
+#endif
+@end
