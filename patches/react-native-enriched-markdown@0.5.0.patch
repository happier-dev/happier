+  const revealWindow = appendedSourceLength * 2 + STREAMING_REVEAL_SOURCE_WINDOW_SLACK;
+  return Math.max(
+    params.commonPrefixLength,
+    params.currentComparisonTextLength - revealWindow
+  );
+}
+
+export function updateStreamingRevealRanges(params: Readonly<{
+  activeRanges: readonly StreamingRevealRange[];
+  previousComparisonText: string;
+  currentComparisonText: string;
+  nowMs: number;
+  ttlMs: number;
+  previousSourceLength?: number;
+  currentSourceLength?: number;
+}>): readonly StreamingRevealRange[] {
+  const commonPrefixLength = readCommonPrefixLength(
+    params.previousComparisonText,
+    params.currentComparisonText
+  );
+
+  // A range's start/end are offsets into the rendered comparison text of the
+  // render that CREATED it, and ranges outlive that render (they are carried
+  // forward for ttlMs so the reveal keyframe can finish). The rendered text is
+  // not append-only while markdown streams, so as soon as the common prefix
+  // collapses those offsets denote different characters: a range created over
+  // '**beta' keeps animating as 'beta', and on the raw/repaired markdown flip a
+  // range slides onto words that were painted long ago and replays their
+  // opacity keyframe. Rebase every carried-forward range onto the region that is
+  // byte-identical in both renders — the common prefix — and discard the rest,
+  // which described text that no longer exists. A genuine append leaves the whole
+  // previous text as the common prefix, so ordinary retention is untouched.
+  const retainedRanges = params.activeRanges.filter((range) =>
+    range.expiresAtMs > params.nowMs &&
+    range.start < commonPrefixLength
+  ).map((range) => ({
+    ...range,
+    end: Math.min(range.end, commonPrefixLength),
+  }));
+
+  // A mount — a remount above all — starts with no baseline: previousComparisonText
+  // is empty while this instance already renders the whole message. Diffing against
+  // '' makes the entire message look appended (the source-append bound cannot help
+  // either: previousSourceLength is 0, so the window spans everything), every word
+  // re-enters the reveal, and the block replays its opacity keyframe. Measured on
+  // web: 1 570 of 2 098 rendered chars below opacity 0.5 for ~155 ms immediately
+  // after the enriched run was replaced mid-stream. Content already rendered when
+  // this instance first compared is not new — seed the baseline and reveal nothing.
+  // Genuine appends after the seed still animate word by word.
+  if (
+    params.previousComparisonText === '' &&
+    params.currentComparisonText.length > 0
+  ) {
+    return mergeRevealRanges(retainedRanges);
+  }
+
+  const revealFloor = resolveStreamingRevealFloor({
+    commonPrefixLength,
+    currentComparisonTextLength: params.currentComparisonText.length,
+    previousSourceLength: params.previousSourceLength,
+    currentSourceLength: params.currentSourceLength,
+  });
+  if (revealFloor >= params.currentComparisonText.length) {
+    return mergeRevealRanges(retainedRanges);
+  }
+
+  return mergeRevealRanges([
+    ...retainedRanges,
+    ...readRevealWordRanges({
+      text: params.currentComparisonText.slice(revealFloor),
+      startOffset: revealFloor,
+      expiresAtMs: params.nowMs + params.ttlMs,
+    }),
+  ]);
+}
+
+export function shouldRevealTextForParent(parentType?: NodeType): boolean {
+  return parentType ? !NON_REVEALED_PARENT_TYPES.has(parentType) : true;
+}
+
+export interface StreamingRevealTextPart {
+  text: string;
+  animated: boolean;
+  startOffset: number;
+}
+
+/**
+ * SHARED word classifier for streaming text reveal — the single owner of the
+ * "which words of this text animate in" decision. Consumed by the enriched AST
+ * renderer below (range-driven) and by the host app's plain-text
+ * `StreamingTextReveal` (single appended-suffix range), so the two streaming
+ * surfaces cannot drift apart in word semantics.
+ */
+export function splitStreamingRevealTextParts(params: Readonly<{
+  text: string;
+  startOffset: number;
+  activeRanges: readonly StreamingRevealRange[];
+}>): StreamingRevealTextPart[] {
+  let cursor = params.startOffset;
+  let rangeIndex = 0;
+  const activeRanges = params.activeRanges;
+  return params.text
+    .split(/(\s+)/)
+    .filter((part) => part.length > 0)
+    .map((part) => {
+      const start = cursor;
+      const end = start + part.length;
+      cursor = end;
+
+      while (
+        rangeIndex < activeRanges.length &&
+        activeRanges[rangeIndex]!.end <= start
+      ) {
+        rangeIndex++;
+      }
+
+      const isActiveRevealRange =
+        rangeIndex < activeRanges.length &&
+        // A suffix can extend a word that is already visible. Keep that word
+        // visible instead of restarting its opacity animation from zero.
+        activeRanges[rangeIndex]!.start <= start;
+
+      return {
+        text: part,
+        animated: !/^\s+$/.test(part) && isActiveRevealRange,
+        startOffset: start,
+      };
+    });
+}
+
+export function renderStreamingRevealText(params: Readonly<{
+  capabilities: RenderCapabilities;
+  text: string;
+  revealable: boolean;
+  startOffset: number;
+}>): ReactNode {
+  const reveal = params.capabilities.streamingReveal;
+  if (!reveal || !params.revealable) {
+    return params.text;
+  }
+
+  return splitStreamingRevealTextParts({
+    text: params.text,
+    startOffset: params.startOffset,
+    activeRanges: reveal.activeRanges,
+  }).map((part, index) => {
+    if (!part.animated) {
+      return part.text;
+    }
+    return createElement(
+      'span',
+      {
+        key: `${part.startOffset}:${index}`,
+        'data-happier-enriched-markdown-reveal': 'text',
+      },
+      part.text
+    );
+  });
+}
