index 0000000000000000000000000000000000000000..ee47840d9a97be7b0b5728cfa398ae8e930b9dcb
--- /dev/null
+++ b/android/src/main/java/com/swmansion/enriched/markdown/spans/ReferenceChipSpan.kt
@@ -0,0 +1,93 @@
+package com.swmansion.enriched.markdown.spans
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.text.TextPaint
+import android.text.TextUtils
+import android.text.style.ReplacementSpan
+import android.widget.TextView
+import com.facebook.react.common.assets.ReactFontManager
+import com.swmansion.enriched.markdown.utils.text.ImageDownloader
+import org.json.JSONObject
+import java.lang.ref.WeakReference
+import kotlin.math.ceil
+import kotlin.math.max
+
+/** Retains the readable characters and the incumbent LinkSpan's destination/accessible action. */
+class ReferenceChipSpan(
+  context: Context,
+  private val reference: JSONObject,
+  style: JSONObject,
+) : ReplacementSpan() {
+  private val anatomy = style.getJSONObject("anatomy")
+  private val density = context.resources.displayMetrics.density
+  private val baseFontSize = style.optDouble("fontSize", anatomy.getDouble("baseFontSize")).toFloat() * density
+  private val typeface = ReactFontManager.getInstance().getTypeface(style.optString("fontFamily"), Typeface.NORMAL, context.assets)
+  private var thumbnail: Bitmap? = null
+  private var view = WeakReference<TextView>(null)
+
+  init {
+    val uri = reference.optString("thumbnail")
+    if (uri.isNotEmpty()) ImageDownloader.download(context, uri) { image ->
+      thumbnail = image
+      view.get()?.invalidate()
+    }
+  }
+
+  fun registerTextView(textView: TextView) { view = WeakReference(textView) }
+  private fun metric(name: String, paint: Paint) = anatomy.getDouble(name).toFloat() * density * paint.textSize / baseFontSize
+  private fun availableWidth(): Float = view.get()?.takeIf { it.width > 0 }?.let {
+    max(0, it.width - it.compoundPaddingLeft - it.compoundPaddingRight).toFloat()
+  } ?: Float.POSITIVE_INFINITY
+  private fun chromeWidth(paint: Paint) = metric("paddingLeft", paint) + metric("paddingRight", paint) + metric("glyphSize", paint) + metric("gap", paint)
+  private fun label(paint: Paint): String {
+    val budget = max(0f, minOf(metric("maxLabelWidth", paint), availableWidth() - chromeWidth(paint)))
+    return TextUtils.ellipsize(reference.getString("label"), TextPaint(paint).apply { typeface = this@ReferenceChipSpan.typeface }, budget, TextUtils.TruncateAt.END).toString()
+  }
+  private fun width(paint: Paint): Float = minOf(availableWidth(), Paint(paint).apply { typeface = this@ReferenceChipSpan.typeface }.measureText(label(paint)) + chromeWidth(paint))
+
+  override fun getSize(paint: Paint, text: CharSequence, start: Int, end: Int, fm: Paint.FontMetricsInt?): Int {
+    val metrics = paint.fontMetricsInt
+    val height = max(metric("height", paint), (metrics.descent - metrics.ascent).toFloat())
+    fm?.apply {
+      ascent = minOf(metrics.ascent, ((metrics.ascent + metrics.descent - height) / 2).toInt())
+      descent = maxOf(metrics.descent, ascent + ceil(height).toInt())
+      top = minOf(metrics.top, ascent); bottom = maxOf(metrics.bottom, descent)
+    }
+    return ceil(width(paint)).toInt()
+  }
+
+  /** One drawing function, using the composer owner's anatomy and the resolved theme inks. */
+  override fun draw(canvas: Canvas, text: CharSequence, start: Int, end: Int, x: Float, top: Int, y: Int, bottom: Int, paint: Paint) {
+    val ink = Paint(paint).apply { isAntiAlias = true; isUnderlineText = false; typeface = this@ReferenceChipSpan.typeface }
+    val height = max(metric("height", ink), ink.fontMetrics.descent - ink.fontMetrics.ascent)
+    val center = y + (ink.fontMetrics.ascent + ink.fontMetrics.descent) / 2
+    val box = RectF(x, center - height / 2, x + width(ink), center + height / 2)
+    canvas.save()
+    canvas.clipRect(box)
+    ink.color = reference.getLong("background").toInt()
+    canvas.drawRoundRect(box, metric("radius", ink), metric("radius", ink), ink)
+    val size = metric("glyphSize", ink)
+    val glyph = RectF(x + metric("paddingLeft", ink), center - size / 2, x + metric("paddingLeft", ink) + size, center + size / 2)
+    val image = thumbnail
+    if (image != null) {
+      canvas.save()
+      canvas.clipPath(Path().apply { addRoundRect(glyph, metric("thumbnailRadius", ink), metric("thumbnailRadius", ink), Path.Direction.CW) })
+      val cover = max(size / image.width, size / image.height)
+      val w = image.width * cover; val h = image.height * cover
+      canvas.drawBitmap(image, null, RectF(glyph.centerX() - w / 2, center - h / 2, glyph.centerX() + w / 2, center + h / 2), ink)
+      canvas.restore()
+    } else {
+      val glyphPaint = Paint(ink).apply { color = reference.getLong("glyphInk").toInt(); textSize = size; typeface = Typeface.DEFAULT }
+      canvas.drawText(reference.optString("glyph"), glyph.left, center - (glyphPaint.fontMetrics.ascent + glyphPaint.fontMetrics.descent) / 2, glyphPaint)
+    }
+    ink.color = reference.getLong("foreground").toInt()
+    canvas.drawText(label(ink), glyph.right + metric("gap", ink), y.toFloat(), ink)
+    canvas.restore()
+  }
+}
