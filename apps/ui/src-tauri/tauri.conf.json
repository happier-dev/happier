{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Happier",
  "version": "0.2.0",
  "identifier": "dev.happier.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:dev",
    "beforeBuildCommand": "node ./scripts/runTauriBeforeCommand.mjs tauri:prepare:build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "overlay",
        "pet_overlay"
      ],
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Happier",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 22, "y": 14 },
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": {
      "../../../packages/iroh-native/release-evidence/THIRD-PARTY-NOTICES.txt": "licenses/iroh-native/THIRD-PARTY-NOTICES.txt",
      "../../../packages/iroh-native/release-evidence/sbom.cdx.json": "licenses/iroh-native/sbom.cdx.json"
    },
    "externalBin": [
      "binaries/hsetup"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "./dmg/dmg-background.png",
        "windowSize": {
          "width": 623,
          "height": 602
        },
        "appPosition": {
          "x": 169,
          "y": 305
        },
        "applicationFolderPosition": {
          "x": 451,
          "y": 305
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/AppIcon.icon",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["happier"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRTk2MjE4RjNCMEYxRUYKUldUdjhiRHpHR0xwcTFIUjMvb1FBbW5HOUFYSkd5aGlHa204MWZuRk50ekF5WVZQdU1mVkRWWnkK",
      "endpoints": [
        "https://github.com/happier-dev/happier/releases/download/ui-desktop-stable/latest.json"
      ]
    }
  }
}
