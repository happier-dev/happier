{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "destination_*"
  ],
  "permissions": [
    "core:default",
    "allow-desktop-capture",
    "allow-desktop-recording-trim",
    "deep-link:default",
    "http:default",
    "notification:default",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-badge-label",
    "dialog:allow-open",
    "allow-desktop-download-cache",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/happier-downloads/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    },
    "allow-desktop-fetch-update",
    "allow-desktop-download-update",
    "allow-desktop-install-update",
    "allow-desktop-pick-ssh-identity-file",
    "allow-desktop-pick-personal-home-backup-archive",
    "allow-desktop-save-personal-home-backup-archive",
    "allow-desktop-finish-shutdown",
    "allow-desktop-read-shutdown-state",
    "allow-desktop-set-tray-state",
    "allow-sync-desktop-pet-overlay-state",
    "allow-desktop-pet-overlay-read-window-state",
    "allow-desktop-pet-overlay-set-input-locked",
    "allow-desktop-pet-overlay-reset-position",
    "allow-emit-desktop-pet-overlay-interaction-result",
    "allow-start-system-task",
    "allow-cancel-system-task",
    "allow-get-system-task-snapshot",
    "allow-system-tasks-open-log-path",
    "allow-system-tasks-reveal-output-path",
    "allow-respond-system-task-prompt",
    "allow-desktop-get-window-chrome-policy",
    "allow-desktop-get-window-state",
    "allow-desktop-set-window-title",
    "allow-desktop-get-glass-state",
    "allow-desktop-apply-glass-material",
    "allow-desktop-open-reduce-transparency-settings",
    "allow-desktop-minimize-window",
    "allow-desktop-toggle-window-maximize",
    "allow-desktop-close-window",
    "allow-desktop-show-main-window",
    "allow-desktop-main-window-content-rendered",
    "allow-desktop-start-window-dragging",
    "allow-desktop-set-window-mode",
    "allow-desktop-read-stack-boot-credentials",
    "allow-desktop-secure-storage-read",
    "allow-desktop-secure-storage-write",
    "allow-desktop-secure-storage-remove",
    "allow-desktop-browser-get-availability",
    "allow-desktop-browser-apply-login-cookies",
    "allow-desktop-browser-get-native-passkey-availability",
    "allow-desktop-browser-open-view",
    "allow-desktop-browser-navigate",
    "allow-desktop-browser-set-bounds",
    "allow-desktop-browser-set-pointer-passthrough",
    "allow-desktop-browser-close-view",
    "allow-desktop-browser-open-devtools",
    "allow-desktop-browser-get-page-info",
    "allow-desktop-browser-capture-snapshot",
    "allow-desktop-browser-capture-recording-frame",
    "allow-desktop-browser-drain-diagnostics",
    "allow-desktop-browser-eval-script",
    "allow-desktop-browser-dispatch-navigation",
    "allow-desktop-hosted-artifact-get-frame-capability",
    "allow-desktop-hosted-artifact-register",
    "allow-desktop-hosted-artifact-unregister",
    "allow-desktop-hosted-artifact-cache-read",
    "allow-desktop-hosted-artifact-cache-write",
    "allow-desktop-hosted-artifact-cache-describe",
    "allow-desktop-hosted-artifact-cache-remove",
    "allow-desktop-hosted-artifact-cache-remove-account",
    "allow-desktop-hosted-artifact-open-view",
    "allow-desktop-hosted-artifact-set-bounds",
    "allow-desktop-hosted-artifact-post-message",
    "allow-desktop-hosted-artifact-go-back",
    "allow-desktop-hosted-artifact-close-view",
    "allow-desktop-displays-list",
    "allow-desktop-host-get-availability",
    "allow-desktop-activity-overlay-move",
    "allow-desktop-activity-overlay-sync",
    "allow-desktop-activity-overlay-get-window-state",
    "allow-desktop-window-emit-action-result",
    "allow-desktop-window-emit-action",
    "allow-desktop-app-window-open",
    "allow-desktop-app-window-ready",
    "allow-desktop-app-window-read",
    "allow-desktop-app-window-restore",
    "allow-desktop-app-window-responders",
    "allow-desktop-app-window-surface",
    "allow-desktop-app-window-surfaces",
    "allow-desktop-app-window-placement",
    "allow-desktop-app-window-update",
    "allow-desktop-app-window-close",
    "allow-desktop-app-windows-teardown",
    "allow-desktop-app-windows-auth-changed",
    "allow-desktop-capture-window-hide",
    "allow-iroh-ensure-home-tunnel",
    "allow-iroh-release-home-tunnel",
    "allow-iroh-get-tunnel-status",
    "allow-iroh-get-availability",
    "allow-iroh-get-application-endpoint",
    "allow-iroh-start-machine-tunnel",
    "allow-iroh-start-machine-http-tunnel",
    "allow-iroh-stop-machine-tunnel",
    "allow-iroh-wait-machine-tunnel-closed",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        }
      ]
    }
  ]
}
