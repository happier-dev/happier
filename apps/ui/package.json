{
  "name": "@happier-dev/app",
  "main": "index.ts",
  "version": "0.2.0",
  "happierExpoRuntimeVersion": "0.2.0-native",
  "scripts": {
    "ensure:workspace:built": "node ./scripts/ensureWorkspacePackagesBuilt.mjs",
    "start": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 expo start",
    "android": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 expo run:android",
    "ios": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 expo run:ios",
    "ios:connected-device": "yarn ios -d",
    "submit": "eas submit --platform ios",
    "web": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 expo start --web",
    "test": "yarn -s test:unit && node --test ./scripts/navigationPackageContract.test.mjs ./scripts/nativeModulesPackageContract.test.mjs",
    "test:unit": "yarn -s ensure:workspace:built && yarn -s postinstall:patches && node ./scripts/runVitestShards.mjs --config vitest.config.ts",
    "test:integration": "yarn -s ensure:workspace:built && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:activity-surfaces": "node ./scripts/runActivitySurfacesVitestSuite.mjs",
    "test:native-e2e:activity-surfaces": "yarn -s ensure:workspace:built && node ./scripts/tauriMcpQa.mjs --activity-surfaces",
    "prebuild": "yarn -s validate:ios:widgets:native-sync && rm -rf android ios && cross-env EXPO_UNSTABLE_WEB_MODAL=1 expo prebuild && yarn -s validate:ios:widgets:generated-project",
    "ota": "cross-env-shell EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=preview NODE_ENV=preview \"tsx sources/scripts/parseChangelog.ts && tsx sources/scripts/parseReleaseNotes.ts && yarn typecheck && eas update --branch preview\"",
    "ota:production": "cross-env EXPO_UNSTABLE_WEB_MODAL=1 npx eas-cli@latest workflow:run ota.yaml",
    "typecheck": "node scripts/ensureWorkspacePackagesBuilt.mjs && tsc -p tsconfig.json --noEmit",
    "typecheck:activity-surfaces": "node ./scripts/ensureWorkspacePackagesBuilt.mjs && tsc -p tsconfig.activity-surfaces-rollout.json --noEmit --pretty false",
    "certify:activity-surfaces": "node ./scripts/runActivitySurfacesCertification.mjs",
    "certify:activity-surfaces:native": "node ./scripts/runActivitySurfacesNativeCertification.mjs",
    "certify:activity-surfaces:release": "node ./scripts/runActivitySurfacesReleaseReadiness.mjs",
    "migrate:imports": "tsx tools/migrations/rewrite-imports.ts",
    "migrate:verify": "tsx tools/migrations/verify-imports.ts",
    "migrate:inline-mocks": "tsx tools/migrations/rewrite-inline-mock-families.ts",
    "migrate:inline-mocks:verify": "tsx tools/migrations/verify-inline-mock-families.ts",
    "migrate:renderers": "tsx tools/migrations/rewrite-renderer-create-to-renderScreen.ts",
    "migrate:cleanup": "tsx tools/migrations/rewrite-standard-cleanup.ts",
    "postinstall:real": "node ./tools/postinstall.mjs",
    "postinstall:patches": "cross-env HAPPIER_UI_VENDOR_WEB_ASSETS=0 node ./tools/postinstall.mjs",
    "eas-build-post-install": "yarn -s postinstall:real",
    "postinstall": "node -e \"const fs=require('fs');const cp=require('child_process');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'ui',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('tools/postinstall.mjs'))process.exit(0);const run=(cmd,args)=>cp.spawnSync(cmd,args,{stdio:'inherit'});const npmExec=process.env.npm_execpath;let r;if(npmExec){r=run(process.execPath,[npmExec,'run','-s','postinstall:real']);}else{r=run(process.platform==='win32'?'yarn.cmd':'yarn',['-s','postinstall:real']);if(r.error&&process.platform==='win32'){r=run('yarn',['-s','postinstall:real']);}}if(r.error){console.error(r.error.message);process.exit(1);}process.exit(r.status??1);\"",
    "generate-theme": "tsx sources/theme.gen.ts",
    "// ==== Development/Preview/Production Variants ====": "",
    "ios:dev": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=development expo run:ios",
    "ios:preview": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=preview expo run:ios",
    "ios:production": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=production expo run:ios",
    "validate:ios:widgets:native-sync": "cross-env EXPO_UNSTABLE_WEB_MODAL=1 node ./scripts/validateExpoWidgetsNativeSync.mjs",
    "validate:ios:widgets:generated-project": "cross-env EXPO_UNSTABLE_WEB_MODAL=1 node ./scripts/validateExpoWidgetsGeneratedProject.mjs",
    "validate:ios:widgets:simulator-build-smoke": "cross-env EXPO_UNSTABLE_WEB_MODAL=1 node ./scripts/validateExpoWidgetsSimulatorBuildSmoke.mjs",
    "android:dev": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=development expo run:android",
    "android:preview": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=preview expo run:android",
    "android:production": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=production expo run:android",
    "start:dev": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=development expo start",
    "start:preview": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=preview expo start",
    "start:production": "yarn -s ensure:workspace:built && cross-env EXPO_UNSTABLE_WEB_MODAL=1 APP_ENV=production expo start",
    "// ==== macOS Desktop (Tauri) Variants ====": "",
    "tauri:prepare:sidecar": "node ./scripts/prepareTauriSidecar.mjs",
    "tauri:prepare:dev": "yarn -s tauri:prepare:sidecar && yarn start",
    "tauri:prepare:build": "yarn -s tauri:prepare:sidecar && cross-env EXPO_UNSTABLE_WEB_MODAL=1 yarn expo export --platform web --output-dir dist",
    "ui:tauri": "yarn -s ensure:workspace:built && node ../stack/scripts/tauri_dev.mjs",
    "tauri:dev": "yarn -s ensure:workspace:built && node ../stack/scripts/tauri_dev.mjs",
    "tauri:qa": "yarn -s ensure:workspace:built && node ./scripts/tauriMcpQa.mjs",
    "tauri:mcp:server": "npx -y @hypothesi/tauri-mcp-server",
    "tauri:mcp:cli": "npx -y -p @hypothesi/tauri-mcp-cli tauri-mcp",
    "tauri:mcp:session:start": "npx -y -p @hypothesi/tauri-mcp-cli tauri-mcp driver-session start --port 9225",
    "tauri:mcp:wizard:qa": "node ./scripts/qa/tauriOnboardingWizardMcpQa.mjs",
    "tauri:mcp:activity-surfaces:qa": "node ./scripts/qa/tauriActivitySurfacesMcpQa.mjs",
    "tauri:mcp:desktop-sidebar-chrome:qa": "node ./scripts/qa/tauriDesktopSidebarChromeMcpQa.mjs",
    "test:native-e2e:desktop-sidebar-chrome": "yarn -s ensure:workspace:built && node ./scripts/tauriMcpQa.mjs --desktop-sidebar-chrome",
    "tauri:build:dev": "tauri build --config src-tauri/tauri.publicdev.conf.json",
    "tauri:build:preview": "tauri build --config src-tauri/tauri.preview.conf.json",
    "tauri:build:production": "tauri build"
  },
