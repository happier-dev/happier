  "main": "index.ts",
  "version": "0.2.10",
  "happierExpoRuntimeVersion": "0.2.1-native",
  "happier": {
    "installFreshnessInputs": [
      "app.config.js",
      "patches",
      "sources/components/ui/markdown/editor/bridge/tiptapWebViewEntry.ts",
      "sources/components/markdown/mermaidWebViewEntry.ts",
      "tools/postinstall.mjs",
      "tools/resolveUiPostinstallTasks.mjs",
      "tools/ensureNohoistPeerLinks.mjs",
      "tools/postinstall",
      "tools/react-native-enriched-markdown",
      "tools/diffs",
      "tools/codemirror",
      "tools/xterm",
      "tools/tiptap",
      "tools/mermaid"
    ]
