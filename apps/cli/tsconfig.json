{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "es2020",
      "es2022"
    ],
    "jsx": "react",
    "rootDir": "src",
    "outDir": "dist/.tsc",
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/cli.typecheck.tsbuildinfo",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    // Self-declared temporary measurement scratch. Files named `*.tmp.test.ts` are written
    // to record a number and deleted afterwards, and while they exist they may import
    // directly across package boundaries, which pulls foreign sources into this program and
    // fails `rootDir`. Transient scratch must not be able to break the package build.
    "src/**/*.tmp.test.ts",
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
