{
  "schemaVersion": 2,
  "id": "acme.connected-accounts-conformance-consumer",
  "version": "1.0.0",
  "displayName": "Connected Accounts Conformance Consumer",
  "description": "Packed third-party conformance consumer for the public Connected Accounts API.",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1
  },
  "entrypoints": {
    "daemon": "./daemon.mjs"
  },
  "activation": {
    "events": [
      {
        "kind": "startup"
      }
    ]
  },
  "hostAccess": {
    "required": [
      {
        "id": "fixed",
        "capability": "connectedAccounts",
        "reason": "Use the fixed conformance account.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "select",
            "use"
          ],
          "materializationKinds": [
            "httpHeaders",
            "environment",
            "files"
          ]
        }
      },
      {
        "id": "group",
        "capability": "connectedAccounts",
        "reason": "Use the conformance account group.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "select",
            "use"
          ],
          "materializationKinds": [
            "environment"
          ]
        }
      },
      {
        "id": "multi",
        "capability": "connectedAccounts",
        "reason": "Choose one service for a multi-service purpose.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            },
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "archive"
            }
          ],
          "operations": [
            "select",
            "use"
          ]
        }
      },
      {
        "id": "select-only",
        "capability": "connectedAccounts",
        "reason": "Exercise selection-only authorization.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "select"
          ]
        }
      },
      {
        "id": "use-only",
        "capability": "connectedAccounts",
        "reason": "Exercise use-only authorization.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "use"
          ]
        }
      },
      {
        "id": "replaceable",
        "capability": "connectedAccounts",
        "reason": "Exercise binding replacement.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "select",
            "use"
          ],
          "materializationKinds": [
            "environment"
          ]
        }
      },
      {
        "id": "revocable",
        "capability": "connectedAccounts",
        "reason": "Exercise binding revocation.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "select",
            "use"
          ],
          "materializationKinds": [
            "environment"
          ]
        }
      },
      {
        "id": "rotating",
        "capability": "connectedAccounts",
        "reason": "Exercise materializer replacement.",
        "scope": {
          "serviceRefs": [
            {
              "pluginId": "acme.connected-accounts-conformance-producer",
              "localId": "vault"
            }
          ],
          "operations": [
            "select",
            "use"
          ],
          "materializationKinds": [
            "environment"
          ]
        }
      }
    ],
    "optional": []
  },
  "contributes": {
    "actions": [
      {
        "id": "verify",
        "title": "Verify Connected Accounts",
        "description": "Exercises the stable Connected Accounts service through the real invocation host.",
        "scopes": [
          "global"
        ],
        "surfaces": [
          "cli"
        ],
        "dangerLevel": "safe",
        "execution": {
          "target": "daemon"
        },
        "hostAccess": [
          "fixed",
          "group",
          "multi",
          "select-only",
          "use-only",
          "replaceable",
          "revocable",
          "rotating"
        ]
      },
      {
        "id": "verify-removal-readd",
        "title": "Verify Connected Accounts Removal and Re-add",
        "description": "Proves removed durable selection does not resurrect after the purpose is re-published.",
        "scopes": [
          "global"
        ],
        "surfaces": [
          "cli"
        ],
        "dangerLevel": "safe",
        "execution": {
          "target": "daemon"
        },
        "hostAccess": [
          "fixed"
        ]
      }
    ]
  }
}
