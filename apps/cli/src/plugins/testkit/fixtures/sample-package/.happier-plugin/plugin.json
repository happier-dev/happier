{
  "schemaVersion": 2,
  "id": "acme.sample",
  "version": "1.0.0",
  "displayName": "Acme Sample",
  "description": "Sample plugin used to exercise the local-path plugin pipeline",
  "engines": {
    "happier": "^0.3.0"
  },
  "runtime": {
    "apiVersion": 1
  },
  "entrypoints": {
    "daemon": "./daemon.mjs"
  },
  "activation": {
    "events": [
      {
        "kind": "startup"
      }
    ]
  },
  "hostAccess": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "agents": [
      {
        "id": "sample-provider",
        "title": "Acme Sample CLI",
        "description": "Current Manifest V2 custom Agent test fixture",
        "runtime": {
          "kind": "custom"
        },
        "cli": {
          "displayName": "Acme Sample CLI",
          "executable": {
            "binaryName": "acme-sample",
            "sourcePreference": "system-first"
          },
          "install": {
            "managed": null,
            "manual": {
              "kind": "none"
            }
          },
          "auth": {
            "support": "unsupported",
            "loginLaunches": []
          }
        },
        "primary": "sessions",
        "capabilities": {
          "sessions": {
            "open": [
              "create",
              "resume"
            ],
            "delivery": [
              "newTurn",
              "steer",
              "followUp"
            ],
            "cancel": true
          }
        }
      }
    ],
    "hooks": [
      {
        "id": "resolve-prerequisites",
        "on": "agent.resolvePrerequisites",
        "category": "decision",
        "scope": "agent",
        "executionKind": "decide"
      }
    ]
  }
}
