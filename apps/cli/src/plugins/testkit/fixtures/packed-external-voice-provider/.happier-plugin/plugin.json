{
  "schemaVersion": 2,
  "id": "acme.packed-voice",
  "version": "1.0.0",
  "displayName": "Packed Voice Fixture",
  "description": "Dependency-closed external Voice provider fixture",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1
  },
  "activation": {
    "events": [
      {
        "kind": "startup"
      }
    ]
  },
  "entrypoints": {
    "daemon": "./dist/daemon.js",
    "development": "./src/voiceDaemon.ts"
  },
  "hostAccess": {
    "required": [
      {
        "id": "voice-provider-api",
        "capability": "network",
        "reason": "Read, provision, and authenticate a bounded Voice session",
        "scope": {
          "targets": [
            {
              "kind": "fixedOrigin",
              "origin": "https://voice.example.test"
            }
          ],
          "methods": ["GET", "POST", "PATCH"]
        }
      }
    ],
    "optional": []
  },
  "contributes": {
    "actions": [
      {
        "id": "open-packed-current-context",
        "title": "Open packed current context",
        "description": "Runs the mounted packed Voice fixture current-context Action.",
        "scopes": ["global"],
        "surfaces": ["ui", "voice"],
        "placementBindings": ["detailsPanel"],
        "execution": {
          "target": "client",
          "client": {
            "artifactId": "voice-runtime-web",
            "modulePath": "./voiceRuntime",
            "exportName": "activate"
          },
          "platforms": ["web", "ios", "android"]
        },
        "dangerLevel": "safe"
      }
    ],
    "agents": [
      {
        "id": "voice-agent",
        "title": "Packed Voice Agent",
        "description": "External Agent declaration used by the packed Voice realtime fixture",
        "runtime": {
          "kind": "custom"
        },
        "primary": "sessions",
        "capabilities": {
          "sessions": {
            "open": ["create"],
            "delivery": ["newTurn"],
            "cancel": true
          }
        }
      }
    ],
    "voiceProviders": [
      {
        "id": "conversation-mediated",
        "title": "Packed Conversation",
        "kind": "conversation",
        "roles": ["conversation_stt", "conversation_tts", "realtime_conversation", "turn_control"],
        "platforms": ["web", "ios", "android"],
        "capabilities": {
          "turn": { "cancelResponse": true, "bargeIn": false },
          "tools": { "effectCalls": "stable_ids" }
        },
        "execution": {
          "kind": "experimental_agent_session_realtime",
          "agent": "voice-agent",
          "supportedRuntimeVersions": ["1.0.0"]
        },
        "settings": {
          "schemaVersion": 2,
          "fields": [
            {
              "id": "profile",
              "title": "Voice profile",
              "description": "Provider-owned profile used for bounded provisioning",
              "schema": {
                "type": "string",
                "enum": ["balanced", "expressive"]
              },
              "default": "balanced",
              "presentation": {
                "control": "select",
                "options": [
                  { "value": "balanced", "title": "Balanced" },
                  { "value": "expressive", "title": "Expressive" }
                ]
              }
            },
            {
              "id": "enableProvisioning",
              "title": "Provision selected voice",
              "description": "Apply the selected profile through the approved provider mutation",
              "schema": {
                "type": "boolean"
              },
              "default": true,
              "presentation": {
                "control": "switch"
              }
            }
          ],
          "actions": [
            {
              "id": "provision-voice",
              "title": "Provision voice",
              "placement": { "kind": "contributionFooter" },
              "confirmation": {
                "kind": "required",
                "title": "Provision voice",
                "description": "Apply the selected profile to the fixture provider.",
                "confirmLabel": "Provision"
              },
              "patchFieldIds": ["profile"]
            }
          ]
        },
        "credentials": {
          "slot": {
            "id": "api_key",
            "purpose": "voice.client-auth",
            "title": "API key"
          },
          "requirement": { "kind": "always" },
          "sources": [{
            "kind": "savedSecret",
            "secretKinds": ["apiKey"],
            "operationProjections": [
              { "kind": "recipientCredential", "operation": "list-voices", "phase": "settings", "format": "bearer" },
              { "kind": "recipientCredential", "operation": "provision-voice", "phase": "settings", "format": "bearer" },
              { "kind": "recipientCredential", "operation": "client-auth", "phase": "prepare", "format": "bearer" }
            ]
          }],
          "hostMediated": {
            "operations": [
            {
              "id": "list-voices",
              "purpose": "voice.catalog.voices",
              "credentialSlotId": "api_key",
              "effect": "read",
              "request": {
                "origin": "https://voice.example.test",
                "pathTemplate": "/v1/voices",
                "queryTemplate": [],
                "headerTemplate": [],
                "bodyTemplate": { "kind": "none" },
                "method": "GET",
                "credential": {
                  "kind": "httpHeader",
                  "name": "authorization",
                  "format": "bearer"
                },
                "redirect": "error",
                "maxBodyBytes": 0,
                "contentTypes": []
              },
              "parameters": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                },
                "mapping": []
              },
              "response": {
                "maxBytes": 2097152,
                "contentTypes": ["application/json"]
              }
            },
            {
              "id": "provision-voice",
              "purpose": "voice.provision.selected",
              "credentialSlotId": "api_key",
              "effect": "mutation",
              "request": {
                "origin": "https://voice.example.test",
                "pathTemplate": "/v1/voices/{voiceId}",
                "queryTemplate": [],
                "headerTemplate": [
                  { "name": "content-type", "value": "application/json" }
                ],
                "bodyTemplate": { "kind": "json", "value": {} },
                "method": "PATCH",
                "credential": {
                  "kind": "httpHeader",
                  "name": "authorization",
                  "format": "bearer"
                },
                "redirect": "error",
                "maxBodyBytes": 4096,
                "contentTypes": ["application/json"]
              },
              "parameters": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "voiceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "body": {
                      "type": "object",
                      "properties": {
                        "profile": {
                          "type": "string",
                          "enum": ["balanced", "expressive"]
                        }
                      },
                      "required": ["profile"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["voiceId", "body"],
                  "additionalProperties": false
                },
                "mapping": [
                  {
                    "parameter": "voiceId",
                    "target": {
                      "kind": "path",
                      "placeholder": "voiceId",
                      "encoding": "uri_component"
                    }
                  },
                  {
                    "parameter": "body",
                    "target": { "kind": "body", "pointer": "" }
                  }
                ]
              },
              "response": {
                "maxBytes": 32768,
                "contentTypes": ["application/json"]
              }
            },
            {
              "id": "client-auth",
              "purpose": "voice.client-auth",
              "credentialSlotId": "api_key",
              "effect": "read",
              "request": {
                "origin": "https://voice.example.test",
                "pathTemplate": "/v1/session",
                "queryTemplate": [],
                "headerTemplate": [
                  { "name": "content-type", "value": "application/json" }
                ],
                "bodyTemplate": { "kind": "json", "value": {} },
                "method": "POST",
                "credential": {
                  "kind": "httpHeader",
                  "name": "authorization",
                  "format": "bearer"
                },
                "redirect": "error",
                "maxBodyBytes": 65536,
                "contentTypes": ["application/json"]
              },
              "parameters": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "object",
                      "properties": {
                        "audience": { "const": "realtime" },
                        "voiceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": ["audience", "voiceId"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["body"],
                  "additionalProperties": false
                },
                "mapping": [
                  { "parameter": "body", "target": { "kind": "body", "pointer": "" } }
                ]
              },
              "response": {
                "maxBytes": 32768,
                "contentTypes": ["application/json"]
              }
            }
            ]
          }
        },
        "client": {
          "artifactId": "voice-runtime-web",
          "modulePath": "./voiceRuntime",
          "exportName": "activate"
        }
      },
      {
        "id": "conversation-raw",
        "title": "Packed Raw Conversation",
        "kind": "conversation",
        "roles": ["realtime_conversation"],
        "platforms": ["web", "ios", "android"],
        "capabilities": {
          "turn": { "cancelResponse": true, "bargeIn": true }
        },
        "credentials": {
          "slot": {
            "id": "raw_key",
            "purpose": "voice.raw-client",
            "title": "Raw client key"
          },
          "requirement": { "kind": "always" },
          "sources": [
            {
              "kind": "savedSecret",
              "secretKinds": ["apiKey"],
              "rawGrants": [
                {
                  "realm": "web",
                  "phase": "connection",
                  "request": {
                    "kind": "httpHeaders",
                    "origin": "https://voice.example.test",
                    "headerNames": ["authorization"]
                  }
                },
                {
                  "realm": "ios",
                  "phase": "connection",
                  "request": {
                    "kind": "httpHeaders",
                    "origin": "https://voice.example.test",
                    "headerNames": ["authorization"]
                  }
                },
                {
                  "realm": "android",
                  "phase": "connection",
                  "request": {
                    "kind": "httpHeaders",
                    "origin": "https://voice.example.test",
                    "headerNames": ["authorization"]
                  }
                }
              ]
            },
            {
              "kind": "connectedAccount",
              "service": {
                "pluginId": "acme.connected-accounts",
                "localId": "voice-oauth"
              },
              "rawGrants": [
                {
                  "realm": "web",
                  "phase": "connection",
                  "request": {
                    "kind": "httpHeaders",
                    "origin": "https://voice.example.test",
                    "headerNames": ["authorization"]
                  }
                },
                {
                  "realm": "ios",
                  "phase": "connection",
                  "request": {
                    "kind": "httpHeaders",
                    "origin": "https://voice.example.test",
                    "headerNames": ["authorization"]
                  }
                },
                {
                  "realm": "android",
                  "phase": "connection",
                  "request": {
                    "kind": "httpHeaders",
                    "origin": "https://voice.example.test",
                    "headerNames": ["authorization"]
                  }
                }
              ]
            }
          ]
        },
        "client": {
          "artifactId": "voice-runtime-web",
          "modulePath": "./voiceRuntime",
          "exportName": "activate"
        }
      },
      {
        "id": "speech-stt",
        "title": "Packed Speech to Text",
        "kind": "speech",
        "roles": ["dictation_stt", "conversation_stt"],
        "platforms": ["web", "ios", "android"],
        "settings": {
          "schemaVersion": 2,
          "fields": [
            {
              "id": "model",
              "title": "Transcription model",
              "schema": { "type": "string", "maxLength": 512 },
              "default": "packed-stt-v1",
              "presentation": { "control": "select" }
            }
          ],
          "readiness": [
            { "kind": "setting_nonempty", "settingId": "model" }
          ]
        },
        "catalogs": [
          { "kind": "models", "settingFieldId": "model", "allowCustom": true }
        ],
        "limits": {
          "transcribe": { "maxInputBytes": 1048576 }
        }
      },
      {
        "id": "speech-tts",
        "title": "Packed Text to Speech",
        "kind": "speech",
        "roles": ["conversation_tts"],
        "platforms": ["web", "ios", "android"],
        "settings": {
          "schemaVersion": 2,
          "fields": [
            {
              "id": "voice",
              "title": "Voice",
              "schema": { "type": "string", "maxLength": 512 },
              "default": "packed-voice-primary",
              "presentation": { "control": "select" }
            }
          ],
          "readiness": [
            { "kind": "setting_nonempty", "settingId": "voice" }
          ]
        },
        "catalogs": [
          { "kind": "voices", "settingFieldId": "voice", "allowCustom": false }
        ],
        "limits": {
          "synthesize": {
            "maxInputCharacters": 4096,
            "maxOutputBytes": 2097152
          }
        }
      }
    ],
    "ui": {
      "views": [
        {
          "id": "packed-current-context",
          "container": "appPage",
          "target": { "kind": "app" },
          "renderer": "packed-current-context-renderer",
          "title": "Packed current context",
          "instancePolicy": "singleton"
        }
      ],
      "renderers": [
        {
          "id": "packed-current-context-renderer",
          "kind": "reactNative",
          "artifact": "voice-runtime-web",
          "requiredHostMethods": ["publishCurrentUiContext"]
        }
      ]
    }
  }
}
