{
  "schemaVersion": 2,
  "id": "examples.ui-descriptor-plugin",
  "version": "0.1.0",
  "displayName": "UI Descriptor Example",
  "description": "Manifest-owned resource and host-rendered descriptor example.",
  "engines": {
    "happier": "^0.2.0"
  },
  "uses": [],
  "entrypoints": {
    "main": "./agent/daemon.mjs"
  },
  "permissions": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "resources": [
      {
        "id": "examples.ui.prompt",
        "resourceKind": "prompt",
        "path": "resources/review-prompt.md",
        "contentType": "text/markdown"
      }
    ],
    "uiDescriptors": [
      {
        "id": "examples.ui.settings",
        "surface": "settings",
        "title": "Example Plugin Settings",
        "description": "Host-rendered descriptor declared in the manifest.",
        "fields": [
          {
            "id": "enabled",
            "type": "boolean",
            "title": "Enabled"
          },
          {
            "id": "profile",
            "type": "select",
            "title": "Profile",
            "options": [
              {
                "value": "fast",
                "label": "Fast"
              },
              {
                "value": "safe",
                "label": "Safe"
              }
            ]
          }
        ]
      }
    ]
  }
}
