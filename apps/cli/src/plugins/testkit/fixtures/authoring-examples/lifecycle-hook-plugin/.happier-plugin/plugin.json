{
  "schemaVersion": 2,
  "id": "examples.lifecycle-hook-plugin",
  "version": "0.1.0",
  "displayName": "Lifecycle Hook Example",
  "description": "Manifest-declared lifecycle hook example for plugin authoring.",
  "engines": {
    "happier": "^0.2.0"
  },
  "uses": [
    "hooks"
  ],
  "entrypoints": {
    "main": "./agent/daemon.mjs"
  },
  "permissions": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "hooks": [
      {
        "hookApiVersion": 1,
        "id": "agent.response.after",
        "category": "lifecycle",
        "scope": "agent",
        "executionKind": "observe",
        "priority": 50,
        "handler": {
          "target": "plugin",
          "exportName": "observeAgentResponse"
        }
      }
    ]
  }
}
