{
  "schemaVersion": 2,
  "id": "examples.bundled-first-party",
  "version": "0.1.0",
  "displayName": "Bundled First-Party Example",
  "description": "Bundled first-party provider/backend example with domain-organized topology.",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1,
    "capabilities": [
      "agents",
      "backends"
    ]
  },
  "targets": {
    "daemon": {
      "entry": "./agent/daemon.mjs"
    }
  },
  "capabilities": {
    "permissions": []
  },
  "contributes": {
    "agents": [
      {
        "kindVersion": 1,
        "id": "examples.bundled.provider",
        "display": {
          "name": "Bundled Example Provider",
          "tags": [
            "bundled",
            "first-party"
          ]
        },
        "ownedBackendIds": [
          "examples.bundled.backend"
        ],
        "catalogAgentId": "claude"
      }
    ],
    "backends": [
      {
        "kindVersion": 1,
        "id": "examples.bundled.backend",
        "capabilities": {},
        "target": {
          "sourceKind": "first_party",
          "id": "examples.bundled-first-party"
        },
        "agentId": "examples.bundled.provider",
        "surfaceHandlers": [
          {
            "id": "backend.terminalRuntime.launch",
            "kind": "terminalRuntime",
            "operation": "launch",
            "handler": {
              "target": "daemon",
              "exportName": "launch"
            }
          },
          {
            "id": "backend.terminalRuntime.discoverIdentity",
            "kind": "terminalRuntime",
            "operation": "discoverIdentity",
            "handler": {
              "target": "daemon",
              "exportName": "discoverIdentity"
            }
          }
        ],
        "engine": {
          "kind": "custom"
        }
      }
    ]
  }
}
