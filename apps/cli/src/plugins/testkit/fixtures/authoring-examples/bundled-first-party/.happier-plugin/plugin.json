{
  "schemaVersion": 2,
  "id": "examples.bundled-first-party",
  "version": "0.1.0",
  "displayName": "Bundled First-Party Example",
  "description": "Bundled first-party agent-runtime example with domain-organized topology.",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1
  },
  "uses": [
    "agents"
  ],
  "entrypoints": {
    "main": "./agent/daemon.mjs"
  },
  "permissions": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "agents": [
      {
        "kindVersion": 1,
        "id": "examples.bundled.backend",
        "display": {
          "name": "Bundled Example Agent",
          "tags": [
            "bundled",
            "first-party"
          ]
        },
        "ownedBackendIds": [
          "examples.bundled.backend"
        ],
        "catalogAgentId": "claude",
        "runtime": {
          "kind": "custom"
        },
        "capabilities": {},
        "target": {
          "sourceKind": "first_party",
          "id": "examples.bundled-first-party"
        },
        "surfaceHandlers": [
          {
            "id": "backend.terminalRuntime.launch",
            "kind": "terminalRuntime",
            "operation": "launch",
            "handler": {
              "target": "daemon",
              "exportName": "launch"
            }
          },
          {
            "id": "backend.terminalRuntime.discoverIdentity",
            "kind": "terminalRuntime",
            "operation": "discoverIdentity",
            "handler": {
              "target": "daemon",
              "exportName": "discoverIdentity"
            }
          }
        ]
      }
    ]
  }
}
