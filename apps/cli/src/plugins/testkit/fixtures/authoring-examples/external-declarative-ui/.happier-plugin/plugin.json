{
  "schemaVersion": 2,
  "id": "examples.external-declarative-ui",
  "version": "0.1.0",
  "displayName": "External Declarative UI Example",
  "description": "External extension with declarative UI descriptor + resource contributions (no agent runtime).",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1
  },
  "uses": [
    "resources",
    "uiDescriptors"
  ],
  "entrypoints": {
    "main": "./daemon.mjs"
  },
  "permissions": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "resources": [
      {
        "id": "examples.external.ui.prompt",
        "resourceKind": "prompt",
        "path": "./ui/resources/review-prompt.md",
        "digest": "sha256:external-declarative-ui-review-prompt",
        "contentType": "text/markdown"
      }
    ],
    "uiDescriptors": [
      {
        "id": "examples.external.ui.settings",
        "surface": "settings",
        "title": "External Declarative UI",
        "description": "Host-rendered settings contributed declaratively through the manifest.",
        "fields": [
          {
            "id": "enabled",
            "type": "boolean",
            "title": "Enabled",
            "options": []
          },
          {
            "id": "profile",
            "type": "select",
            "title": "Profile",
            "options": [
              {
                "value": "fast",
                "label": "Fast"
              },
              {
                "value": "safe",
                "label": "Safe"
              }
            ]
          }
        ]
      }
    ]
  }
}
