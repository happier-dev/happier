{
  "schemaVersion": 2,
  "id": "examples.provider-backend-plugin",
  "version": "0.1.0",
  "displayName": "Provider Backend Example",
  "description": "Provider/backend example with daemon runtime adapter handlers.",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1,
    "capabilities": [
      "agents",
      "backends"
    ]
  },
  "targets": {
    "daemon": {
      "entry": "./agent/daemon.mjs"
    }
  },
  "capabilities": {
    "permissions": []
  },
  "contributes": {
    "agents": [
      {
        "kindVersion": 1,
        "id": "examples.provider",
        "display": {
          "name": "Examples Provider",
          "tags": [
            "plugin"
          ]
        },
        "ownedBackendIds": [
          "examples.provider.backend"
        ],
        "catalogAgentId": "claude"
      }
    ],
    "backends": [
      {
        "kindVersion": 1,
        "id": "examples.provider.backend",
        "capabilities": {},
        "agentId": "examples.provider",
        "surfaceHandlers": [
          {
            "id": "backend.terminalRuntime.launch",
            "kind": "terminalRuntime",
            "operation": "launch",
            "handler": {
              "target": "daemon",
              "exportName": "launch"
            }
          },
          {
            "id": "backend.terminalRuntime.discoverIdentity",
            "kind": "terminalRuntime",
            "operation": "discoverIdentity",
            "handler": {
              "target": "daemon",
              "exportName": "discoverIdentity"
            }
          }
        ],
        "engine": {
          "kind": "custom"
        }
      }
    ]
  }
}
