{
  "schemaVersion": 2,
  "id": "examples.reload-helper-plugin",
  "version": "0.1.0",
  "displayName": "Reload Helper Example",
  "description": "Activation-time example that is intended to be edited and reloaded locally.",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1
  },
  "entrypoints": {
    "daemon": "./agent/daemon.mjs"
  },
  "activation": {
    "events": [
      {
        "kind": "startup"
      }
    ]
  },
  "hostAccess": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "actions": [
      {
        "id": "reload-report",
        "title": "Report Reload Timestamp",
        "description": "Returns activation-time data so you can verify happier plugins reload.",
        "scopes": [
          "global"
        ],
        "surfaces": [
          "cli"
        ],
        "placement": "commandPalette",
        "dangerLevel": "safe",
        "execution": {
          "target": "daemon"
        },
        "resultSchema": {
          "type": "object",
          "required": [
            "activatedAtMs"
          ],
          "properties": {
            "activatedAtMs": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      }
    ]
  }
}
