{
  "schemaVersion": 2,
  "id": "examples.reload-helper-plugin",
  "version": "0.1.0",
  "displayName": "Reload Helper Example",
  "description": "Activation-time example that is intended to be edited and reloaded locally.",
  "engines": {
    "happier": "^0.2.0"
  },
  "uses": [
    "actions"
  ],
  "entrypoints": {
    "main": "./agent/daemon.mjs"
  },
  "permissions": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "actions": [
      {
        "id": "examples.reload.report",
        "title": "Report Reload Timestamp",
        "description": "Returns activation-time data so you can verify happier plugins reload.",
        "scopes": [
          "global"
        ],
        "surfaces": [
          "cli"
        ],
        "placement": "commandPalette",
        "dangerLevel": "safe",
        "resultSchema": {
          "type": "object",
          "required": [
            "activatedAtMs"
          ],
          "properties": {
            "activatedAtMs": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "handler": {
          "target": "daemon",
          "registrationId": "examples.reload.report"
        }
      }
    ]
  }
}
