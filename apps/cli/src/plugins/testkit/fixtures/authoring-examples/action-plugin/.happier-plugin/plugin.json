{
  "schemaVersion": 2,
  "id": "examples.action-plugin",
  "version": "0.1.0",
  "displayName": "Action Plugin Example",
  "description": "Static manifest action example for local plugin authoring.",
  "engines": {
    "happier": "^0.2.0"
  },
  "uses": [
    "actions"
  ],
  "entrypoints": {
    "main": "./agent/daemon.mjs"
  },
  "permissions": {
    "required": [],
    "optional": []
  },
  "contributes": {
    "actions": [
      {
        "id": "examples.action.echo",
        "title": "Echo Example Action",
        "description": "Returns the action request payload from plugin code.",
        "scopes": [
          "global"
        ],
        "surfaces": [
          "cli",
          "agent"
        ],
        "placement": "commandPalette",
        "dangerLevel": "safe",
        "inputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "handler": {
          "target": "daemon",
          "exportName": "executeAction"
        }
      }
    ]
  }
}
