{
  "schemaVersion": 2,
  "id": "examples.ui-descriptor-plugin",
  "version": "0.1.0",
  "displayName": "UI Descriptor Example",
  "description": "Activation-time resource and host-rendered descriptor example.",
  "engines": {
    "happier": "^0.2.0"
  },
  "runtime": {
    "apiVersion": 1,
    "capabilities": [
      "resources",
      "uiDescriptors"
    ]
  },
  "permissions": [
    {
      "capability": "resources.register",
      "reason": "Register the example prompt resource during plugin activation."
    },
    {
      "capability": "ui.descriptors",
      "reason": "Register the example settings descriptor during plugin activation."
    }
  ],
  "targets": {
    "daemon": {
      "entry": "./agent/daemon.mjs"
    }
  },
  "contributions": []
}
