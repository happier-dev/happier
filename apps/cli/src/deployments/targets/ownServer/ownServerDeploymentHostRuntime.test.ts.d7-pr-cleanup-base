                    const controller = new AbortController();
                    let ready!: () => void;
                    const started = new Promise<void>(resolve => { ready = resolve; });
                    const redaction = createProviderRedactionLease({ values: material.secretValues });
                    const running = acquired.nativeIo.run({ command: process.execPath,
                        args: ['-e', 'require("node:fs").accessSync(require("node:path").join(process.env.DOCKER_CONFIG,"config.json"));process.stdout.write("ready");setInterval(()=>{},1000)'],
                        cwd: registryDirectory, env: material.env, signal: controller.signal,
                        output: { redaction, onChunk(_stream, chunk) { if (Buffer.from(chunk).toString().includes('ready')) ready(); } } });
                    const stopped = expect(running).rejects.toMatchObject({ code: 'plugin_exec_aborted' });
                    try {
                        await started;
                        let released = false;
