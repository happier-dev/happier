// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider        = "prisma-client-js"
    // Include cross-compiled query engines so release artifacts can run on all published server targets.
    binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "darwin", "darwin-arm64", "windows"]
    previewFeatures = ["metrics", "relationJoins"]
}

generator json {
    provider = "prisma-json-types-generator"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// Account
//

model Account {
    id              String      @id @default(cuid())
    publicKey       String?     @unique
    /// X25519 (NaCl box) public key for encrypting session DEKs to this account
    contentPublicKey Bytes?
    /// Ed25519 signature binding contentPublicKey to publicKey
    contentPublicKeySig Bytes?
    seq             Int         @default(0)
    /// Minimum cursor a client must have for `/v2/changes?after=...` to be considered reliable.
    /// When we prune orphaned AccountChange rows (e.g. for deleted sessions), we bump this floor so
    /// very old clients are forced to do a snapshot rebuild instead of missing deletion signals.
    changesFloor     Int        @default(0)
    feedSeq         BigInt      @default(0)
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt
    settings        String?
    settingsVersion Int         @default(0)
    encryptionMode  String      @default("e2ee")
    encryptionModeUpdatedAt DateTime @default(now())

    // Profile
    firstName String?
    lastName  String?
    username  String? @unique
    /// [ImageRef]
    avatar    Json?

    Session                Session[]
    AccountPushToken       AccountPushToken[]
    AccountLiveActivityTarget AccountLiveActivityTarget[]
    VoiceSessionLease      VoiceSessionLease[]
    VoiceConversation      VoiceConversation[]
    TerminalAuthRequest    TerminalAuthRequest[]
    AccountAuthRequest     AccountAuthRequest[]
    AuthPairingSession     AuthPairingSession[]
    UsageReport            UsageReport[]
    UsageEvent             UsageEvent[]
    Machine                Machine[]
    UploadedFile           UploadedFile[]
    AccountPetPackage      AccountPetPackage[]
    AccountPetAsset        AccountPetAsset[]
    ServiceAccountToken    ServiceAccountToken[]
    ServiceAccountQuotaSnapshot ServiceAccountQuotaSnapshot[]
    ConnectedServiceAuthGroup ConnectedServiceAuthGroup[]
    RelationshipsFrom      UserRelationship[]         @relation("RelationshipsFrom")
    RelationshipsTo        UserRelationship[]         @relation("RelationshipsTo")
    Artifact               Artifact[]
    AccessKey              AccessKey[]
    UserFeedItem           UserFeedItem[]
    UserKVStore            UserKVStore[]
    SharedBySessions       SessionShare[]             @relation("SharedBySessions")
    SharedWithSessions     SessionShare[]             @relation("SharedWithSessions")
    SessionShareAccessLogs SessionShareAccessLog[]    @relation("SessionShareAccessLogs")
    PublicSessionShares    PublicSessionShare[]       @relation("PublicSessionShares")
    PublicShareAccessLogs  PublicShareAccessLog[]     @relation("PublicShareAccessLogs")
    PublicShareBlockedUsers PublicShareBlockedUser[]  @relation("PublicShareBlockedUsers")
    AccountChanges         AccountChange[]
    AccountSettingsSnapshots AccountSettingsSnapshot[]
    SessionPendingMessage  SessionPendingMessage[]
    SessionSystemRecord    SessionSystemRecord[]
    ReviewComments         ReviewComment[]
    ReviewCommentEvents    ReviewCommentEvent[]
    PluginPermissionGrants PluginPermissionGrant[]
    PluginPermissionGrantRequests PluginPermissionGrantRequest[]
    PluginPermissionGrantEvents PluginPermissionGrantEvent[]
    PluginManifestProjections AccountPluginManifestProjection[]
    AccountIdentity        AccountIdentity[]
    automations            Automation[]
    automationRuns         AutomationRun[]
    SessionFolderAssignment SessionFolderAssignment[]
}

model AccountSettingsSnapshot {
    id              String   @id @default(cuid())
    accountId       String
    version         Int
    settingsDbValue String?
    encryptionMode  String
    contentKind     String
    createdAt       DateTime @default(now())

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@unique([accountId, version])
    @@index([accountId, version])
    @@index([createdAt])
}

enum AccountIdentityEligibilityStatus {
    unknown
    eligible
    ineligible
}

model AccountIdentity {
    id             String   @id @default(cuid())
    accountId      String
    account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    provider       String
    providerUserId String
    providerLogin  String?
    profile        Json?
    token          Bytes?
    scopes         String?
    showOnProfile  Boolean  @default(true)

    eligibilityStatus      AccountIdentityEligibilityStatus @default(unknown)
    eligibilityReason      String?
    eligibilityCheckedAt   DateTime?
    eligibilityNextCheckAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([provider, providerUserId])
    @@unique([accountId, provider])
    @@index([accountId])
}

model VoiceSessionLease {
    id               String   @id @default(cuid())
    accountId        String
    account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    conversation     VoiceConversation?

    /// Optional Happier sessionId (used only for correlation/telemetry).
    sessionId        String?

    /// UTC YYYY-MM (e.g. "2026-02") for monthly free-quota accounting.
    periodKey        String

    /// "subscription" | "free" (string for forward/backward compatibility).
    grantedBy        String

    /// The ElevenLabs agent id used for minting.
    elevenLabsAgentId String

    expiresAt        DateTime
    createdAt        DateTime @default(now())

    @@index([accountId, expiresAt])
    @@index([accountId, periodKey])
    @@index([expiresAt])
}

model VoiceConversation {
    id                    String   @id @default(cuid())
    accountId             String
    account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    /// Lifecycle: persisted on completion only (durationSeconds is required).
    /// Optional lease reference (leases may be pruned; conversations should remain).
    leaseId               String?  @unique
    lease                 VoiceSessionLease? @relation(fields: [leaseId], references: [id], onDelete: SetNull)

    /// Provider id, e.g. "elevenlabs_agents".
    providerId            String

    /// Provider-specific conversation id.
    providerConversationId String

    startedAt             DateTime?
    endedAt               DateTime?
    durationSeconds       Int

    /// Optional normalized billing unit count (provider-specific).
    billedUnits           Int?

    createdAt             DateTime @default(now())

    @@unique([providerId, providerConversationId])
    @@index([accountId, createdAt])
    @@index([accountId, providerId, createdAt])
}

model AccountChange {
    accountId String
    kind      String
    entityId  String

    /// Account-scoped monotonic cursor (from Account.seq).
    /// Each row update should get a unique new cursor value for pagination safety.
    cursor    Int
    changedAt DateTime @default(now())
    hint      Json?

    /// Nullable, entity-specific foreign keys used to detect orphaned changes in a database-portable way.
    /// When the target entity is deleted, these are set to NULL via ON DELETE SET NULL.
    sessionId  String?
    machineId  String?
    artifactId String?
    accountPetPackageId String?

    session  Session?  @relation("AccountChangeSession", fields: [sessionId], references: [id], onDelete: SetNull)
    machine  Machine?  @relation("AccountChangeMachine", fields: [machineId], references: [id], onDelete: SetNull)
    artifact Artifact? @relation("AccountChangeArtifact", fields: [artifactId], references: [id], onDelete: SetNull)
    accountPetPackage AccountPetPackage? @relation("AccountChangeAccountPetPackage", fields: [accountPetPackageId], references: [id], onDelete: SetNull)

    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@id([accountId, kind, entityId])
    @@index([accountId, cursor])
    @@index([changedAt(sort: Asc), accountId, cursor])
}

model TerminalAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    supportsV2        Boolean  @default(false)
    claimSecretHash   String?
    claimedAt         DateTime?
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([updatedAt])
}

model AccountAuthRequest {
    id                String   @id @default(cuid())
    publicKey         String   @unique
    response          String?
    responseAccountId String?
    responseAccount   Account? @relation(fields: [responseAccountId], references: [id])
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([updatedAt])
}

model AuthPairingSession {
    id                 String   @id @default(cuid())
    accountId           String
    account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    secretHash          String
    requestedPublicKey  String?
    requestedDeviceLabel String?
    requestedAt         DateTime?
    expiresAt           DateTime
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([accountId, expiresAt])
    @@index([expiresAt])
}

model AccountPushToken {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    token     String
    clientServerUrl String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, token])
}

model AccountLiveActivityTarget {
    id                  String   @id @default(cuid())
    accountId           String
    account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    deviceId            String
    serverId            String
    sessionId           String
    activityInstanceKey String
    activityId          String
    activityName        String
    targetIdentityHash  String
    transportMode       String
    bundleId            String?
    environment         String?
    tokenKind           String
    rawTokenEncrypted   Bytes?
    expoPushToken       String?
    clientServerUrl     String?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    endedAt             DateTime?
    lastPushedAt        DateTime?
    lastPayloadHash     String?
    failureCount        Int      @default(0)
    lastFailureCode     String?
    diagnostics         Json?

    @@unique([accountId, targetIdentityHash])
    @@index([accountId, serverId, sessionId, activityName, endedAt])
    @@index([accountId, transportMode, endedAt])
}

//
// Sessions
//

model Session {
    id                String              @id @default(cuid())
    tag               String
    accountId         String
    account           Account             @relation(fields: [accountId], references: [id])
    encryptionMode    String              @default("e2ee")
    metadata          String
    metadataVersion   Int                 @default(0)
    agentState        String?
    agentStateVersion Int                 @default(0)
    dataEncryptionKey Bytes?
    seq               Int                 @default(0)
    pendingVersion    Int                 @default(0)
    pendingCount      Int                 @default(0)
    pendingQueueSeq   Int                 @default(0)
    // Server-readable per-session activity projection (minimal, E2EE-safe).
    // These fields exist to support authoritative badge counts for background/closed devices.
    lastViewedSessionSeq            Int?
    pendingPermissionRequestCount   Int                 @default(0)
    pendingUserActionRequestCount   Int                 @default(0)
    pendingRequestObservedAt        DateTime?
    latestTurnId                    String?
    latestTurnStatus                String?
    latestTurnStatusObservedAt      BigInt?
    lastRuntimeIssue                String?
    latestReadyEventSeq             Int?
    latestReadyEventAt              DateTime?
    thinking                        Boolean             @default(false)
    thinkingAt                      DateTime?
    active            Boolean             @default(true)
    archivedAt        DateTime?
    lastActiveAt      DateTime            @default(now())
    meaningfulActivityAt DateTime?
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt
    messages          SessionMessage[]
    turns             SessionTurn[]
    turnMutationReceipts SessionTurnMutationReceipt[]
    pendingMessages   SessionPendingMessage[]
    usageReports      UsageReport[]
    usageEvents       UsageEvent[]
    accessKeys        AccessKey[]
    shares            SessionShare[]
    publicShare       PublicSessionShare?
    sessionFolderAssignments SessionFolderAssignment[]
    systemRecords    SessionSystemRecord[]
    accountChanges    AccountChange[]    @relation("AccountChangeSession")
    producedByAutomationRuns AutomationRun[] @relation("AutomationRunProducedSession")

    @@unique([accountId, tag])
    @@index([accountId, updatedAt(sort: Desc)])
    @@index([accountId, meaningfulActivityAt(sort: Desc), id(sort: Desc)])
    @@index([accountId, archivedAt(sort: Desc)])
    @@index([lastActiveAt(sort: Asc), updatedAt(sort: Asc)])
}

model SessionTurn {
    id                      String   @id @default(cuid())
    sessionId               String
    session                 Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    turnId                  String
    provider                String?
    providerTurnId          String?
    status                  String
    startedAt               BigInt
    updatedAt               BigInt
    terminalAt              BigInt?
    lastRuntimeIssueJson    String?
    transcriptAnchorsJson   String?
    rollbackState           String?
    rollbackReason          String?
    providerRollbackOrdinal Int?
    rollbackUpdatedAt       BigInt?
    lastMutationId          String?
    createdAt               DateTime @default(now())

    @@unique([sessionId, turnId])
    @@index([sessionId, updatedAt])
    @@index([sessionId, status])
    @@index([sessionId, rollbackState])
    @@index([sessionId, provider, providerTurnId])
}

model SessionTurnMutationReceipt {
    id         String   @id @default(cuid())
    sessionId  String
    session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    mutationId String
    turnId     String?
    action     String
    decision   String
    observedAt BigInt
    appliedAt  BigInt
    createdAt  DateTime @default(now())

    @@unique([sessionId, mutationId])
    @@index([sessionId, appliedAt])
}

model SessionFolderAssignment {
    id        String   @id @default(cuid())
    accountId String
    sessionId String
    folderId  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([accountId, sessionId])
    @@index([accountId, folderId, updatedAt])
    @@index([sessionId])
}

model SessionSystemRecord {
    id        String   @id @default(cuid())
    accountId String
    sessionId String
    namespace String
    kind      String
    localId   String
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@unique([accountId, sessionId, namespace, localId])
    @@index([accountId, sessionId, namespace, kind, updatedAt(sort: Desc), id(sort: Desc)])
    @@index([sessionId, namespace, kind, updatedAt(sort: Desc), id(sort: Desc)])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    sidechainId String?
    seq       Int
    messageRole String?
    /// [SessionMessageContent]
    content   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // `localId` is a session-global idempotency key (unique across sidechains within a session).
    @@unique([sessionId, localId])
    @@index([sessionId, seq])
    @@index([sessionId, sidechainId, seq])
    @@index([sessionId, messageRole, seq])
    @@index([sessionId, sidechainId, messageRole, seq])
}

enum SessionPendingMessageStatus {
    queued
    discarded
}

model SessionPendingMessage {
    id              String                     @id @default(cuid())
    sessionId        String
    session          Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    /// Informational only (attribution); pending queue is session-global.
    authorAccountId  String?
    authorAccount    Account?                   @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)

    localId          String
    messageRole      String?
    /// [SessionPendingMessageContent]
    content          Json
    status           SessionPendingMessageStatus @default(queued)
    position         Int
    discardedAt      DateTime?
    discardedReason  String?
    createdAt        DateTime                   @default(now())
    updatedAt        DateTime                   @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, status, position])
    @@index([sessionId, authorAccountId])
    @@index([sessionId, status, updatedAt])
}

model GithubOrganization {
    id        String   @id
    /// [GitHubOrg]
    profile   Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Utility
//

model GlobalLock {
    key       String   @id @default(cuid())
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    expiresAt DateTime

    @@index([expiresAt])
}

model RepeatKey {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    expiresAt DateTime

    @@index([expiresAt])
}

model SimpleCache {
    key       String   @id
    value     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//
// Usage Reporting
//

model UsageReport {
    id        String   @id @default(cuid())
    key       String
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    sessionId String?
    session   Session? @relation(fields: [sessionId], references: [id])
    /// [UsageReportData]
    data      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, sessionId, key])
    @@index([accountId])
    @@index([sessionId])
}

model UsageEvent {
    id                 String   @id @default(cuid())
    accountId          String
    account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sessionId          String?
    session            Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
    observedAt         DateTime
    providerId         String
    backendMode        String?
    modelId            String?
    projectKey         String?
    workspaceId        String?
    machineId          String?
    source             String
    scope              String
    externalKey        String?
    idempotencyKey     String?  @unique
    turnId             String?
    isCumulative       Boolean  @default(false)
    inputTokens        Int      @default(0)
    outputTokens       Int      @default(0)
    reasoningTokens    Int      @default(0)
    cacheReadTokens    Int      @default(0)
    cacheWriteTokens   Int      @default(0)
    totalTokens        Int      @default(0)
    reportedCostUsd    Float    @default(0)
    estimatedCostUsd   Float    @default(0)
    invoiceCostUsd     Float    @default(0)
    billingContext     String?
    costSource         String?
    currency           String   @default("USD")
    contextUsedTokens  Int?
    contextWindowTokens Int?
    metadata           Json?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([accountId, observedAt(sort: Desc)])
    @@index([sessionId, observedAt(sort: Desc)])
    @@index([accountId, providerId, observedAt(sort: Desc)])
    @@index([accountId, modelId, observedAt(sort: Desc)])
    @@index([accountId, projectKey, observedAt(sort: Desc)])
    @@index([accountId, workspaceId, observedAt(sort: Desc)])
    @@index([accountId, source, observedAt(sort: Desc)])
    @@index([accountId, sessionId, source, externalKey])
}

//
// Machines
//

model Machine {
    id                 String      @id
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    dataEncryptionKey  Bytes?
    installationId     String?
    installationPublicKey Bytes?
    contentPublicKeyFingerprint String?
    replacedByMachineId String?
    replacedAt         DateTime?
    replacementReason  String?
    replacementSource  String?
    replacementActorUserId String?
    seq                Int         @default(0)
    active             Boolean     @default(true)
    lastActiveAt       DateTime    @default(now())
    revokedAt          DateTime?
    createdAt          DateTime    @default(now())
    updatedAt          DateTime    @updatedAt
    accessKeys         AccessKey[]
    accountChanges     AccountChange[] @relation("AccountChangeMachine")
    automationAssignments AutomationAssignment[]
    automationClaimedRuns AutomationRun[] @relation("AutomationRunClaimedByMachine")
    pluginManifestProjections AccountPluginManifestProjection[]

    @@unique([accountId, id])
    @@index([accountId])
    @@index([accountId, installationId])
    @@index([accountId, replacedByMachineId])
    @@index([accountId, replacedAt(sort: Desc)])
    @@index([accountId, revokedAt(sort: Desc)])
}

enum AutomationScheduleKind {
    cron
    interval
}

enum AutomationTargetType {
    new_session
    existing_session
}

enum AutomationRunState {
    queued
    claimed
    running
    succeeded
    failed
    cancelled
    expired
}

model Automation {
    id               String                 @id @default(cuid())
    accountId        String
    account          Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
    name             String
    description      String?
    enabled          Boolean                @default(true)
    scheduleKind     AutomationScheduleKind
    scheduleExpr     String?
    everyMs          Int?
    timezone         String?
    targetType       AutomationTargetType
    templateCiphertext String
    templateVersion  Int                    @default(0)
    nextRunAt        DateTime?
    lastRunAt        DateTime?
    createdAt        DateTime               @default(now())
    updatedAt        DateTime               @updatedAt
    assignments      AutomationAssignment[]
    runs             AutomationRun[]

    @@index([accountId, enabled, updatedAt(sort: Desc)])
    @@index([accountId, nextRunAt])
}

model AutomationAssignment {
    id           String      @id @default(cuid())
    automationId String
    automation   Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
    machineId    String
    machine      Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
    enabled      Boolean     @default(true)
    priority     Int         @default(0)
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    @@unique([automationId, machineId])
    @@index([machineId, enabled])
    @@index([automationId, enabled])
}

model AutomationRun {
    id                 String             @id @default(cuid())
    automationId       String
    automation         Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
    accountId          String
    account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
    state              AutomationRunState @default(queued)
    scheduledAt        DateTime
    dueAt              DateTime
    claimedAt          DateTime?
    startedAt          DateTime?
    finishedAt         DateTime?
    claimedByMachineId String?
    claimedByMachine   Machine?           @relation("AutomationRunClaimedByMachine", fields: [claimedByMachineId], references: [id], onDelete: SetNull)
    leaseExpiresAt     DateTime?
    attempt            Int                @default(0)
    summaryCiphertext  String?
    errorCode          String?
    errorMessage       String?
    producedSessionId  String?
    producedSession    Session?           @relation("AutomationRunProducedSession", fields: [producedSessionId], references: [id], onDelete: SetNull)
    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
    events             AutomationRunEvent[]

    @@index([accountId, state, dueAt])
    @@index([automationId, dueAt])
    @@index([claimedByMachineId, leaseExpiresAt])
    @@index([state, finishedAt])
}

model AutomationRunEvent {
    id        String        @id @default(cuid())
    runId     String
    run       AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
    ts        DateTime      @default(now())
    type      String
    payload   Json?

    @@index([runId, ts])
    @@index([ts])
}

model UploadedFile {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id])
    path      String
    width     Int?
    height    Int?
    thumbhash String?
    reuseKey  String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, path])
    @@index([accountId])
}

model AccountPetPackage {
    id            String   @id
    accountId     String
    account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    packageFormat String
    contentMode   String   @default("plain")
    manifest      Json
    digest        String
    sizeBytes     Int
    origin        Json
    version       Int      @default(1)
    deletedAt     DateTime?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    assets         AccountPetAsset[]
    accountChanges AccountChange[] @relation("AccountChangeAccountPetPackage")

    @@unique([accountId, id])
    @@index([accountId, deletedAt, updatedAt(sort: Desc)])
    @@index([accountId, digest])
}

model AccountPetAsset {
    id            String            @id
    accountId     String
    account       Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
    petPackageId String
    petPackage   AccountPetPackage @relation(fields: [accountId, petPackageId], references: [accountId, id], onDelete: Cascade)
    contentMode   String            @default("plain")
    storageKind   String
    objectKey     String
    byteLength    Int
    mediaType     String
    digest        String
    createdAt     DateTime          @default(now())
    updatedAt     DateTime          @updatedAt

    @@unique([accountId, objectKey])
    @@index([accountId])
    @@index([accountId, petPackageId])
    @@index([petPackageId])
}

model ServiceAccountToken {
    id         String    @id @default(cuid())
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    vendor     String
    profileId  String    @default("default")
    token      Bytes // Encrypted token
    metadata   Json? // Optional vendor metadata
    expiresAt  DateTime?
    refreshLeaseOwnerMachineId String?
    refreshLeaseExpiresAt      DateTime?
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    members    ConnectedServiceAuthGroupMember[]

    @@unique([accountId, vendor, profileId])
    @@index([accountId])
}

model ServiceAccountQuotaSnapshot {
    id         String    @id @default(cuid())
    accountId  String
    account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
    vendor     String
    profileId  String    @default("default")
    snapshot   Bytes
    status     String?
    fetchedAt  DateTime?
    staleAfterMs Int?
    metadata   Json?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    @@unique([accountId, vendor, profileId])
    @@index([accountId])
}

model ConnectedServiceAuthGroup {
    id              String   @id @default(cuid())
    accountId       String
    vendor          String
    groupId         String
    displayName     String?
    policyJson      String
    activeProfileId String?
    generation      Int      @default(0)
    stateJson       String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    members ConnectedServiceAuthGroupMember[]

    @@unique([accountId, vendor, groupId])
    @@index([accountId, vendor])
}

model ConnectedServiceAuthGroupMember {
    id        String   @id @default(cuid())
    groupDbId String
    accountId String
    vendor    String
    groupId   String
    profileId String
    priority  Int      @default(100)
    enabled   Boolean  @default(true)
    stateJson String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    group      ConnectedServiceAuthGroup @relation(fields: [groupDbId], references: [id], onDelete: Cascade)
    credential ServiceAccountToken @relation(fields: [accountId, vendor, profileId], references: [accountId, vendor, profileId], onDelete: Cascade)

    @@unique([accountId, vendor, groupId, profileId])
    @@index([groupDbId])
    @@index([accountId, vendor, profileId])
}

//
// Artifacts
//

model Artifact {
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes // Encrypted body
    bodyVersion       Int      @default(0)
    dataEncryptionKey Bytes // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
    accountChanges    AccountChange[] @relation("AccountChangeArtifact")

    @@index([accountId])
    @@index([accountId, updatedAt(sort: Desc)])
}

//
// Access Keys
//

model AccessKey {
    id          String   @id @default(cuid())
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    machineId   String
    machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id])
    data        String // Encrypted data
    dataVersion Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([accountId, machineId, sessionId])
    @@index([accountId])
    @@index([sessionId])
    @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
    none
    requested
    pending
    friend
    rejected
}

model UserRelationship {
    fromUserId     String
    fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
    toUserId       String
    toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
    status         RelationshipStatus @default(pending)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    acceptedAt     DateTime?
    lastNotifiedAt DateTime?

    @@id([fromUserId, toUserId])
    @@index([toUserId, status])
    @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
    id        String   @id @default(cuid())
    userId    String
    user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
    counter   BigInt
    repeatKey String?
    /// [FeedBody]
    body      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, counter])
    @@unique([userId, repeatKey])
    @@index([userId, counter(sort: Desc)])
    @@index([createdAt])
}

//
// Key-Value Storage
//

model UserKVStore {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    key       String   // Unencrypted for indexing
    value     Bytes?   // Encrypted value, null when "deleted"
    version   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, key])
    @@index([accountId])
}

//
// Review Comments
//

model ReviewComment {
    id                   String   @id
    accountId            String   @map("account_id")
    projectId            String   @map("project_id")
    workspaceId          String?  @map("workspace_id")
    sessionId            String?  @map("session_id")
    runId                String?  @map("run_id")
    engineId             String?  @map("engine_id")
    findingId            String?  @map("finding_id")
    threadId             String   @map("thread_id")
    parentCommentId      String?  @map("parent_comment_id")
    state                String
    flagsJson            String   @map("flags_json")
    anchorJson           String   @map("anchor_json")
    anchorFilePath       String?  @map("anchor_file_path")
    anchorFolderPath     String?  @map("anchor_folder_path")
    snapshotEnvelopeJson String   @map("snapshot_envelope_json")
    bodyEnvelopeJson     String   @map("body_envelope_json")
    bodyVersion          Int      @map("body_version")
    authorJson           String   @map("author_json")
    editsJson            String   @map("edits_json")
    dispositionsJson     String   @map("dispositions_json")
    evidenceJson         String?  @map("evidence_json")
    transitionsJson      String   @map("transitions_json")
    fingerprintJson      String?  @map("fingerprint_json")
    linkedRefsJson       String?  @map("linked_refs_json")
    suggestedFixJson     String?  @map("suggested_fix_json")
    metadataJson         String?  @map("metadata_json")
    tombstoneJson        String?  @map("tombstone_json")
    serverRevision       Int      @map("server_revision")
    createdAt            BigInt   @map("created_at")
    updatedAt            BigInt   @map("updated_at")

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    events  ReviewCommentEvent[]

    @@index([projectId, state, updatedAt])
    @@index([projectId, runId, updatedAt])
    @@index([projectId, engineId, updatedAt])
    @@index([projectId, anchorFilePath, updatedAt])
    @@map("review_comments")
}

model ReviewCommentEvent {
    eventId           String   @id @map("event_id")
    commentId         String   @map("comment_id")
    accountId         String   @map("account_id")
    projectId         String   @map("project_id")
    eventKind         String   @map("event_kind")
    eventEnvelopeJson String   @map("event_envelope_json")
    bulkActionId      String?  @map("bulk_action_id")
    clientMutationId  String?  @map("client_mutation_id")
    actorJson         String   @map("actor_json")
    authorDeviceId    String?  @map("author_device_id")
    clientLamport     BigInt?  @map("client_lamport")
    serverRevision    Int      @map("server_revision")
    createdAt         BigInt   @map("created_at")

    account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
    comment ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

    @@index([commentId, serverRevision])
    @@index([accountId, projectId, createdAt])
    @@map("review_comment_events")
}

//
// Plugin Permission Grants
//

model PluginPermissionGrant {
    id                String  @id
    accountId         String  @map("account_id")
    pluginId          String  @map("plugin_id")
    capability        String
    scopeKind         String  @map("scope_kind")
    scopeProjectId    String? @map("scope_project_id")
    scopeWorkspaceId  String? @map("scope_workspace_id")
    authorityKind     String  @default("bundled") @map("authority_kind")
    authorityMachineId String? @map("authority_machine_id")
    authorityInstallationId String? @map("authority_installation_id")
    status            String
    activeIdentityKey String? @map("active_identity_key")
    requestId         String? @map("request_id")
    grantedByUserId   String  @map("granted_by_user_id")
    grantedAt         BigInt  @map("granted_at")
    revokedByUserId   String? @map("revoked_by_user_id")
    revokedAt         BigInt? @map("revoked_at")
    createdAt         BigInt  @map("created_at")
    updatedAt         BigInt  @map("updated_at")

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@index([accountId, pluginId, capability, scopeKind, scopeProjectId, scopeWorkspaceId, authorityKind, authorityMachineId, authorityInstallationId, status, updatedAt], map: "plugin_permission_grants_scope_idx")
    @@index([accountId, requestId], map: "plugin_permission_grants_request_idx")
    @@unique([accountId, activeIdentityKey], map: "plugin_permission_grants_active_identity_key")
    @@map("plugin_permission_grants")
}

model PluginPermissionGrantRequest {
    id                String  @id
    accountId         String  @map("account_id")
    pluginId          String  @map("plugin_id")
    capability        String
    scopeKind         String  @map("scope_kind")
    scopeProjectId    String? @map("scope_project_id")
    scopeWorkspaceId  String? @map("scope_workspace_id")
    authorityKind     String  @default("bundled") @map("authority_kind")
    authorityMachineId String? @map("authority_machine_id")
    authorityInstallationId String? @map("authority_installation_id")
    requesterJson     String  @map("requester_json")
    reason            String
    status            String
    grantId           String? @map("grant_id")
    createdByUserId   String? @map("created_by_user_id")
    decidedByUserId   String? @map("decided_by_user_id")
    decidedAt         BigInt? @map("decided_at")
    createdAt         BigInt  @map("created_at")
    updatedAt         BigInt  @map("updated_at")

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@index([accountId, pluginId, capability, scopeKind, scopeProjectId, scopeWorkspaceId, authorityKind, authorityMachineId, authorityInstallationId, status, updatedAt], map: "plugin_permission_requests_scope_idx")
    @@index([accountId, grantId], map: "plugin_permission_requests_grant_idx")
    @@map("plugin_permission_grant_requests")
}

model PluginPermissionGrantEvent {
    eventId           String  @id @map("event_id")
    accountId         String  @map("account_id")
    pluginId          String  @map("plugin_id")
    capability        String
    scopeKind         String  @map("scope_kind")
    scopeProjectId    String? @map("scope_project_id")
    scopeWorkspaceId  String? @map("scope_workspace_id")
    authorityKind     String  @default("bundled") @map("authority_kind")
    authorityMachineId String? @map("authority_machine_id")
    authorityInstallationId String? @map("authority_installation_id")
    eventKind         String  @map("event_kind")
    actorJson         String  @map("actor_json")
    requestId         String? @map("request_id")
    grantId           String? @map("grant_id")
    previousStateJson String? @map("previous_state_json")
    nextStateJson     String? @map("next_state_json")
    reason            String?
    createdAt         BigInt  @map("created_at")

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@index([accountId, pluginId, capability, eventKind, createdAt], map: "plugin_permission_events_kind_idx")
    @@index([accountId, requestId], map: "plugin_permission_events_request_idx")
    @@index([accountId, grantId], map: "plugin_permission_events_grant_idx")
    @@map("plugin_permission_grant_events")
}

model AccountPluginManifestProjection {
    accountId                String  @map("account_id")
    machineId                String  @map("machine_id")
    pluginId                 String  @map("plugin_id")
    schemaVersion            Int     @map("schema_version")
    pluginVersion            String  @map("plugin_version")
    displayName              String  @map("display_name")
    manifestDigest           String  @map("manifest_digest")
    sourceJson               String? @map("source_json")
    requiredPermissionsJson  String  @map("required_permissions_json")
    optionalPermissionsJson  String  @map("optional_permissions_json")
    enabled                  Boolean @default(true)
    disabledAt               BigInt? @map("disabled_at")
    createdAt                BigInt  @map("created_at")
    updatedAt                BigInt  @map("updated_at")

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    machine Machine @relation(fields: [accountId, machineId], references: [accountId, id], onDelete: Cascade)

    @@id([accountId, machineId, pluginId])
    @@index([accountId, pluginId, enabled], map: "account_plugin_manifest_projection_plugin_lookup_idx")
    @@index([accountId, machineId, pluginId, enabled], map: "account_plugin_manifest_projection_machine_lookup_idx")
    @@index([accountId, enabled, updatedAt], map: "account_plugin_manifest_projection_list_idx")
    @@map("account_plugin_manifest_projections")
}

//
// Session Sharing
//

/// Access level for session sharing
enum ShareAccessLevel {
    /// Read-only access - can view session content but cannot interact
    view
    /// Edit access - can send messages and approve tool execution
    edit
    /// Admin access - can manage sharing settings and archive session
    admin
}

/// Direct session share between users (friend-to-friend sharing)
model SessionShare {
    id                String           @id @default(cuid())
    sessionId         String
    session           Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    sharedByUserId    String
    sharedByUser      Account          @relation("SharedBySessions", fields: [sharedByUserId], references: [id])
    sharedWithUserId  String
    sharedWithUser    Account          @relation("SharedWithSessions", fields: [sharedWithUserId], references: [id])
    accessLevel       ShareAccessLevel @default(view)
    /// Whether this recipient can approve permission prompts for this session (delegated to the owner daemon)
    canApprovePermissions Boolean       @default(false)
    /// NaCl Box encrypted dataEncryptionKey for the recipient
    encryptedDataKey  Bytes?
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    accessLogs        SessionShareAccessLog[]

    @@unique([sessionId, sharedWithUserId])
    @@index([sharedWithUserId])
    @@index([sharedByUserId])
    @@index([sessionId])
}

/// Access log for direct session shares
model SessionShareAccessLog {
    id             String       @id @default(cuid())
    sessionShareId String
    sessionShare   SessionShare @relation(fields: [sessionShareId], references: [id], onDelete: Cascade)
    userId         String
    user           Account      @relation("SessionShareAccessLogs", fields: [userId], references: [id])
    accessedAt     DateTime     @default(now())
    ipAddress      String?
    userAgent      String?

    @@index([sessionShareId])
    @@index([userId])
    @@index([accessedAt])
}

/// Public session share via shareable link (always view-only for security)
model PublicSessionShare {
    id                String                    @id @default(cuid())
    sessionId         String                    @unique
    session           Session                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    createdByUserId   String
    createdByUser     Account                   @relation("PublicSessionShares", fields: [createdByUserId], references: [id])
    /// sha256(token) (32 bytes)
    tokenHash         Bytes                     @unique
    /// Encrypted dataEncryptionKey for public access
    encryptedDataKey  Bytes?
    /// Optional expiration time (null = no expiration)
    expiresAt         DateTime?
    /// Maximum number of uses (null = unlimited)
    maxUses           Int?
    /// Current use count
    useCount          Int                       @default(0)
    /// Whether user consent is required to view (enables detailed access logging)
    isConsentRequired Boolean                   @default(false)
    createdAt         DateTime                  @default(now())
    updatedAt         DateTime                  @updatedAt
    accessLogs        PublicShareAccessLog[]
    blockedUsers      PublicShareBlockedUser[]

    @@index([tokenHash])
    @@index([sessionId])
}

/// Access log for public session shares
model PublicShareAccessLog {
    id            String             @id @default(cuid())
    publicShareId String
    publicShare   PublicSessionShare @relation(fields: [publicShareId], references: [id], onDelete: Cascade)
    /// User ID if authenticated, null for anonymous access
    userId        String?
    user          Account?           @relation("PublicShareAccessLogs", fields: [userId], references: [id])
    accessedAt    DateTime           @default(now())
    ipAddress     String?
    userAgent     String?

    @@index([publicShareId])
    @@index([userId])
    @@index([accessedAt])
}

/// Blocked users for public session shares
model PublicShareBlockedUser {
    id            String             @id @default(cuid())
    publicShareId String
    publicShare   PublicSessionShare @relation(fields: [publicShareId], references: [id], onDelete: Cascade)
    userId        String
    user          Account            @relation("PublicShareBlockedUsers", fields: [userId], references: [id])
    blockedAt     DateTime           @default(now())
    reason        String?

    @@unique([publicShareId, userId])
    @@index([publicShareId])
    @@index([userId])
}
