/// One human discussion attached to a Session. Its readers are derived live
/// from Session access: a discussion never owns an ACL, membership table,
/// encryption key, runtime, or delivery queue.
model SessionDiscussion {
    id                         String   @id @default(cuid())
    sessionId                  String
    creationLocalId            String
    creationEqualityEvidenceV1 Json
    createdByAccountId         String?
    titleContent               Json
    /// Latest assigned message sequence and the transactional allocator.
    messageSeq                 Int      @default(0)
    /// Sidebar pagination key. Deliberately denormalized so the list can order
    /// by message activity without decrypting content or being reordered by a
    /// title edit. No last-message ciphertext or preview is copied here.
    lastMessageAt              DateTime
    archivedAt                 DateTime?
    createdAt                  DateTime @default(now())
    updatedAt                  DateTime @updatedAt

    session                    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    createdByAccount           Account? @relation(fields: [createdByAccountId], references: [id], onDelete: SetNull)
    messages                   SessionDiscussionMessage[]
    readStates                 SessionDiscussionReadState[]

    @@unique([id, sessionId])
    @@unique([sessionId, creationLocalId])
    @@index([sessionId, archivedAt, lastMessageAt, id])
}

/// One immutable authored human message. `producerV1` is null for a direct
/// human post and mandatory for a post an Agent made on behalf of its
/// authenticated execution Account, which remains `authorAccountId`.
model SessionDiscussionMessage {
    id                        String   @id @default(cuid())
    /// Present only to enforce cross-Session correspondence through the
    /// composite foreign key. It is not independently writable after creation.
    sessionId                 String
    discussionId              String
    localId                   String
    requestEqualityEvidenceV1 Json
    seq                       Int
    authorAccountId           String?
    producerV1                Json?
    content                   Json
    createdAt                 DateTime @default(now())

    discussion                SessionDiscussion @relation(fields: [discussionId, sessionId], references: [id, sessionId], onDelete: Cascade)
    authorAccount             Account? @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)
    mentions                  SessionDiscussionMessageMention[]

    @@unique([discussionId, localId])
    @@unique([discussionId, seq])
    @@index([discussionId, seq])
    @@index([authorAccountId, createdAt])
}

/// "This Account was mentioned for attention." The row grants no access, implies
/// no participation, and exposes no surrounding text.
model SessionDiscussionMessageMention {
    messageId String
    accountId String
    createdAt DateTime @default(now())

    message   SessionDiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
    account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@id([messageId, accountId])
    @@index([accountId, createdAt])
}

/// One private read cursor per tracked Account. A missing row never means
/// historical unread: the tracking owner establishes the baseline before any
/// unread can accrue, and another Account's cursor is never projected.
model SessionDiscussionReadState {
    discussionId String
    accountId    String
    lastReadSeq  Int
    updatedAt    DateTime @updatedAt

    discussion   SessionDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
    account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

    @@id([discussionId, accountId])
    @@index([accountId, discussionId])
}

