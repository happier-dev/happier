    updatedAt                    DateTime @updatedAt

    providerAccountUsageRecord ProviderAccountUsageRecord @relation(fields: [accountId, providerAccountUsageRecordId], references: [accountId, recordId], onDelete: Cascade, onUpdate: Cascade, map: "csus_record_fkey")
    credential ServiceAccountToken @relation("QualifiedConnectedAccountUsageCredential", fields: [accountId, qualifiedServiceDigest, qualifiedIdentityDigest, credentialId], references: [accountId, qualifiedServiceDigest, qualifiedIdentityDigest, id], onDelete: Cascade, onUpdate: Cascade, map: "csus_credential_fkey")

    @@unique([accountId, sourceKey])
    @@index([accountId, serviceId, profileId], map: "csus_account_service_profile_idx")
    @@index([accountId, providerAccountUsageRecordId], map: "csus_record_idx")
}

model ConnectedServiceAuthGroup {
    id              String   @id @default(cuid())
    accountId       String
    /// Legacy V2/V3 compatibility shadow.
    vendor          String?
    servicePluginId String @db.LongText @map("service_plugin_id")
    serviceLocalId  String @db.LongText @map("service_local_id")
    qualifiedServiceDigest String @db.Char(64) @map("qualified_service_digest")
    qualifiedGroupDigest String @db.Char(64) @map("qualified_group_digest")
    groupId         String
    displayName     String?
    policyJson      String @db.LongText
    activeProfileId String?
    activeConnectedAccountId String? @db.LongText @map("active_connected_account_id")
    generation      Int      @default(0)
    runtimeStateRevision Int @default(0)
    stateJson       String? @db.LongText
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    members ConnectedServiceAuthGroupMember[] @relation("QualifiedConnectedAccountGroupMember")

    @@unique([accountId, vendor, groupId])
    @@unique([accountId, qualifiedGroupDigest], map: "csag_qualified_group_key")
    @@unique([accountId, qualifiedServiceDigest, qualifiedGroupDigest, id], map: "csag_qualified_group_fkey")
    @@index([accountId, vendor])
}

/// The one group incarnation that released V3 clients may mutate without
/// carrying an incarnation token. The row intentionally survives group
/// deletion so a delayed V3 write cannot target a recreated group.
model ConnectedServiceAuthGroupLegacyV3MutationFence {
    accountId                     String @map("account_id")
    qualifiedGroupDigest          String @map("qualified_group_digest")
    legacyV3EligibleIncarnation   String @map("legacy_v3_eligible_incarnation")

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "csag_legacy_v3_fence_account_fkey")

    @@id([accountId, qualifiedGroupDigest])
    @@map("connected_service_auth_group_legacy_v3_mutation_fence")
}

model ConnectedServiceAuthGroupMember {
    id        String   @id @default(cuid())
    groupDbId String
    accountId String
    credentialId String @map("credential_id")
    qualifiedServiceDigest String @db.Char(64) @map("qualified_service_digest")
    qualifiedGroupDigest String @db.Char(64) @map("qualified_group_digest")
    qualifiedIdentityDigest String @db.Char(64) @map("qualified_identity_digest")
    /// Legacy V2/V3 compatibility shadows.
    vendor    String?
    groupId   String?
    profileId String?
    priority  Int      @default(100)
    enabled   Boolean  @default(true)
    stateJson String? @db.LongText
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    group      ConnectedServiceAuthGroup @relation("QualifiedConnectedAccountGroupMember", fields: [accountId, qualifiedServiceDigest, qualifiedGroupDigest, groupDbId], references: [accountId, qualifiedServiceDigest, qualifiedGroupDigest, id], onDelete: Cascade, onUpdate: Cascade, map: "csagm_group_fkey")
    credential ServiceAccountToken @relation("QualifiedConnectedAccountMemberCredential", fields: [accountId, qualifiedServiceDigest, qualifiedIdentityDigest, credentialId], references: [accountId, qualifiedServiceDigest, qualifiedIdentityDigest, id], onDelete: Cascade, onUpdate: Cascade, map: "csagm_credential_fkey")

    @@unique([accountId, vendor, groupId, profileId], map: "csagm_account_vendor_group_profile_key")
    @@unique([groupDbId, credentialId], map: "csagm_group_credential_key")
    @@index([groupDbId])
    @@index([credentialId])
}

//
// Artifacts
//

model Artifact {
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes // Encrypted body
    bodyVersion       Int      @default(0)
    dataEncryptionKey Bytes // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
    accountChanges    AccountChange[] @relation("AccountChangeArtifact")
    pluginUiArtifact  AccountPluginUiArtifact?
    packageAssetRelease AccountPluginRelease? @relation("AccountPluginReleasePackageAsset")

    @@index([accountId])
    @@index([accountId, updatedAt])
}

//
// Account plugin availability / Artifact classification
//

/// Present-user selection and writable collection policy for one plugin on one Account.
model AccountPluginIntent {
    id                  String @db.VarChar(25)   @id @default(cuid())
    accountId           String
    account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    pluginId            String @db.VarChar(256)
    desiredVersion      String? @db.VarChar(256)
    enabled             Boolean  @default(false)
    offlineUiHosting    String   @default("disabled")
    writableCollections Json
    revision            BigInt   @default(0)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@unique([accountId, pluginId])
}

/// Immutable accepted portable release facts. Its database ID is deliberately internal;
/// public release identity remains the qualified pluginId@version coordinate.
model AccountPluginRelease {
    id                  String @db.VarChar(25)   @id @default(cuid())
    accountId           String
    account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    pluginId            String @db.VarChar(256)
    version             String @db.VarChar(256)
    archiveDigestSha256 String @db.VarChar(71)
    normalizedManifest  Json
    collectionContracts Json
    uiSlots             Json
    packageAssetArchive Json?
    packageAssetArtifactId String? @unique
    packageAssetArtifact Artifact? @relation("AccountPluginReleasePackageAsset", fields: [packageAssetArtifactId], references: [id], onDelete: Restrict)
    createdAt           DateTime @default(now())
    uiArtifacts         AccountPluginUiArtifact[]

    @@unique([accountId, pluginId, version])
}

/// The sole classification link from one generic Artifact to one immutable plugin UI slot.
model AccountPluginUiArtifact {
    id             String @db.VarChar(25)   @id @default(cuid())
    releaseId      String @db.VarChar(25)
    release        AccountPluginRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
    contributionId String @db.VarChar(256)
    tier           String @db.VarChar(32)
    platform       String @db.VarChar(16)
    artifactId     String
    artifact       Artifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)
    artifactDigest String @db.VarChar(71)
    compatibility  Json
    createdAt      DateTime @default(now())

    @@unique([releaseId, contributionId, tier, platform], map: "AccountPluginUiArtifact_release_slot_key")
    @@unique([artifactId])
}

/// Current machine installation epochs. A nullable Machine high-watermark distinguishes
/// “no snapshot yet” from a complete accepted empty inventory without a fifth snapshot row.
model PluginMachineMaterialization {
    id                String @db.VarChar(25)   @id @default(cuid())
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    serverIdentityId  String @db.VarChar(64)
    machineId         String
    machine           Machine  @relation(fields: [accountId, machineId], references: [accountId, id], onDelete: Cascade)
    materializationId String @db.VarChar(256)
    pluginId          String @db.VarChar(256)
    version           String @db.VarChar(256)
    sourceClass       String @db.VarChar(32)
    portableRelease   Boolean
    archiveDigestSha256 String? @db.VarChar(71)
    uiArtifacts       Json
    enabled           Boolean
    trustState        String @db.VarChar(32)
    observedAt        DateTime
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@unique([machineId, materializationId])
    @@index([accountId, serverIdentityId, machineId], map: "PluginMachineMaterialization_account_server_machine_idx")
    @@index([accountId, pluginId])
}

//
// Plugin webhook ingress
//

/// Server-owned public-route custody. Account-owned routes point at their one endpoint;
/// shared routes instead carry the operator-qualified contribution allowed to use them.
model PluginWebhookRoute {
    id                            String @db.VarChar(25)   @id @default(cuid())
    opaqueRouteId                 String @db.VarChar(128)   @unique
    verifierKind                  String @db.VarChar(64)
    routingKind                   String @db.VarChar(64)
    operatorPluginId              String? @db.VarChar(256)
    operatorWebhookContributionId String? @db.VarChar(128)
    accountEndpointId             String? @db.VarChar(28)  @unique
    accountEndpoint               PluginWebhookEndpoint? @relation("PluginWebhookRouteAccountEndpoint", fields: [accountEndpointId], references: [id], onDelete: SetNull)
    enabled                       Boolean  @default(true)
    revokedAt                     DateTime?
    policyVersion                 Int      @default(1)
    currentCredentialId           String? @db.VarChar(25)  @unique
    currentCredential             PluginWebhookCredential? @relation("PluginWebhookRouteCurrentCredential", fields: [currentCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
    previousCredentialId          String? @db.VarChar(25)  @unique
    previousCredential            PluginWebhookCredential? @relation("PluginWebhookRoutePreviousCredential", fields: [previousCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
    createdAt                     DateTime @default(now())
    updatedAt                     DateTime @updatedAt

    endpoints   PluginWebhookEndpoint[]   @relation("PluginWebhookRouteEndpoints")
    credentials PluginWebhookCredential[] @relation("PluginWebhookRouteCredentials")
    deliveries  PluginWebhookDelivery[]

    @@unique([operatorPluginId, operatorWebhookContributionId], map: "plugin_webhook_route_operator_contribution_key")
}

/// Account endpoint binding. The canonical Account deletion owner explicitly detaches a shared
/// provider-installation binding into its bounded replay-isolation tombstone before deleting.
model PluginWebhookEndpoint {
    id                                String @db.VarChar(28)   @id
    accountId                         String?
    account                           Account? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
    pluginId                          String? @db.VarChar(256)
    webhookContributionId             String? @db.VarChar(128)
    handlerActionId                   String? @db.VarChar(128)
    sourceInstanceId                  String? @db.VarChar(128)
    ensureIdempotencyKey              String? @db.VarChar(128)
    ensureRequestFingerprint          String? @db.Char(64)
    setupKind                         String? @db.VarChar(64)
    routeId                           String @db.VarChar(25)
    route                             PluginWebhookRoute @relation("PluginWebhookRouteEndpoints", fields: [routeId], references: [id], onDelete: Restrict)
    accountRoute                      PluginWebhookRoute? @relation("PluginWebhookRouteAccountEndpoint")
    routingKind                       String @db.VarChar(64)
    providerInstallationId            String? @db.VarChar(20)
    enabled                           Boolean  @default(true)
    revision                          Int      @default(1)
    revokedAt                         DateTime?
    releasedAt                        DateTime?
    tombstoneExpiresAt                DateTime?
    targetMachineId                   String? @db.VarChar(256)
    targetMachineInstallationId       String? @db.VarChar(256)
    targetMaterializationId           String? @db.VarChar(256)
    targetPluginVersion               String? @db.VarChar(256)
    previousTargetMachineId           String? @db.VarChar(256)
    previousTargetMachineInstallationId String? @db.VarChar(256)
    previousTargetMaterializationId   String? @db.VarChar(256)
    previousTargetPluginVersion       String? @db.VarChar(256)
    createdAt                         DateTime @default(now())
    updatedAt                         DateTime @updatedAt

    deliveries PluginWebhookDelivery[]
    operations PluginWebhookEndpointOperation[]

    @@unique([accountId, ensureIdempotencyKey])
    @@unique([accountId, pluginId, webhookContributionId, sourceInstanceId], map: "plugin_webhook_endpoint_account_contribution_source_key")
    @@unique([routeId, providerInstallationId])
    @@index([tombstoneExpiresAt])
}

/// Immutable result facts for the bounded revoke/retarget endpoint operations. This is not a
/// generic Action idempotency table: it makes response-loss retries rejoin their closed endpoint
/// operation without persisting raw requests, fingerprints, credentials, or server identity.
model PluginWebhookEndpointOperation {
    id                                  String @db.VarChar(25)   @id @default(cuid())
    accountId                           String
    account                             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    endpointId                          String @db.VarChar(28)
    endpoint                            PluginWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
    operationKind                       String @db.VarChar(16)
    idempotencyKey                      String @db.VarChar(128)
    expectedRevision                    Int
    requestTargetMachineId              String? @db.VarChar(256)
    requestTargetMaterializationId      String? @db.VarChar(256)
    requestTargetPluginId               String? @db.VarChar(256)
    resultKind                          String @db.VarChar(32)
    resultRevision                      Int
    resultPreviousTargetMachineId       String? @db.VarChar(256)
    resultPreviousTargetMaterializationId String? @db.VarChar(256)
    resultPreviousTargetPluginId        String? @db.VarChar(256)
    resultTargetMachineId               String? @db.VarChar(256)
    resultTargetMaterializationId       String? @db.VarChar(256)
    resultTargetPluginId                String? @db.VarChar(256)
    createdAt                           DateTime @default(now())

    @@unique([endpointId, idempotencyKey])
    @@index([accountId])
}

/// At-rest encrypted verifier material. Route pointers select at most current and previous
/// versions; credential rotation remains a single transactional owner.
model PluginWebhookCredential {
    id                  String @db.VarChar(25)   @id @default(cuid())
    routeId             String @db.VarChar(25)
    route               PluginWebhookRoute @relation("PluginWebhookRouteCredentials", fields: [routeId], references: [id], onDelete: Cascade)
    credentialVersionId String @db.VarChar(64)   @unique
    verifierKind        String @db.VarChar(64)
    encryptedSecret     Bytes
    state               String @db.VarChar(64)
    acceptUntil         DateTime?
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    currentForRoute  PluginWebhookRoute? @relation("PluginWebhookRouteCurrentCredential")
    previousForRoute PluginWebhookRoute? @relation("PluginWebhookRoutePreviousCredential")
}

/// Durable, deduplicated webhook delivery custody. Provider facts remain inside `payload`;
/// all target facts are frozen on receipt rather than re-reading a mutable endpoint binding.
model PluginWebhookDelivery {
    id                          String @db.VarChar(25)   @id @default(cuid())
    endpointId                  String @db.VarChar(28)
    endpoint                    PluginWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)
    accountId                   String
    account                     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    routeId                     String @db.VarChar(25)
    route                       PluginWebhookRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
    deliveryIdentityDigest      String @db.Char(64)   @unique
    verifierKind                String @db.VarChar(64)
    targetMachineId             String @db.VarChar(256)
    targetMachineInstallationId String @db.VarChar(256)
    targetMaterializationId     String @db.VarChar(256)
    targetPluginId              String @db.VarChar(256)
    targetPluginVersion         String @db.VarChar(256)
    endpointRevision            Int
    endpointWebhookContributionId String
    endpointHandlerActionId      String
    endpointSourceInstanceId     String
    payloadKind                 String @db.VarChar(16)
    payload                     Json?
    payloadBytes                BigInt   @default(0)
    wireVersion                 Int
    payloadVersion              Int
    state                       String @db.VarChar(32)
    attemptCount                Int      @default(0)
    replayCount                 Int      @default(0)
    nextAttemptAt               DateTime
    offlineSinceAt              DateTime?
    leaseId                     String? @db.VarChar(256)
    claimedByMachineId          String? @db.VarChar(256)
    claimedByMachineInstallationId String? @db.VarChar(256)
    firstClaimAt                DateTime?
    executionStartedAt          DateTime?
    leaseExpiresAt              DateTime?
    revision                    Int      @default(0)
    lastErrorCode               String? @db.VarChar(128)
    automationAdmissionUnresolved Json?
    terminalDisposition         String? @db.VarChar(128)
    succeededAt                 DateTime?
    deadLetteredAt              DateTime?
    discardedAt                 DateTime?
    discardedByUserId           String?
    discardReasonCode           String? @db.VarChar(128)
    payloadPurgeAt              DateTime?
    metadataDeleteAt            DateTime
    receivedAt                  DateTime
    createdAt                   DateTime @default(now())
    updatedAt                   DateTime @updatedAt

    @@index([targetMachineId(length: 64), targetMachineInstallationId(length: 64), targetMaterializationId(length: 64), state(length: 32), nextAttemptAt], map: "plugin_webhook_delivery_target_claim_idx")
    @@index([state, leaseExpiresAt])
    @@index([endpointId, state])
    @@index([accountId, state])
    @@index([accountId, state, payloadBytes])
    @@index([endpointId, state, payloadBytes])
    @@index([payloadPurgeAt])
    @@index([metadataDeleteAt])
}

//
// Access Keys
//

model AccessKey {
    id          String   @id @default(cuid())
    accountId   String
    account     Account  @relation(fields: [accountId], references: [id])
    machineId   String
    machine     Machine  @relation(fields: [accountId, machineId], references: [accountId, id])
    sessionId   String
    session     Session  @relation(fields: [sessionId], references: [id])
    data        String // Encrypted data
    dataVersion Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([accountId, machineId, sessionId])
    @@index([accountId])
    @@index([sessionId])
    @@index([machineId])
}

//
// Social Network - Relationships
//

enum RelationshipStatus {
    none
    requested
    pending
    friend
    rejected
}

model UserRelationship {
    fromUserId     String
    fromUser       Account            @relation("RelationshipsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
    toUserId       String
    toUser         Account            @relation("RelationshipsTo", fields: [toUserId], references: [id], onDelete: Cascade)
    status         RelationshipStatus @default(pending)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    acceptedAt     DateTime?
    lastNotifiedAt DateTime?

    @@id([fromUserId, toUserId])
    @@index([toUserId, status])
    @@index([fromUserId, status])
}

//
// Feed
//

model UserFeedItem {
    id        String   @id @default(cuid())
    userId    String
    user      Account  @relation(fields: [userId], references: [id], onDelete: Cascade)
    counter   BigInt
    repeatKey String?
    /// [FeedBody]
    body      Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, counter])
    @@unique([userId, repeatKey])
    @@index([userId, counter])
    @@index([createdAt])
}

//
// Key-Value Storage
//

model UserKVStore {
    id        String   @id @default(cuid())
    accountId String
    account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    key       String   // Unencrypted for indexing
    value     Bytes?   // Encrypted value, null when "deleted"
    version   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([accountId, key])
    @@index([accountId])
}

//
// Plugin Account Collections
//

/// Immutable normalized collection contract. Plugin package/release identity is intentionally
/// absent: rows retain the semantic contract that owns their schema, projections, and indexes.
model PluginCollectionContract {
    id                String @db.VarChar(25)   @id @default(cuid())
    pluginId          String @db.VarChar(256)
    collectionId      String @db.VarChar(256)
    schemaVersion     Int
    contractDigest    String @db.VarChar(43)
    normalizedSchema  Json
    indexes           Json
    relations         Json
    privacyProjection Json
    createdAt         DateTime @default(now())

    rows        PluginCollectionRow[]
    indexStates PluginCollectionIndexState[]
    candidatePreparationSourceStages PluginCollectionCandidatePreparationStage[] @relation("PluginCollectionCandidatePreparationSourceContract")
    candidatePreparationTargetStages PluginCollectionCandidatePreparationStage[] @relation("PluginCollectionCandidatePreparationTargetContract")

    @@unique([pluginId, collectionId, schemaVersion], map: "PluginCollectionContract_identity_schema_key")
    @@unique([pluginId, collectionId, contractDigest], map: "PluginCollectionContract_identity_digest_key")
    @@index([pluginId, collectionId], map: "PluginCollectionContract_identity_idx")
}

/// A non-authoritative target row prepared by a candidate host. The canonical
/// Collection row, its derived relations, and its index entries remain the
/// only ordinary read/write surface until Availability promotes a complete
/// candidate stage set inside its intent transaction.
model PluginCollectionCandidatePreparationStage {
    id                      String   @id @default(cuid())
    accountId               String
    account                 Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    pluginId                String
    collectionId            String
    rowId                   String
    /// Internal fixed-width identity for the exact source/target/candidate
    /// binding. It prevents provider-specific oversized composite keys while
    /// all original binding facts remain persisted below.
    candidateIdentity       String
    sourceRowDbId           String
    sourceRow               PluginCollectionRow @relation("PluginCollectionCandidatePreparationSourceRow", fields: [sourceRowDbId], references: [id], onDelete: Cascade)
    sourceContractId        String
    sourceContract          PluginCollectionContract @relation("PluginCollectionCandidatePreparationSourceContract", fields: [sourceContractId], references: [id], onDelete: Restrict)
    sourceSchemaVersion     Int
    sourceContractDigest    String
    sourceRevision          Int
    targetContractId        String
    targetContract          PluginCollectionContract @relation("PluginCollectionCandidatePreparationTargetContract", fields: [targetContractId], references: [id], onDelete: Restrict)
    targetSchemaVersion     Int
    targetContractDigest    String
    candidateReleaseVersion String
    candidateArtifactDigest String
    /// [PluginCollectionContentEnvelopeV1]
    targetContentEnvelope   Json
    /// [PluginCollectionProjectionV1]
    targetProjection        Json
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    @@unique([accountId, candidateIdentity, sourceRowDbId, targetContractId], map: "PluginCollectionCandidatePreparationStage_identity_key")
    @@index([accountId, pluginId], map: "PluginCollectionCandidatePreparationStage_candidate_idx")
    @@index([accountId, sourceRowDbId], map: "PluginCollectionCandidatePreparationStage_source_idx")
}

/// One logical collection row. Its private envelope and server-readable projections are split so
/// encrypted Accounts never duplicate a declared projection inside private content.
model PluginCollectionRow {
    id             String @db.VarChar(25)   @id @default(cuid())
    accountId      String
    account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    pluginId       String @db.VarChar(256)
    collectionId   String @db.VarChar(256)
    rowId          String @db.VarChar(256)
    schemaVersion  Int
    revision       Int
    contractId     String @db.VarChar(25)
    contract       PluginCollectionContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
    contractDigest String @db.VarChar(43)
    /// [PluginCollectionContentEnvelopeV1]
    contentEnvelope Json
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    deletedAt      DateTime?

    projections      PluginCollectionProjection[]
    sourceRelations  PluginCollectionRelation[]
    candidatePreparationStages PluginCollectionCandidatePreparationStage[] @relation("PluginCollectionCandidatePreparationSourceRow")

    @@unique([accountId, pluginId, collectionId, rowId], map: "PluginCollectionRow_account_identity_key")
    @@index([accountId, pluginId, collectionId, deletedAt], map: "PluginCollectionRow_account_live_idx")
    @@index([accountId, pluginId, collectionId, contractDigest], map: "PluginCollectionRow_account_contract_idx")
    /// Serves the Account-wide live-row keyset walk the quota census performs
    /// before and after every Collection mutation batch. The three indexes above
    /// all lead with the collection identity, so without this one the census
    /// falls back to the primary key and filters out every other tenant's rows.
    @@index([accountId, deletedAt, id], map: "PluginCollectionRow_account_live_scan_idx")
}

/// The authoritative server-readable values for a collection row. Index and relation records are
/// derived transactionally from this projection rather than independently authored.
model PluginCollectionProjection {
    id                String @db.VarChar(25)   @id @default(cuid())
    rowDbId           String @db.VarChar(25)
    row               PluginCollectionRow @relation(fields: [rowDbId], references: [id], onDelete: Cascade)
    accountId         String
    pluginId          String @db.VarChar(256)
    collectionId      String @db.VarChar(256)
    rowId             String @db.VarChar(256)
    fieldId           String @db.VarChar(256)
    typedEncodedValue String @db.LongText
    rowRevision       Int
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@unique([rowDbId, fieldId], map: "PluginCollectionProjection_row_field_key")
    @@index([accountId, pluginId, collectionId, fieldId], map: "PluginCollectionProjection_field_idx")
    @@index([accountId, pluginId, collectionId, rowId], map: "PluginCollectionProjection_row_idx")
}

/// Per-Account index build/readiness state. The internal fixed-width id keeps the physical
/// index-entry key portable while public cursors retain the logical contract/index identity.
model PluginCollectionIndexState {
    id                    String @db.VarChar(25)   @id @default(cuid())
    accountId             String
    account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    pluginId              String @db.VarChar(256)
    collectionId          String @db.VarChar(256)
    indexId               String @db.VarChar(256)
    contractId            String @db.VarChar(25)
    contract              PluginCollectionContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
    contractDigest        String @db.VarChar(43)
    buildState            String @db.VarChar(32)
    indexedThroughRevision Int?
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt

    entries PluginCollectionIndexEntry[]

    @@unique([accountId, pluginId, collectionId, indexId, contractDigest], map: "PluginCollectionIndexState_identity_key")
    @@index([accountId, pluginId, collectionId, buildState], map: "PluginCollectionIndexState_build_idx")
}

/// One derived keyset entry. `encodedSortKey` contains the logical row-id tie-breaker as the
/// Protocol-owned raw ordinal bytes; only query transport cursors encode it as text.
model PluginCollectionIndexEntry {
    id             String @db.VarChar(25)   @id @default(cuid())
    indexStateId   String @db.VarChar(25)
    indexState     PluginCollectionIndexState @relation(fields: [indexStateId], references: [id], onDelete: Cascade)
    encodedSortKey Bytes @db.VarBinary(2318)
    rowId          String @db.VarChar(256)
    rowRevision    Int
    createdAt      DateTime @default(now())

    @@unique([indexStateId, encodedSortKey], map: "PluginCollectionIndexEntry_sort_key")
    @@index([indexStateId, rowId], map: "PluginCollectionIndexEntry_row_idx")
}

/// A server-readable logical relation edge. It grants no target-domain authority and has no
/// physical foreign key across plugin/domain boundaries.
model PluginCollectionRelation {
    id                 String @db.VarChar(25)   @id @default(cuid())
    accountId          String
    account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    sourceRowDbId      String @db.VarChar(25)
    sourceRow          PluginCollectionRow @relation(fields: [sourceRowDbId], references: [id], onDelete: Cascade)
    sourcePluginId     String @db.VarChar(256)
    sourceCollectionId String @db.VarChar(256)
    sourceRowId        String @db.VarChar(256)
    relationId         String @db.VarChar(256)
    targetKind         String @db.VarChar(64)
    targetPluginId     String? @db.VarChar(256)
    targetCollectionId String? @db.VarChar(256)
    targetRowId        String? @db.VarChar(256)
    sourceRevision     Int
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
    deletedAt          DateTime?

    @@index([accountId, sourcePluginId, sourceCollectionId, sourceRowId, deletedAt], map: "PluginCollectionRelation_source_idx")
    @@index([accountId, targetKind, targetPluginId, targetCollectionId, targetRowId, deletedAt], map: "PluginCollectionRelation_target_idx")
}

