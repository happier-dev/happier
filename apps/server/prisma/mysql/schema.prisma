model AutomationRun {
    id                 String             @id @default(cuid())
    originKind                 String   @default("automation")
    automationId               String?
    automation                 Automation? @relation(fields: [automationId], references: [id], onDelete: Restrict)
    originSessionId            String?
    originSession              Session? @relation("WorkflowRunOriginSession", fields: [originSessionId], references: [id], onDelete: SetNull)
    workflowAcceptedSnapshotEnvelope String? @db.LongText
    sourceArtifactId           String?
    visibleTeamId              String?
    workflowCheckpointEnvelope String? @db.LongText
    workflowCustodyState       WorkflowRunCustodyState?
    /// Null means no pending boundary Resume; a successful claim consumes the revision.
    workflowResumeRequestedRevision Int?
    originDeliveryAckRevision Int?
    accountId          String
    account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
    state              AutomationRunState @default(queued)
    triggerId          String?
    causeKind          AutomationRunCauseKind? @default(trigger)
    causeTriggerKind   AutomationTriggerKind?
    causeTriggerRevision Int?
    causeEventPluginId String?
    causeEventLocalId String?
    causeOccurredAt    DateTime?
    causeScheduledFor DateTime?
    causeSessionLifecycleEvent AutomationSessionLifecycleEvent?
    causeSourceSessionId String?
    causeSourceTurnId String?
    causeRunLifecycleEvidenceJson String? @db.LongText
    causeSessionLifecycleRequestId String?
    causeSessionLifecycleRequestKind AutomationSessionLifecycleRequestKind?
    causeSessionLifecyclePolicyKind AutomationSessionLifecyclePolicyKind?
    causeSessionLifecycleConfiguredCount Int?
    occurrenceKey      String? @db.Char(43)
    legacyManualIdempotencyKey String? @map("idempotencyKey")
    occurrenceEvidenceEqualityTag String?
    causeSourceSelectorId String?
    triggerEvidenceEnvelope String? @db.LongText
    executionInputEnvelope String? @db.LongText
    executionDispatchState AutomationExecutionDispatchState?
    executionAttempt   Int                @default(0)
    executionDispatchCommittedAt DateTime?
    executionDispatchDueAt DateTime?
    executionNativeRunId String?
    executionNativeCallId String?
    executionNativeSidechainId String?
    resultEnvelope     String? @db.LongText
    replyContextEnvelope String? @db.LongText
    replyHandoffActionPluginId String?
    replyHandoffActionLocalId String?
    replyHandoffTargetMachineId String?
    replyHandoffTargetMachineInstallationId String?
    replyHandoffTargetMaterializationId String?
    replyHandoffId     String?
    replyHandoffState  AutomationRunReplyHandoffState @default(none)
    replyHandoffAttempt Int @default(0)
    replyHandoffDueAt  DateTime?
    scheduledAt        DateTime
    dueAt              DateTime
    claimedAt          DateTime?
    startedAt          DateTime?
    finishedAt         DateTime?
    claimedByMachineId String?
    claimedByMachine   Machine?           @relation("AutomationRunClaimedByMachine", fields: [claimedByMachineId], references: [id], onDelete: SetNull)
    leaseExpiresAt     DateTime?
    attempt            Int                @default(0)
    revision           Int                @default(0)
    summaryCiphertext  String?
    errorCode          String?
    errorMessage       String?
    producedSessionId  String?
    producedSession    Session?           @relation("AutomationRunProducedSession", fields: [producedSessionId], references: [id], onDelete: SetNull)
    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
    events             AutomationRunEvent[]
    assignments        AutomationRunAssignment[]
    workflowInvocations        WorkflowRunInvocation[]
    workflowDataKeyEnvelopes    WorkflowRunDataKeyEnvelope[]

    @@index([accountId, state, dueAt])
    @@index([accountId, causeKind, state])
    @@index([automationId, dueAt])
    @@index([automationId, createdAt, id], map: "AutomationRun_automationId_createdAt_id_idx")
    @@index([claimedByMachineId, leaseExpiresAt])
    @@index([state, finishedAt])
    @@index([state, dueAt])
    @@index([replyHandoffState, replyHandoffDueAt])
    /// The one ordinary nullable composite unique that owns Run rejoin for
    /// every cause. Trigger identity is already inside the derived occurrence
    /// key, so a trigger- or cause-scoped unique would be a second dedupe
    /// owner rather than a stricter one. Schedule, non-idempotent V3 manual,
    /// and retained released-V2 manual rows keep a null key.
    @@unique([automationId, occurrenceKey])
    @@unique([automationId, legacyManualIdempotencyKey], map: "AutomationRun_automationId_idempotencyKey_key")
    @@index([triggerId, state])
    @@index([accountId, originKind, createdAt, id], map: "AutomationRun_account_origin_created_id_idx")
    @@index([accountId, createdAt, id], map: "AutomationRun_account_created_id_idx")
    @@index([sourceArtifactId, createdAt, id], map: "AutomationRun_source_created_id_idx")
    @@index([originSessionId, createdAt, id], map: "AutomationRun_originSession_created_id_idx")
}

