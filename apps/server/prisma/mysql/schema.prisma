enum SessionFollowDeliveredTurnStatus {
    completed
    failed
    cancelled
}

enum SessionFollowMode {
    next_turn
    wake_on_human_change
}

/// Durable Session-to-Session Follow relation.
///
/// The Home stores the authorized pair and the content-free
/// frontier this destination has already consumed. It never stores source
/// content, a delivery Account, a configuring author, runtime reachability, key
/// readiness, a pause flag, or a Follow-specific generation: every one of those
/// is derived by its own owner from current facts.
model SessionFollowEdge {
    sourceSessionId      String
    destinationSessionId String
    mode                  SessionFollowMode @default(next_turn)
    deliveredTranscriptSeq     Int    @default(0)
    deliveredReadyEventSeq     Int    @default(0)
    deliveredAgentStateVersion Int    @default(0)
    deliveredTurnId            String?
    deliveredTurnStatus        SessionFollowDeliveredTurnStatus?

    sourceSession      Session @relation("SessionFollowSource", fields: [sourceSessionId], references: [id], onDelete: Cascade)
    destinationSession Session @relation("SessionFollowDestination", fields: [destinationSessionId], references: [id], onDelete: Cascade)

    @@id([destinationSessionId, sourceSessionId])
    @@index([sourceSessionId])
}

