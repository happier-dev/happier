    teamGrants MachineTeamGrant[]
    groupGrants MachineGroupGrant[]
    keyEnvelopes MachineKeyEnvelope[]
    managedResource ManagedMachine?
    brokeredTeamCredentialResources TeamCredentialResource[]
    id                 String      @id
    kind               MachineKind @default(persistent)
    accountId          String
    account            Account     @relation(fields: [accountId], references: [id])
    metadata           String @db.LongText // Encrypted - contains static machine info
    metadataVersion    Int         @default(0)
    daemonState        String? @db.LongText // Encrypted - contains dynamic daemon state
    daemonStateVersion Int         @default(0)
    dataEncryptionKey  Bytes?
    /// Creator-authenticated provenance for a Runner-scoped Machine content key.
    runnerContentKeyBinding Json?
    installationId     String?
    installationPublicKey Bytes?
    contentPublicKeyFingerprint String?
    /// [MachineOperationProtocolCapabilitiesV1]
    operationProtocolCapabilities Json?
    /// Monotonic only across accepted complete capability projections.
    operationProtocolCapabilitiesRevision Int?
    /// Null means this machine has not accepted a complete plugin-materialization snapshot.
    pluginMaterializationRevision BigInt?
    replacedByMachineId String?
    replacedAt         DateTime?
    replacementReason  String?
    replacementSource  String?
    replacementActorUserId String?
    seq                Int         @default(0)
    active             Boolean     @default(true)
