    controllerInstallationId String
    admittedActionRequestId String
    admittedInput Json
    presetId String?
    presetRevision Int?
    launch Json
    reviewedFacts Json?
    environmentSetup Json?
    allocation String @default("unsubmitted")
    creationState String @default("active")
    resource Json?
    nativeOperationRef Json?
    recovery Json?
    bootstrapCredentialRef Json?
    enrolledMachineId String? @unique
    enrolledMachine Machine? @relation(fields: [enrolledMachineId], references: [id], onDelete: SetNull)
    desired String @default("start")
    desiredWhen String @default("now")
    desiredAfterMs Float?
    intentRevision Int @default(0)
    archivedAt DateTime?
    retention Json
    wakeOnAcceptedMessage Boolean
    observation Json?
    cleanup Json?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([homeId, admittedActionRequestId])
    @@index([homeId, custodianAccountId, archivedAt, createdAt])
