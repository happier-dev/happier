    @@index([homeId, custodianAccountId])
    @@index([homeId, teamId])
}

//
// Machine Pools
//
// A reusable named set of one Account's own persistent Machines on one Home. Membership is a saved
// preference: it confers no Team, Session, Machine or credential authority, and later exact
// dispatch still revalidates Machine state at its own owners. Home locality follows the
// authenticated database and the Machine foreign key, so there is no persisted serverId, homeId,
// principal union or generic resource owner here. No candidate list, request key, score or
// selection result is ever persisted.

/// Machines expose Use and Manage, never the Session/Artifact Edit role.
enum MachineShareAccessLevel {
    view
    admin
}

model MachineAccountGrant {
    machineId String
    accountId String
    accessLevel MachineShareAccessLevel
    createdByAccountId String
    createdAt DateTime @default(now())

    machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
    account Account @relation("MachineAccountGrantRecipient", fields: [accountId], references: [id], onDelete: Cascade)
    createdBy Account @relation("MachineAccountGrantCreator", fields: [createdByAccountId], references: [id], onDelete: Cascade)

    @@id([machineId, accountId])
    @@index([accountId, machineId])
}

model MachineTeamGrant {
    machineId String
    teamId String
    accessLevel MachineShareAccessLevel
    createdByAccountId String
    createdAt DateTime @default(now())

    machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
    team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
    createdBy Account @relation("MachineTeamGrantCreator", fields: [createdByAccountId], references: [id], onDelete: Cascade)

    @@id([machineId, teamId])
    @@index([teamId, machineId])
}

model MachineGroupGrant {
    machineId String
    teamGroupId String
    accessLevel MachineShareAccessLevel
    createdByAccountId String
    createdAt DateTime @default(now())

    machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
    teamGroup TeamGroup @relation(fields: [teamGroupId], references: [id], onDelete: Cascade)
    createdBy Account @relation("MachineGroupGrantCreator", fields: [createdByAccountId], references: [id], onDelete: Cascade)

    @@id([machineId, teamGroupId])
    @@index([teamGroupId, machineId])
}

model MachineKeyEnvelope {
    machineId String
    recipientAccountId String
    encryptedDataKey Bytes
    machineOwnerEnvelopeFingerprint String
    recipientContentPublicKeyFingerprint String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
    recipient Account @relation("MachineKeyEnvelopeRecipient", fields: [recipientAccountId], references: [id], onDelete: Cascade)

    @@id([machineId, recipientAccountId])
    @@index([recipientAccountId, machineId])
}

model MachinePool {
    id          String   @id
    accountId   String
    name        String @db.LongText
    description String? @db.LongText
    /// Bumped once per actual definition change; the client's expected value is the CAS token.
    revision    Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
    members     MachinePoolMember[]
    credentialResources TeamCredentialResource[]

    @@index([accountId, id])
}

model MachinePoolMember {
    poolId       String
    machineId    String
    /// Nonnegative ordinal compared by numeric order; equal-tier membership is unordered.
    priorityTier Int
    enabled      Boolean @default(true)
    pool         MachinePool @relation(fields: [poolId], references: [id], onDelete: Cascade)
    machine      Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

    @@id([poolId, machineId])
    @@index([machineId])
}

