model SessionReportsTo {
    sessionId                  String @id
    leadSessionId              String
    attachedAt                 DateTime @default(now())
    deliveredTranscriptSeq     Int @default(0)
    deliveredReadyEventSeq     Int @default(0)
    deliveredAgentStateVersion Int @default(0)
    deliveredTurnId            String?
    deliveredTurnStatus        SessionFollowDeliveredTurnStatus?

    session     Session @relation("SessionReportChild", fields: [sessionId], references: [id], onDelete: Cascade)
    leadSession Session @relation("SessionReportLead", fields: [leadSessionId], references: [id], onDelete: Cascade)

    @@index([leadSessionId])
}

model SessionMessage {
    id        String   @id @default(cuid())
    sessionId String
    session   Session  @relation(fields: [sessionId], references: [id])
    localId   String?
    sidechainId String?
    /// Server-private immutable binding copied from Pending custody. This is
    /// not a client-authored routing field or part of the public Message wire.
    targetExecutionRunId String?
    seq       Int
    messageRole String?
    /// [SessionMessageContent]
    content   Json
    /// [SessionInputAdmissionReceiptV1]
    inputAdmissionReceipt Json?
    /// Derived query projection of `inputAdmissionReceipt.actorAccountId` for a
    /// `messageRole: "user"` row admitted from an authenticated Account. The
    /// receipt stays the immutable actor authority; this column exists only so
    /// historical participation is a portable indexed predicate. `SetNull`
    /// after Account deletion is expected and does not erase the receipt.
    authorAccountId String?
    authorAccount   Account? @relation("AuthoredSessionMessages", fields: [authorAccountId], references: [id], onDelete: SetNull)
    /// [SessionInputRequestEqualityEvidenceV1]
    requestEqualityEvidenceV1 Json?
    sourceCreatedAt DateTime?
    sourceUpdatedAt DateTime?
    /// [SessionTranscriptObservationProvenanceV1]
    transcriptObservationProvenance Json?
    /// Server-private, admitted identity; owning Session is this Message's Session.
    /// [SessionTranscriptSurfaceItemReferenceV1]
    surfaceItemReference Json?
    /// [SessionMessageDeliveryResolutionV1]
    deliveryResolution Json?
    /// Private currentness fact for host-issued Message Action references.
    rowRevision BigInt @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // `localId` is a session-global idempotency key (unique across sidechains within a session).
    @@unique([sessionId, localId])
    @@index([sessionId, seq])
    @@index([sessionId, sidechainId, seq])
    @@index([sessionId, messageRole, seq])
    @@index([sessionId, sidechainId, messageRole, seq])
    @@index([authorAccountId, sessionId])
}

enum SessionPendingMessageStatus {
    queued
    discarded
}

enum PendingProviderAction {
    send
    steer
    interrupt_and_send
}

model SessionPendingMessage {
    id              String                     @id @default(cuid())
    sessionId        String
    session          Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    /// Informational only (attribution); pending queue is session-global.
    authorAccountId  String?
    authorAccount    Account?                   @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)

    localId          String
    /// Null selects the primary Session runtime; Runs remain daemon-owned identities.
    targetExecutionRunId String?
    messageRole      String?
    /// [SessionPendingMessageContent]
    content          Json
    /// [PendingRequestedActionV1]
    requestedAction  Json
    /// [SessionInputAdmissionReceiptV1]
    inputAdmissionReceipt Json?
    /// [SessionInputRequestEqualityEvidenceV1]
    requestEqualityEvidenceV1 Json?
    /// The immediately preceding local id for one exact response-loss rejoin.
    predecessorLocalId String?
    /// [PendingMessageMutationFingerprintV1]
    replacementMutationFingerprint String?
    /// Frozen provider operation for a claimed Pending row.
    providerAction   PendingProviderAction?
    status           SessionPendingMessageStatus @default(queued)
    deliveryState         String?
    deliveryBlockedReason String?
    position         Int
    discardedAt      DateTime?
    discardedReason  String?
    createdAt        DateTime                   @default(now())
    updatedAt        DateTime                   @updatedAt

    @@unique([sessionId, localId])
    @@index([sessionId, status, position])
    @@index([sessionId, status, deliveryState, position], map: "SessionPendingMessage_sid_status_dstate_position_idx")
    @@index([sessionId, targetExecutionRunId, status, deliveryState, position], map: "SessionPendingMessage_sid_target_status_dstate_position_idx")
    @@index([sessionId, authorAccountId])
    @@index([sessionId, status, updatedAt])
}

