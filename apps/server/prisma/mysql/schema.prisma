    createdBy Account @relation("ArtifactAccountGrantCreator", fields: [createdByAccountId], references: [id], onDelete: Cascade)

    @@id([artifactId, accountId])
    @@index([accountId, artifactId])
}

model ArtifactTeamGrant {
