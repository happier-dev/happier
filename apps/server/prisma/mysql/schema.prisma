    @@index([accountId, installationId])
    @@index([accountId, replacedByMachineId])
    @@index([accountId, replacedAt])
    @@index([accountId, revokedAt])
}

// Durable compute custody exists before ordinary Machine enrollment. The
// optional enrolledMachineId is the only stored association to a Machine.
model ManagedMachine {
    id String @id @default(cuid())
    homeId String
