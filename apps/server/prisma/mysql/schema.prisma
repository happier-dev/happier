//
// Artifacts
//

/// Disclosed, credential-free Source metadata; independent of private Project rows and Artifact grants.
model ProjectSource {
    id String @id @default(cuid())
    createdByAccountId String
    createdByAccount Account @relation(fields: [createdByAccountId], references: [id], onDelete: Cascade)
    revision Int @default(1)
    name String @db.Text
    repository Json
    defaultRef String? @db.Text
    subdir String? @db.Text
    audience Json
    attachments Json
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([createdByAccountId, id])
}

model Artifact {
    publicShare PublicSessionShare?
    revisions ArtifactRevision[]
    blobs ArtifactBlob[]
    accountGrants ArtifactAccountGrant[]
    teamGrants ArtifactTeamGrant[]
    groupGrants ArtifactGroupGrant[]
    keyEnvelopes ArtifactKeyEnvelope[]
    id                String   @id // UUID provided by client
    accountId         String
    account           Account  @relation(fields: [accountId], references: [id])
    header            Bytes @db.LongBlob // Encrypted header (can contain JSON)
    headerVersion     Int      @default(0)
    body              Bytes @db.LongBlob // Encrypted body
    bodyVersion       Int      @default(0)
    provenance        Bytes? @db.LongBlob
    provenanceDataEncryptionKey Bytes? @db.LongBlob
    currentBlobId     String?
    deletedAt         DateTime?
    dataEncryptionKey Bytes @db.LongBlob // Encryption key for this artifact
    seq               Int      @default(0)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
    accountChanges    AccountChange[] @relation("AccountChangeArtifact")
    pluginUiArtifact  AccountPluginUiArtifact?
    packageAssetRelease AccountPluginRelease? @relation("AccountPluginReleasePackageAsset")

    @@index([accountId])
    @@index([accountId, updatedAt])
}

model ArtifactRevision {
    artifactId String
    bodyVersion Int
    body Bytes @db.LongBlob
    provenance Bytes? @db.LongBlob
    blobId String?
    createdAt DateTime @default(now())
    artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

    @@id([artifactId, bodyVersion])
}

// Sensitive file metadata stays in the ordinary Artifact body envelope.
model ArtifactBlob {
    id String @id
    artifactId String
    storageKey String @unique
    encryptionMode String
    storedSizeBytes BigInt
    artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

    @@index([artifactId])
}

model ArtifactAccountGrant {
