    @@unique([accountId, activeIdentityKey], map: "plugin_permission_requests_active_identity_key")
    @@index([accountId(length: 64), pluginId(length: 64), capability(length: 64), scopeKind(length: 64), scopeProjectId(length: 64), scopeWorkspaceId(length: 64), authorityKind(length: 64), authorityMachineId(length: 64), authorityInstallationId(length: 64), status(length: 64), updatedAt], map: "plugin_permission_requests_scope_idx")
    @@index([accountId, grantId], map: "plugin_permission_requests_grant_idx")
