/// The Account-owned preparation record for a bounded encryption transition. It is not a
/// Collection coordinator: participants keep their own source revision and envelope facts.
model AccountEncryptionTransition {
    /// V5's public transition identity is a UUID and must be persisted without
    /// truncation on every provider.
    id                         String @db.VarChar(36)   @id @default(uuid())
    accountId                  String @db.VarChar(191)
    fromEncryptionMode         String @db.VarChar(16)
    toEncryptionMode           String @db.VarChar(16)
    sourceAccountVersion       Int
    sourceSettingsVersion      Int
    sourceSigningKeyFingerprint String? @db.VarChar(49)
    sourceContentKeyFingerprint String? @db.VarChar(49)
    targetSigningKeyFingerprint String? @db.VarChar(49)
    targetContentKeyFingerprint String? @db.VarChar(49)
    /// Public target key material is retained only while activation needs it
    /// after a process restart; private source/target payloads remain in the
    /// Collection owner and are never duplicated here.
    targetAccountPublicKey      String? @db.VarChar(64)
    targetContentPublicKey      Bytes?
    targetContentPublicKeySig   Bytes?
    /// Prepared replacement password credential for an Account that has one
    /// enrolled. It is staged at authorization and committed by the same
    /// Account mode flip, so a mode can never be published beside a credential
    /// of the other mode. Null means the Account has no password to convert.
    targetPasswordCredential    Json?
    targetPasswordRevision      Int?
    /// `activeAccountId` is present only while this row is preparing or authorized.
    status                     String @db.VarChar(16)
    activeAccountId            String? @db.VarChar(191)  @unique
    preparedAt                 DateTime
    authorizedAt               DateTime?
    expiresAt                  DateTime
    activatedAt                DateTime?
    /// Exact committed activation response for loss/retry rejoin. These facts
    /// are written atomically with the Account mode flip and are not derived
    /// from a later Account state.
    activatedAccountVersion    Int?
    activatedAccountUpdatedAt  DateTime?
    activatedAccountCursor     Int?
    cancelledAt                DateTime?
    expiredAt                  DateTime?
    censusParticipantCount     Int      @default(0)
    censusSourceBytes          BigInt   @default(0)
    censusTargetBytes          BigInt   @default(0)
    stagedParticipantCount     Int      @default(0)
    stagedSourceBytes          BigInt   @default(0)
    stagedTargetBytes          BigInt   @default(0)
    reservedCapacityBytes      BigInt   @default(0)
    /// Measured limits are intentionally nullable: schema presence never activates a ceiling.
    measuredParticipantLimit   Int?
    measuredEncodedByteLimit   BigInt?
    createdAt                  DateTime @default(now())
    updatedAt                  DateTime @updatedAt

    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    stages  AccountEncryptionTransitionCollectionStage[]
    automationStageState AccountEncryptionTransitionAutomationStageState?
    automationStages AccountEncryptionTransitionAutomationStage[]

    @@index([accountId, status, expiresAt], map: "AccountEncryptionTransition_account_status_expiry_idx")
}

/// Exact immutable Collection facts staged under the Account transition. These rows never own
/// Collection lifecycle and are removed only with their parent transition.
model AccountEncryptionTransitionCollectionStage {
    id                 String @db.VarChar(25)   @id @default(cuid())
    transitionId       String @db.VarChar(36)
    pluginId           String @db.VarChar(256)
    collectionId       String @db.VarChar(256)
    rowId              String @db.VarChar(256)
    sourceRevision     Int
    sourceEnvelope     Json
    /// A prepare record reserves every exact source participant before a
    /// client derives its target. Target facts become non-null only on stage.
    targetEnvelope     Json?
    schemaVersion      Int
    contractDigest     String @db.VarChar(43)
    sourceEncodedBytes BigInt
    targetEncodedBytes BigInt?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    transition AccountEncryptionTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

    @@unique([transitionId, pluginId, collectionId, rowId], map: "AccountEncryptionTransitionCollectionStage_identity_key")
    @@index([transitionId, pluginId, collectionId, rowId], map: "AccountEncryptionTransitionCollectionStage_transition_page_idx")
}

/// Account-owned source/target census facts for the closed Automation participant.
/// Its presence is the explicit ready marker, including a zero-source census.
model AccountEncryptionTransitionAutomationStageState {
    transitionId              String @db.VarChar(36)   @id
    sourceParticipantCount    Int
    sourceRunCount            Int
    sourceEncodedBytes        BigInt
    stagedParticipantCount    Int
    stagedRunCount            Int
    stagedSourceBytes         BigInt
    stagedTargetBytes         BigInt
    createdAt                 DateTime @default(now())
    updatedAt                 DateTime @updatedAt

    transition AccountEncryptionTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
}

/// Exact immutable Automation source/target facts staged by the one Account transition.
/// This is the closed Definition|Run|WorkflowInvocation transition participant union.
model AccountEncryptionTransitionAutomationStage {
    id                 String @db.VarChar(36)   @id @default(uuid())
    transitionId       String @db.VarChar(36)
    participantKind    String @db.VarChar(32)
    participantId      String @db.VarChar(256)
    automationId       String? @db.VarChar(256)
    sourceRevision     Int?
    sourceContent      String @db.LongText
    targetContent      String? @db.LongText
    sourceEncodedBytes BigInt
    targetEncodedBytes BigInt?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    transition AccountEncryptionTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)

    @@unique([transitionId, participantKind, participantId], map: "AccountEncryptionTransitionAutomationStage_identity_key")
    @@index([transitionId, participantKind, participantId], map: "AccountEncryptionTransitionAutomationStage_transition_page_idx")
}

