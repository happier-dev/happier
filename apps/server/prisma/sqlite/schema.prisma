    active            Boolean             @default(false)
    archivedAt        DateTime?
    lastActiveAt      DateTime            @default(now())
    pendingActivationRequestId String?
    pendingActivationRequestedAt DateTime?
    pendingActivationStatus String?
    pendingActivationFailureCode String?
