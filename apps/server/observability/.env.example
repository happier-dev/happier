HAPPIER_OBSERVABILITY_TARGET_NETWORK=happier-server

HAPPIER_PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
HAPPIER_ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
HAPPIER_GRAFANA_IMAGE=grafana/grafana:11.2.0

HAPPIER_PROMETHEUS_HOST_PORT=9091
HAPPIER_ALERTMANAGER_HOST_PORT=9093
HAPPIER_GRAFANA_HOST_PORT=3000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
