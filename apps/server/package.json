{
  "name": "@happier-dev/server",
  "version": "0.2.10",
  "repository": "https://github.com/happier-dev/happier.git",
  "author": "Leeroy Brun <leeroy.brun@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build:shared": "node ./scripts/buildSharedDeps.mjs",
    "build:public-viewer": "node ./scripts/buildPublicShareViewer.mjs",
    "build:public-profile": "node ./scripts/buildPublicProfileRenderer.mjs",
    "prebuild": "pnpm --silent run postinstall:real",
    "test:prepare": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/schemaSync.ts --check --quiet",
    "build": "node ./scripts/buildPublicProfileRenderer.mjs --check && node ./scripts/runTypeScriptCli.mjs --noEmit -p tsconfig.json -p tsconfig.publicViewer.json",
    "typecheck:runtime": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/generateClients.ts --check && node ./scripts/runTypeScriptCli.mjs -p tsconfig.runtime.json --noEmit",
    "build:runtime": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/runtime/buildRuntime.ts --out-dir ./dist/runtime",
    "typecheck": "../stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "pnpm --silent run generate:providers && node ./scripts/runTypeScriptCli.mjs --noEmit -p tsconfig.json -p tsconfig.publicViewer.json",
    "typecheck:source:finite": "pnpm --silent run generate:providers:check && node ./scripts/runTypeScriptCli.mjs --noEmit -p tsconfig.json -p tsconfig.publicViewer.json",
    "start": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./sources/main.ts",
    "start:light": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./sources/main.light.ts",
    "dev": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/dev.full.ts",
    "dev:kill-port": "pnpm run dev -- --kill-port",
    "dev:light": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/dev.light.ts",
    "test": "../stack/bin/hstack-exec --script=test:local",
    "test:local": "pnpm --silent run test:prepare && pnpm --silent run test:unit:local",
    "vitest": "../stack/bin/hstack-exec --script=vitest:local",
    "vitest:local": "vitest",
    "test:unit": "../stack/bin/hstack-exec --script=test:unit:local",
    "test:unit:local": "vitest run --isolate -c vitest.config.ts && pnpm --silent run test:unit:checks",
    "test:unit:checks": "node --test scripts/buildSharedDeps.test.mjs",
    "test:integration": "../stack/bin/hstack-exec --script=test:integration:local",
    "test:integration:local": "vitest run --isolate -c vitest.integration.config.ts && vitest run --isolate -c vitest.ui.integration.config.ts",
    "test:db-contract": "../stack/bin/hstack-exec --script=test:db-contract:local",
    "test:db-contract:local": "vitest run --isolate -c vitest.dbcontract.config.ts",
    "test:mysql-voice-identity-upgrade-contract": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/voiceProviderConversationIdentityMysqlUpgradeContract.ts",
    "test:session-system-record-upgrade-fixture": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/sessionSystemRecordProviderUpgradeFixture.ts",
    "test:server:db-contract": "pnpm --silent run test:db-contract",
    "migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "migrate:reset": "dotenv -e .env.dev -- prisma migrate reset",
    "migrate:deploy": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.deploy.ts",
    "migrate:full:deploy": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.full.deploy.ts",
    "migrate:light:deploy": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.light.deploy.ts",
    "migrate:sqlite:deploy": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.sqlite.deploy.ts",
    "migrate:mysql:deploy": "pnpm --silent run schema:sync --quiet && node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.mysql.deploy.ts",
    "migrate:light:resolve-baseline": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.light.resolveBaseline.ts",
    "migrate:light:new": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/migrate.light.new.ts",
    "schema:sync": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/schemaSync.ts",
    "schema:sync:check": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/schemaSync.ts --check",
    "generate": "prisma generate",
    "generate:light": "pnpm --silent run schema:sync --quiet && prisma generate --schema prisma/sqlite/schema.prisma",
    "generate:mysql": "pnpm --silent run schema:sync --quiet && prisma generate --schema prisma/mysql/schema.prisma",
    "generate:providers": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/generateClients.ts",
    "generate:providers:check": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/generateClients.ts --check",
    "db:push:light": "pnpm --silent run schema:sync --quiet && prisma db push --schema prisma/sqlite/schema.prisma",
    "postinstall:real": "pnpm --silent run generate:providers && pnpm --silent run build:shared",
    "postinstall": "node -e \"const fs=require('fs');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'server',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('scripts/schemaSync.ts'))process.exit(0);import('../../scripts/workspaces/execPnpmCommand.mjs').then(({execPnpm})=>{execPnpm(['--silent','run','postinstall:real'],{stdio:'inherit'});}).catch(error=>{console.error(error.message);process.exit(error.status??1);});\"",
    "db": "docker run -d -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=handy -v $(pwd)/.pgdata:/var/lib/postgresql/data -p 5432:5432 postgres:17",
    "redis": "docker run -d -p 6379:6379 redis",
    "s3": "docker run -d --name minio -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin -v $(pwd)/.minio/data:/data minio/minio server /data --console-address :9001",
    "s3:down": "docker rm -f minio || true",
    "s3:init": "dotenv -e .env.dev -- sh -c 'docker run --rm --network container:minio --entrypoint /bin/sh -e S3_ACCESS_KEY -e S3_SECRET_KEY -e S3_BUCKET minio/mc -c \"mc alias set local http://localhost:9000 \\$S3_ACCESS_KEY \\$S3_SECRET_KEY && mc mb -p local/\\$S3_BUCKET || true && mc anonymous set download local/\\$S3_BUCKET\"'",
    "validate:redis-adapter": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/validate.redisAdapterFanout.ts",
    "voice:identity-backfill": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/voiceProviderIdentityBackfill.ts run",
    "voice:identity-backfill:verify": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/voiceProviderIdentityBackfill.ts verify",
    "session-system-records:backfill": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/sessionSystemRecordBackfill.ts",
    "session-message-author:backfill": "node ./scripts/runTsx.mjs --tsconfig ./tsconfig.json ./scripts/sessionMessageAuthorProjectionBackfill.ts"
  },
  "devDependencies": {
    "@happier-dev/plugins-machine-crabbox": "0.0.0",
    "@happier-dev/tests": "0.0.0",
    "@types/chalk": "^2.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.1.7",
    "@types/tmp": "^0.2.6",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.27.2",
    "jsqr": "1.4.0",
    "redis-memory-server": "^0.16.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "yaml": "^2.4.2"
  },
  "dependencies": {
    "@date-fns/tz": "^1.2.0",
    "@electric-sql/pglite": "^0.3.15",
    "@electric-sql/pglite-socket": "^0.0.20",
    "@fastify/bearer-auth": "^10.1.1",
    "@fastify/compress": "9.2.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/proxy-addr": "^5.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "9.7.0",
    "@happier-dev/agents": "0.0.0",
    "@happier-dev/brand": "0.0.0",
    "@happier-dev/cli-common": "0.0.0",
    "@happier-dev/deployment-protocol": "0.0.0",
    "@happier-dev/iroh-native": "0.0.0",
    "@happier-dev/peer-mediation": "0.0.0",
    "@happier-dev/transfers": "0.0.0",
    "@happier-dev/peer-transport": "0.0.0",
    "@happier-dev/plugins-kiro": "0.0.0",
    "@happier-dev/plugins-review-coderabbit": "0.0.0",
    "@happier-dev/plugins-review-deepsec": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "@happier-dev/release-runtime": "0.0.0",
    "@happier-dev/session-core": "0.0.0",
    "@prisma/client": "^6.11.1",
    "@prisma/engines-version": "7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "@prisma/fetch-engine": "6.19.2",
    "@sentry/node": "10.76.2",
    "@sentry/profiling-node": "10.76.2",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/semver": "^7.7.0",
    "@workos-inc/node": "10.13.0",
    "axios": "^1.6.8",
    "chalk": "4.1.2",
    "cron-parser": "^5.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "elevenlabs": "^1.54.0",
    "expo-server-sdk": "^3.15.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "nodemailer": "10.0.0",
    "octokit": "^5.0.3",
    "openapi-types": "12.1.3",
    "openid-client": "^6.0.0",
    "pino": "^9.9.0",
    "pino-pretty": "^13.0.0",
    "parse5": "^7.2.1",
    "prisma": "^6.11.1",
    "prisma-json-types-generator": "^3.5.1",
    "privacy-kit": "^0.0.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native-web": "^0.21.0",
    "react-native-svg": "15.15.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.7.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "socket.io-adapter": "^2.5.8",
    "tmp": "^0.2.6",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "undici": "8.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0",
    "zod": "4.6.7",
    "zod-to-json-schema": "^3.24.3"
  }
}
