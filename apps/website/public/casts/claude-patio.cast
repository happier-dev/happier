[17.438, "o", "\u001b[2D\u001b[2B\r\u001b[2C\u001b[9A-\u001b[1C\u001b[38;2;177;185;249mDashboardShell.tsx\u001b[1C\u001b[39m(2.9K)\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mOccupancyBadge\u001b[6C\u001b[39m817B\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mSettingsForm.tsx\u001b[39m (5.6K) \u2014\u001b[1Clargest\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mTableCard.tsx\u001b[39m (1.3K)   \u001b[1C \u001b[1C       \r\u001b[2C\u001b[1B \u001b[1C             \u001b[1C      \r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m\u001b[1mSettingsForm.tsx\u001b[1C\u001b[22m\u001b[39mis\u001b[1Ca\u001b[1Cclient-side\u001b[1Cform\u001b[1Cfor\u001b[1Cthe\u001b[1Csettings\u001b[1Cpage.\u001b[1CIt\u001b[1Cwires\r\u001b[1B  \u001b[38;2;177;185;249msaveSettings\u001b[39m (a server action) into \u001b[38;2;177;185;249museActionState\u001b[39m, and renders three    \r\u001b[1B  sections:\u001b[1Ctotal\u001b[1Ctable\u001b[1Ccount,\u001b[1Cwalk-in\u001b[1Ccutoff\u001b[1Ctime,\u001b[1Cand\u001b[1Cper-section\r\u001b[1B  occupancy goals (Courtyard/Sidewalk/Awning). It defines local \u001b[38;2;177;185;249mSection\u001b[39m,   \r\r\n\u001b[2C\u001b[38;2;177;185;249mNumberField\u001b[39m,\u001b[1Cand\u001b[1C\u001b[38;2;177;185;249mTimeField\u001b[1C\u001b[39mhelpers,\u001b[1Csurfaces\u001b[1Cper-field\u001b[1Cvalidation\u001b[1Cerrors\r\r\n\u001b[2Cfrom\u001b[1Caction\u001b[1Cstate,\u001b[1Cand\u001b[1Cshows\u001b[1Ca\u001b[1C\"Saved.\"\u001b[1C/\u001b[1Cerror\u001b[1Cmessage\u001b[1Cnext"]
