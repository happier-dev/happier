{
    "name": "@happier-dev/website",
    "description": "Marketing site for Happier — the control room for your AI coding agents, on every device.",
    "private": true,
  "version": "0.2.10",
    "type": "module",
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
        "dev": "vite",
        "build": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "typecheck": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit",
        "optimize:images": "node scripts/optimize-feature-images.mjs"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "framer-motion": "^11.11.17",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.21",
        "postcss": "^8.5.3",
        "sharp": "^0.34.5",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vitest": "^3.2.4",
        "vite": "^6.0.7"
    }
}
