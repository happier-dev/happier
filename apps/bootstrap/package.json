{
  "name": "@happier-dev/bootstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "hsetup": "./bin/hsetup.mjs"
  },
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build:shared": "node scripts/buildSharedDeps.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json && node scripts/writeDistBinWrappers.mjs",
    "build:binary": "yarn -s build:shared && yarn -s build && node scripts/buildBinary.mjs",
    "typecheck": "../stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ./scripts/runTsc.mjs --noEmit -p tsconfig.json",
    "test": "../stack/bin/hstack-exec --script=test:local",
    "test:local": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts && node --test scripts/buildBinaryTarget.test.mjs scripts/resolveBootstrapRepoRoot.test.mjs scripts/writeDistBinWrappers.test.mjs"
  },
  "dependencies": {
    "@happier-dev/cli-common": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "@happier-dev/release-runtime": "0.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@happier-dev/tests": "0.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22"
}
