#!/bin/sh

# Canonical native owner for dev-target control placement and causal sync admission.
# A queued request can share only a successful flush started after its demand.
# Requests arriving during a flush require a later cycle. Every admission also
# inspects fresh exact-session health. It stays native because every preferred-execution
# command crosses this boundary, including commands used while the JavaScript
# runtime is busy.

# Parse before execution so a source edit during a sync wait cannot change the
# remaining program. Braces keep control placement and traps in the same shell.
{

case "$0" in
  /*) control_path=$0 ;;
  */*) control_path="$PWD/${0#./}" ;;
  *) control_path=$(command -v -- "$0") || exit 1 ;;
esac
control_dir=${control_path%/*}
[ "$control_dir" != "$control_path" ] || control_dir=.
control_path=$(CDPATH= cd -- "$control_dir" && pwd -P)/${control_path##*/}
. "$control_dir/../scripts/utils/dev_targets/native_sync_readiness.sh" || exit 1

usage() {
  printf '%s\n' 'usage: hstack-dev-target-control [--sync-flush SESSION] [--sync-check SESSION] -- COMMAND [ARG...]' >&2
  exit 64
}

sync_control_state_dir() {
  # Startup, explicit sync and dispatch address the same daemon/session. A
  # caller-selected directory would split their lock and causal flight record.
  printf '%s\n' "${MUTAGEN_DATA_DIRECTORY%/data}/hstack-control"
}

run_control_command() {
  [ "$#" -gt 0 ] || usage

  case "$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)" in
    *'/happier-critical.slice/'*) exec "$@" ;;
  esac

  if [ -n "${DBUS_SESSION_BUS_ADDRESS-}" ] \
    && command -v systemd-run >/dev/null 2>&1 \
    && command -v systemctl >/dev/null 2>&1 \
    && systemctl --user show-environment >/dev/null 2>&1; then
    uid=$(id -u)
    critical_dir="/sys/fs/cgroup/user.slice/user-$uid.slice/user@$uid.service/happier.slice/happier-critical.slice"
    critical_ready=0
    if [ "$(cat "$critical_dir/memory.low" 2>/dev/null)" = 4294967296 ]; then
      critical_ready=1
    elif command -v systemctl >/dev/null 2>&1; then
      if command -v timeout >/dev/null 2>&1; then
        critical_properties=$(timeout 1 systemctl --user show happier-critical.slice \
          --property=LoadState --property=MemoryLow 2>/dev/null || true)
      else
        critical_properties=$(systemctl --user show happier-critical.slice \
          --property=LoadState --property=MemoryLow 2>/dev/null || true)
      fi
      case "$critical_properties" in
        *'LoadState=loaded'*'MemoryLow=4294967296'*|*'MemoryLow=4294967296'*'LoadState=loaded'*)
          critical_ready=1
          ;;
      esac
    fi
    if [ "$critical_ready" = 1 ]; then
      control_nice=$(ps -o ni= -p $$ 2>/dev/null | tr -d ' ')
      case "$control_nice" in
        -[0-9]*) renice -n 0 -p $$ >/dev/null 2>&1 || true ;;
        [1-9]*|+[1-9]*)
          if command -v sudo >/dev/null 2>&1; then
            sudo -n renice -n 0 -p $$ >/dev/null 2>&1 || true
          fi
          ;;
      esac
      control_nice=$(ps -o ni= -p $$ 2>/dev/null | tr -d ' ')
      case "$control_nice" in
        0|+0|-0) control_nice_argument=--nice=0 ;;
        *) control_nice_argument= ;;
      esac
      exec systemd-run --user --scope --quiet \
        ${control_nice_argument:+"$control_nice_argument"} \
        --slice=happier-critical.slice \
        --property=MemoryLow=268435456 \
        --property=CPUWeight=200 \
        --property=IOWeight=200 \
        -- "$@"
    fi
  fi

  exec "$@"
}

check_sync_session_clean() {
  session_name=$1
  allow_needs_flush=${2-0}
  case "$session_name" in ''|*[!A-Za-z0-9._-]*)
    printf '%s\n' "hstack-dev-target-control: invalid sync session name: $session_name" >&2
    return 1
    ;;
  esac
  [ -n "${MUTAGEN_DATA_DIRECTORY-}" ] || {
    printf '%s\n' 'hstack-dev-target-control: MUTAGEN_DATA_DIRECTORY is required for sync inspection' >&2
    return 1
  }
  sync_template='{{range .}}{{.Name}}|{{.Status}}|{{.Paused}}|{{.Alpha.Connected}}|{{if .Alpha.Connected}}{{if .Alpha.Scanned}}1{{else}}0{{end}}{{else}}X{{end}}|{{if .Alpha.Connected}}{{len .Alpha.ScanProblems}}/{{.Alpha.ExcludedScanProblems}}{{else}}X{{end}}|{{if .Alpha.Connected}}{{len .Alpha.TransitionProblems}}/{{.Alpha.ExcludedTransitionProblems}}{{else}}X{{end}}|{{.Beta.Connected}}|{{if .Beta.Connected}}{{if .Beta.Scanned}}1{{else}}0{{end}}{{else}}X{{end}}|{{if .Beta.Connected}}{{len .Beta.ScanProblems}}/{{.Beta.ExcludedScanProblems}}{{else}}X{{end}}|{{if .Beta.Connected}}{{len .Beta.TransitionProblems}}/{{.Beta.ExcludedTransitionProblems}}{{else}}X{{end}}|{{if .Paused}}paused|0|ok|0|0{{else}}active|{{.SuccessfulCycles}}|{{if .LastError}}error{{else}}ok{{end}}|{{len .Conflicts}}|{{.ExcludedConflicts}}{{end}}|{{.Alpha.Watch.Mode}}|{{.Beta.Watch.Mode}}{{end}}'
  if ! status_output=$(mutagen sync list "$session_name" --template "$sync_template" 2>/dev/null); then
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization status inspection failed" >&2
    return 1
  fi
  [ -n "$status_output" ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization is missing: no matching session" >&2
    return 1
  }
  status_line=$(printf '%s\n' "$status_output" | sed -n '1p')
  IFS='|' read -r s_name s_status s_paused s_alpha_connected s_alpha_scanned s_alpha_scan s_alpha_trans s_beta_connected s_beta_scanned s_beta_scan s_beta_trans s_active s_cycles s_error s_conflicts s_excluded s_alpha_watch s_beta_watch <<EOF
$status_line
EOF
  [ "$s_name" = "$session_name" ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization is missing: no matching session" >&2
    return 1
  }
  [ "$s_paused" = false ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization is paused" >&2
    return 1
  }
  [ "$s_active" = active ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization is paused" >&2
    return 1
  }
  case "$s_status" in
    Watching|Scanning|WaitingForRescan|Reconciling|StagingAlpha|StagingBeta|Transitioning|Saving) ;;
    *)
      printf '%s\n' "hstack-dev-target-control: $session_name synchronization status is not clean: $s_status" >&2
      return 1
      ;;
  esac
  [ "$s_alpha_connected" = true ] && [ "$s_beta_connected" = true ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization is missing connected endpoint evidence" >&2
    return 1
  }
  [ "$s_alpha_trans" = "0/0" ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization has alpha transition problems: $s_alpha_trans" >&2
    return 1
  }
  [ "$s_beta_trans" = "0/0" ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization has beta transition problems: $s_beta_trans" >&2
    return 1
  }
  [ "$s_error" = ok ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization has a recorded error" >&2
    return 1
  }
  [ "${s_conflicts-}" = 0 ] && [ "${s_excluded-}" = 0 ] || {
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization has unresolved conflicts: ${s_conflicts-?}/${s_excluded-?}" >&2
    return 1
  }
  # Only well-formed scan-only problems may request a fresh cycle. Conflicts,
  # transition failures, paused sessions and missing evidence stay fail-closed.
  for scan_counts in "$s_alpha_scan" "$s_beta_scan"; do
    case "$scan_counts" in ''|*[!0-9/]*|/*|*/|*/*/*) return 1 ;; esac
    case "$scan_counts" in */*) ;; *) return 1 ;; esac
  done
  sync_fact_watching=0; [ "$s_status" != Watching ] || sync_fact_watching=1
  sync_fact_noWatch=0
  if [ "$s_alpha_watch" = WatchModeNoWatch ] && [ "$s_beta_watch" = WatchModeNoWatch ]; then sync_fact_noWatch=1; fi
  sync_fact_scanned=0
  if [ "$s_alpha_scanned" = 1 ] && [ "$s_beta_scanned" = 1 ]; then sync_fact_scanned=1; fi
  sync_fact_cyclesValid=1
  case "$s_cycles" in ''|*[!0-9]*) sync_fact_cyclesValid=0 ;; esac
  sync_fact_completed=0
  if [ "$sync_fact_cyclesValid" = 1 ] && [ "$s_cycles" -gt 0 ]; then sync_fact_completed=1; fi
  sync_fact_scanProblems=0
  if [ "$s_alpha_scan" != "0/0" ] || [ "$s_beta_scan" != "0/0" ]; then sync_fact_scanProblems=1; fi
  classify_clean_mutagen_readiness
  if [ "$sync_readiness" = rescan ]; then
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization has scan problems (alpha=$s_alpha_scan beta=$s_beta_scan)" >&2
    return 2
  fi
  if [ "$sync_readiness" != ready ] && { [ "$sync_readiness" != needs-flush ] || [ "$allow_needs_flush" != 1 ]; }; then
    printf '%s\n' "hstack-dev-target-control: $session_name synchronization is $sync_readiness (scanned=$sync_fact_scanned cycles=$s_cycles)" >&2
    return 1
  fi
  if [ "${HSTACK_SYNC_CHECK_VERBOSE-}" = 1 ]; then
    printf '%s\n' "$status_line"
  fi
  return 0
}

read_sync_flight() {
  flight_started=0
  flight_success=0
  [ -e "$flight_path" ] || return 0
  IFS=' ' read -r flight_started flight_success flight_extra < "$flight_path" || return 1
  case "$flight_started" in ''|*[!0-9]*) return 1 ;; esac
  case "$flight_success" in ''|*[!0-9]*) return 1 ;; esac
  [ -z "$flight_extra" ] && [ "$flight_success" -le "$flight_started" ]
}

write_sync_flight() {
  flight_temp="$flight_path.$$"
  if printf '%s %s\n' "$flight_started" "$flight_success" > "$flight_temp" \
    && mv -f -- "$flight_temp" "$flight_path"; then
    return 0
  fi
  rm -f -- "$flight_temp"
  return 1
}

locked_sync_flush() {
  session_name=$1
  observed_started=$2
  shift 2
  [ "${1-}" = -- ] || usage
  shift
  flight_path="$(sync_control_state_dir)/$session_name.flight"
  read_sync_flight || exit 1
  if [ "$flight_success" -eq "$flight_started" ] && [ "$flight_success" -gt "$observed_started" ]; then
    check_sync_session_clean "$session_name"
    exit "$?"
  fi
  # Publish start before dispatch so demand during this flight cannot join it.
  flight_started=$((flight_started + 1))
  write_sync_flight || exit 1
  control_child=''
  cancel_locked_flush() {
    trap - HUP INT TERM
    if [ -n "$control_child" ]; then
      kill -TERM "$control_child" 2>/dev/null || true
      wait "$control_child" 2>/dev/null || true
    fi
    exit 130
  }
  trap 'cancel_locked_flush' HUP INT TERM
  "$control_path" -- "$@" &
  control_child=$!
  wait "$control_child"
  status=$?
  control_child=''
  trap - HUP INT TERM
  [ "$status" -eq 0 ] || exit "$status"
  check_sync_session_clean "$session_name"
  check_status=$?
  [ "$check_status" -eq 0 ] || exit "$check_status"
  flight_success=$flight_started
  write_sync_flight || exit 1
  exit "$check_status"
}

case "${1-}" in
  --locked-sync-flush)
    [ "$#" -ge 5 ] || usage
    session_name=$2
    observed_started=$3
    shift 3
    locked_sync_flush "$session_name" "$observed_started" "$@"
    ;;
  --sync-check)
    [ "$#" -eq 2 ] || usage
    session_name=$2
    case "$session_name" in ''|*[!A-Za-z0-9._-]*) usage ;; esac
    check_sync_session_clean "$session_name" 1
    status=$?
    if [ "$status" -eq 2 ]; then
      printf '%s\n' "hstack-dev-target-control: $session_name requesting a fresh scan through the dispatch flush barrier" >&2
      "$control_path" --sync-flush "$session_name" -- mutagen sync flush "$session_name" || exit 1
      check_sync_session_clean "$session_name"
      status=$?
    fi
    [ "$status" -eq 0 ] || exit 1
    exit 0
    ;;
  --sync-flush)
    [ "$#" -ge 4 ] || usage
    session_name=$2
    case "$session_name" in ''|*[!A-Za-z0-9._-]*) usage ;; esac
    shift 2
    [ "${1-}" = -- ] || usage
    [ -n "${MUTAGEN_DATA_DIRECTORY-}" ] || {
      printf '%s\n' 'hstack-dev-target-control: MUTAGEN_DATA_DIRECTORY is required for sync flush' >&2
      exit 64
    }
    lock_dir=$(sync_control_state_dir)
    mkdir -p -- "$lock_dir" || exit 1
    if command -v flock >/dev/null 2>&1; then
      flight_path="$lock_dir/$session_name.flight"
      read_sync_flight || exit 1
      observed_started=$flight_started
      lock_child=''
      cancel_lock_wait() {
        trap - HUP INT TERM
        if [ -n "$lock_child" ]; then
          kill -TERM "$lock_child" 2>/dev/null || true
          wait "$lock_child" 2>/dev/null || true
        fi
        exit 130
      }
      trap 'cancel_lock_wait' HUP INT TERM
      flock --exclusive --no-fork "$lock_dir/$session_name.lock" \
        "$control_path" --locked-sync-flush "$session_name" "$observed_started" "$@" &
      lock_child=$!
      wait "$lock_child"
      status=$?
      lock_child=''
      trap - HUP INT TERM
      exit "$status"
    fi
    shift
    direct_child=''
    cancel_direct_flush() {
      trap - HUP INT TERM
      if [ -n "$direct_child" ]; then
        kill -TERM "$direct_child" 2>/dev/null || true
        wait "$direct_child" 2>/dev/null || true
      fi
      exit 130
    }
    trap 'cancel_direct_flush' HUP INT TERM
    "$control_path" -- "$@" &
    direct_child=$!
    wait "$direct_child"
    status=$?
    direct_child=''
    trap - HUP INT TERM
    [ "$status" -eq 0 ] || exit "$status"
    check_sync_session_clean "$session_name"
    exit "$?"
    ;;
  --)
    shift
    run_control_command "$@"
    ;;
  *) usage ;;
esac
}
