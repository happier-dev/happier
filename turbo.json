{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "concurrency": "75%",
  "globalPassThroughEnv": [
    "HAPPIER_DEV_TARGET_EXECUTION",
    "HAPPIER_HSTACK_EXECUTION",
    "HAPPIER_HEAVYWEIGHT_ADMISSION_TOKEN",
    "HAPPIER_HEAVYWEIGHT_ADMISSION_ROOT",
    "HAPPIER_HEAVYWEIGHT_ADMISSION_MACHINE",
    "HAPPIER_HEAVYWEIGHT_ADMISSION_SLOT",
    "HAPPIER_HEAVYWEIGHT_ADMISSION_FLOOR_KIB",
    "HAPPIER_WORKSPACE_DIST_BUILD_LOCK_HELD",
    "HAPPIER_WORKSPACE_DIST_BUILD_LOCK_LEASES",
    "HAPPIER_WORKSPACE_DIST_BUILD_LOCK_WAIT_ALLOWED",
    "HAPPIER_BUILD_DEPENDENCY_CUSTODY"
  ],
  "tasks": {
    "prepare:finite": {
      "dependsOn": ["^build:finite"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/workspaces/**"
      ],
      "outputs": [],
      "cache": false
    },
    "generated:finite": {
      "dependsOn": ["^build:finite"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/workspaces/**",
        "$TURBO_ROOT$/packages/protocol/src/**",
        "$TURBO_ROOT$/apps/stack/scripts/utils/proc/**"
      ],
      "outputs": []
    },
    "build:finite": {
      "dependsOn": ["prepare:finite", "^build:finite"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/workspaces/**"
      ],
      "outputs": [],
      "cache": false
    },
    "api:finite": {
      "dependsOn": ["build:finite"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/api-governance/**"
      ],
      "outputs": []
    },
    "test:finite": {
      "dependsOn": ["api:finite"],
      "outputs": []
    },
    "typecheck:finite": {
      "dependsOn": ["api:finite"],
      "env": ["HAPPIER_TYPECHECK_DISPATCHED", "HAPPIER_TYPESCRIPT_COMPILER"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/workspaces/**"
      ],
      "outputs": []
    },
    "typecheck:source:finite": {
      "dependsOn": [],
      "env": ["HAPPIER_TYPECHECK_DISPATCHED", "HAPPIER_TYPESCRIPT_COMPILER"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/workspaces/**",
        "$TURBO_ROOT$/packages/{privacy-kit,protocol,peer-mediation,transfers,voice-modelpacks,agents,cli-common,release-runtime,channels-protocol,support,connection-supervisor,session-core,triage-protocol,triage-sources,plugin-sdk}/dist/**/*.d.ts",
        "$TURBO_ROOT$/packages/{privacy-kit,cli-common}/*.{d.ts,d.mts,d.cts}",
        "$TURBO_ROOT$/packages/{audio-stream-native,sherpa-native,ssh-native,terminal-native}/src/**/*.ts"
      ],
      "outputs": []
    },
    "project:finite": {
      "dependsOn": ["build:finite", "^build:finite"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/cli/scripts/build-owned/**"
      ],
      "outputs": []
    },
    "plugins:aggregate:finite": {
      "dependsOn": ["^project:finite"],
      "outputs": [],
      "cache": false
    }
  }
}
