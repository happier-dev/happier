{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|MultiEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/prevent-destructive-git.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/.codex/hooks/prevent-destructive-git.mjs'); exit $LASTEXITCODE\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/formatEditedFiles.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/formatEditedFiles.mjs')\""
          }
        ]
      }
    ]
  }
}
